+        f" err(sep)= {(y_sep.cpu().double() - ref.double()).abs().max().item():.5f}"
+        f" |addmm-sep|= {(y_addmm - y_sep).abs().max().item():.5f}"
+    )
+
+# bias-only check: zero matrix product, bias must appear
