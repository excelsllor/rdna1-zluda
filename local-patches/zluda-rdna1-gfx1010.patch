new file mode 100644
index 0000000000000000000000000000000000000000..bfe293b2fb732c81eb04779c91cff2f31ea1a59c
--- /dev/null
+++ b/bench/fp16_ux.py
@@ -0,0 +1,61 @@
+import argparse
+import sys
+import warnings
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from common import bench, save_report
+from zluda_ops.fp16acc import fp16_accumulation, enabled
+
+DEV = "cuda"
+
+
+def measure(n, iters=8):
+    a = torch.randn(n, n, device=DEV, dtype=torch.float16)
+    b = torch.randn(n, n, device=DEV, dtype=torch.float16)
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        with fp16_accumulation(False, warn=False):
+            ref = a @ b
+            ms_fp32 = bench(lambda: a @ b, warmup=2, iters=iters)
+        with fp16_accumulation(True, warn=False):
+            out = a @ b
+            ms_fp16 = bench(lambda: a @ b, warmup=2, iters=iters)
+    diff = (out.float() - ref.float()).abs()
+    return {
+        "n": n,
+        "fp32_ms": ms_fp32,
+        "fp32_tflops": 2 * n**3 / (ms_fp32 / 1000) / 1e12,
+        "fp16_ms": ms_fp16,
+        "fp16_tflops": 2 * n**3 / (ms_fp16 / 1000) / 1e12,
+        "max_abs_vs_fp32acc": diff.max().item(),
+        "mean_abs_vs_fp32acc": diff.mean().item(),
+        "relative_max": (diff.max() / ref.float().abs().max().clamp_min(1e-6)).item(),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--quick", action="store_true")
+    args = parser.parse_args()
+    torch.manual_seed(0)
+    print("default fp16 accumulation:", enabled())
+    print("NOTE: fp16 accumulation is inference-only and numerically unsafe; validate your model.")
+    rows = []
+    for n in ([1024, 2048] if args.quick else [1024, 2048, 4096]):
+        r = measure(n)
+        rows.append(r)
+        print(
+            f"n={n:5d}: fp32acc {r['fp32_ms']:8.2f} ms / {r['fp32_tflops']:5.2f} TF | "
+            f"fp16acc {r['fp16_ms']:8.2f} ms / {r['fp16_tflops']:5.2f} TF | "
+            f"max diff {r['max_abs_vs_fp32acc']:.4f} rel {r['relative_max']:.4f}"
+        )
+    print("final fp16 accumulation:", enabled())
+    save_report("fp16_ux", {"rows": rows})
+
+
+if __name__ == "__main__":
+    main()
diff --git a/bench/fused.py b/bench/fused.py
new file mode 100644
index 0000000000000000000000000000000000000000..e4eb96755619405f54c944bbfc192a9cc57b23de
--- /dev/null
+++ b/bench/fused.py
@@ -0,0 +1,342 @@
+"""Benchmark fused Triton kernels (RMSNorm/RoPE/SwiGLU/softmax/chunked CE).
+
+Compares the Triton implementations in zluda_ops.fused with torch eager
+(potentially TorchInductor-fused) code: forward and forward+backward time,
+numerical error, and the peak-memory saving of chunked cross-entropy.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\fused.py --quick
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\fused.py
+"""
+
+import argparse
+import sys
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from zluda_ops import fused
+from bench.common import bench_median, save_report
+
+
+def _setup(requires_grad=False):
+    torch.manual_seed(0)
+
+
+def rms_norm_case(rows, n, device="cuda"):
+    _setup()
+    x = torch.randn(rows, n, device=device, dtype=torch.float16, requires_grad=True)
+    w = torch.randn(n, device=device, dtype=torch.float16, requires_grad=True)
+    do = torch.randn_like(x)
+    eps = 1e-6
+
+    def torch_ref():
+        xf = x.float()
+        return (xf * torch.rsqrt(xf.pow(2).mean(-1, keepdim=True) + eps) * w.float()).to(torch.float16)
+
+    out = fused.rms_norm(x, w, eps)
+    ref = torch_ref()
+    ferr = (out.float() - ref.float()).abs().max().item()
+    out.backward(do, retain_graph=True)
+    gx, gw = x.grad.clone(), w.grad.clone()
+    x.grad = w.grad = None
+    ref.backward(do)
+    gerr = max((gx - x.grad).abs().max().item(), (gw - w.grad).abs().max().item())
+    x.grad = w.grad = None
+
+    def run_fused():
+        y = fused.rms_norm(x, w, eps)
+
+    def run_ref():
+        y = torch_ref()
+
+    def fb_fused():
+        y = fused.rms_norm(x, w, eps)
+        y.backward(do)
+        x.grad = None
+        w.grad = None
+
+    def fb_ref():
+        y = torch_ref()
+        y.backward(do)
+        x.grad = None
+        w.grad = None
+
+    fm = bench_median(run_fused, rounds=3, iters=5)
+    rm = bench_median(run_ref, rounds=3, iters=5)
+    fbm = bench_median(fb_fused, rounds=3, iters=3)
+    rbm = bench_median(fb_ref, rounds=3, iters=3)
+    print(f"rms_norm {rows}x{n}: fwd {fm:.3f} vs {rm:.3f} ms ({rm/fm:.2f}x) | "
+          f"fwd+bwd {fbm:.3f} vs {rbm:.3f} ms ({rbm/fbm:.2f}x) | err {ferr:.4f}/{gerr:.4f}",
+          flush=True)
+    return {"rows": rows, "n": n, "fwd_ms": fm, "ref_fwd_ms": rm,
+            "fwd_bwd_ms": fbm, "ref_fwd_bwd_ms": rbm,
+            "speedup_fwd": rm / fm, "speedup_fwd_bwd": rbm / fbm,
+            "fwd_err": ferr, "grad_err": gerr}
+
+
+def softmax_case(rows, n, device="cuda"):
+    _setup()
+    x = torch.randn(rows, n, device=device, dtype=torch.float16)
+    out = fused.softmax(x)
+    ref = F.softmax(x.float(), dim=-1)
+    err = (out.float() - ref).abs().max().item()
+    fm = bench_median(lambda: fused.softmax(x), rounds=3, iters=5)
+    rm = bench_median(lambda: F.softmax(x, dim=-1), rounds=3, iters=5)
+    print(f"softmax {rows}x{n}: {fm:.3f} vs {rm:.3f} ms ({rm/fm:.2f}x) err {err:.5f}",
+          flush=True)
+    return {"rows": rows, "n": n, "ms": fm, "ref_ms": rm, "speedup": rm / fm, "err": err}
+
+
+def rope_case(b, h, s, d, device="cuda"):
+    _setup()
+    x = torch.randn(b, h, s, d, device=device, dtype=torch.float16, requires_grad=True)
+    do = torch.randn_like(x)
+    half = d // 2
+    ang = torch.randn(s, half, device=device, dtype=torch.float32) * 3.0
+    cos = torch.cos(ang).to(torch.float16)
+    sin = torch.sin(ang).to(torch.float16)
+
+    def torch_ref(t):
+        x1 = t[..., :half].float()
+        x2 = t[..., half:].float()
+        c = cos.float()[None, None]
+        s_ = sin.float()[None, None]
+        return torch.cat([x1 * c - x2 * s_, x2 * c + x1 * s_], dim=-1).to(torch.float16)
+
+    out = fused.rope_apply(x, cos, sin, seq=s)
+    ref = torch_ref(x)
+    ferr = (out.float() - ref.float()).abs().max().item()
+    out.backward(do, retain_graph=True)
+    gx = x.grad.clone()
+    x.grad = None
+    ref.backward(do)
+    gerr = (gx - x.grad).abs().max().item()
+    x.grad = None
+    fm = bench_median(lambda: fused.rope_apply(x, cos, sin, seq=s), rounds=3, iters=5)
+    rm = bench_median(lambda: torch_ref(x), rounds=3, iters=5)
+
+    def fb_fused():
+        y = fused.rope_apply(x, cos, sin, seq=s)
+        y.backward(do)
+        x.grad = None
+
+    def fb_ref():
+        y = torch_ref(x)
+        y.backward(do)
+        x.grad = None
+
+    fbm = bench_median(fb_fused, rounds=3, iters=3)
+    rbm = bench_median(fb_ref, rounds=3, iters=3)
+    print(f"rope {b}x{h}x{s}x{d}: fwd {fm:.3f} vs {rm:.3f} ms ({rm/fm:.2f}x) | "
+          f"fwd+bwd {fbm:.3f} vs {rbm:.3f} ms ({rbm/fbm:.2f}x) | err {ferr:.5f}/{gerr:.5f}",
+          flush=True)
+    return {"shape": [b, h, s, d], "fwd_ms": fm, "ref_fwd_ms": rm,
+            "fwd_bwd_ms": fbm, "ref_fwd_bwd_ms": rbm,
+            "speedup_fwd": rm / fm, "speedup_fwd_bwd": rbm / fbm,
+            "fwd_err": ferr, "grad_err": gerr}
+
+
+def swiglu_case(rows, n, device="cuda"):
+    _setup()
+    g = torch.randn(rows, n, device=device, dtype=torch.float16, requires_grad=True)
+    u = torch.randn(rows, n, device=device, dtype=torch.float16, requires_grad=True)
+    do = torch.randn_like(g)
+    out = fused.swiglu(g, u)
+    ref = F.silu(g) * u
+    ferr = (out.float() - ref.float()).abs().max().item()
+    out.backward(do, retain_graph=True)
+    g1, u1 = g.grad.clone(), u.grad.clone()
+    g.grad = u.grad = None
+    ref.backward(do)
+    gerr = max((g1 - g.grad).abs().max().item(), (u1 - u.grad).abs().max().item())
+    g.grad = u.grad = None
+    fm = bench_median(lambda: fused.swiglu(g, u), rounds=3, iters=5)
+    rm = bench_median(lambda: F.silu(g) * u, rounds=3, iters=5)
+
+    def fb_fused():
+        y = fused.swiglu(g, u)
+        y.backward(do)
+        g.grad = None
+        u.grad = None
+
+    def fb_ref():
+        y = F.silu(g) * u
+        y.backward(do)
+        g.grad = None
+        u.grad = None
+
+    fbm = bench_median(fb_fused, rounds=3, iters=3)
+    rbm = bench_median(fb_ref, rounds=3, iters=3)
+    print(f"swiglu {rows}x{n}: fwd {fm:.3f} vs {rm:.3f} ms ({rm/fm:.2f}x) | "
+          f"fwd+bwd {fbm:.3f} vs {rbm:.3f} ms ({rbm/fbm:.2f}x) | err {ferr:.5f}/{gerr:.5f}",
+          flush=True)
+    return {"rows": rows, "n": n, "fwd_ms": fm, "ref_fwd_ms": rm,
+            "fwd_bwd_ms": fbm, "ref_fwd_bwd_ms": rbm,
+            "speedup_fwd": rm / fm, "speedup_fwd_bwd": rbm / fbm,
+            "fwd_err": ferr, "grad_err": gerr}
+
+
+def ce_case(rows, vocab, chunk, device="cuda"):
+    _setup()
+    logits = torch.randn(rows, vocab, device=device, dtype=torch.float16, requires_grad=True)
+    targets = torch.randint(0, vocab, (rows,), device=device)
+    out = fused.chunked_cross_entropy(logits, targets, chunk_size=chunk)
+    ref = F.cross_entropy(logits.float(), targets)
+    err = (out.detach() - ref.detach()).abs().item()
+    out.backward()
+    g_fused = logits.grad.clone()
+    logits.grad = None
+    ref.backward()
+    gerr = (g_fused - logits.grad).abs().max().item()
+    logits.grad = None
+    torch.cuda.reset_peak_memory_stats()
+    out = fused.chunked_cross_entropy(logits, targets, chunk_size=chunk)
+    out.backward()
+    fused_peak = torch.cuda.max_memory_allocated() / 1024**2
+    logits.grad = None
+    torch.cuda.reset_peak_memory_stats()
+    ref = F.cross_entropy(logits.float(), targets)
+    ref.backward()
+    ref_peak = torch.cuda.max_memory_allocated() / 1024**2
+    logits.grad = None
+    fwd_ms = bench_median(lambda: fused.chunked_cross_entropy(logits, targets, chunk_size=chunk),
+                          rounds=2, iters=3)
+    ref_ms = bench_median(lambda: F.cross_entropy(logits.float(), targets), rounds=2, iters=3)
+    print(f"chunked CE {rows}x{vocab} chunk={chunk}: {fwd_ms:.2f} vs {ref_ms:.2f} ms | "
+          f"peak mem fused {fused_peak:.0f} MB vs torch {ref_peak:.0f} MB | "
+          f"err {err:.5f}/{gerr:.6f}", flush=True)
+    return {"rows": rows, "vocab": vocab, "chunk": chunk, "ms": fwd_ms,
+            "ref_ms": ref_ms, "peak_mb": fused_peak, "ref_peak_mb": ref_peak,
+            "err": err, "grad_err": gerr}
+
+
+
+def layer_norm_case(rows, n, device="cuda"):
+    _setup()
+    x = torch.randn(rows, n, device=device, dtype=torch.float16, requires_grad=True)
+    w = torch.randn(n, device=device, dtype=torch.float16, requires_grad=True)
+    b = torch.randn(n, device=device, dtype=torch.float16, requires_grad=True)
+    do = torch.randn_like(x)
+    eps = 1e-5
+    out = fused.layer_norm(x, w, b, eps)
+    ref = F.layer_norm(x, (n,), w, b, eps)
+    ferr = (out.float() - ref.float()).abs().max().item()
+    out.backward(do, retain_graph=True)
+    g1 = [t.grad.clone() for t in (x, w, b)]
+    for t in (x, w, b):
+        t.grad = None
+    ref.backward(do)
+    gerr = max((a - t.grad).abs().max().item() for a, t in zip(g1, (x, w, b)))
+    for t in (x, w, b):
+        t.grad = None
+    fm = bench_median(lambda: fused.layer_norm(x, w, b, eps), rounds=3, iters=5)
+    rm = bench_median(lambda: F.layer_norm(x, (n,), w, b, eps), rounds=3, iters=5)
+    def fb_fused():
+        y = fused.layer_norm(x, w, b, eps)
+        y.backward(do)
+        x.grad = w.grad = b.grad = None
+    def fb_ref():
+        y = F.layer_norm(x, (n,), w, b, eps)
+        y.backward(do)
+        x.grad = w.grad = b.grad = None
+    fbm = bench_median(fb_fused, rounds=3, iters=3)
+    rbm = bench_median(fb_ref, rounds=3, iters=3)
+    print(f"layer_norm {rows}x{n}: fwd {fm:.3f} vs {rm:.3f} ms ({rm/fm:.2f}x) | "
+          f"fwd+bwd {fbm:.3f} vs {rbm:.3f} ms ({rbm/fbm:.2f}x) | err {ferr:.5f}/{gerr:.4f}", flush=True)
+    return {"rows": rows, "n": n, "fwd_ms": fm, "ref_fwd_ms": rm, "fwd_bwd_ms": fbm,
+            "ref_fwd_bwd_ms": rbm, "speedup_fwd": rm / fm, "speedup_fwd_bwd": rbm / fbm,
+            "fwd_err": ferr, "grad_err": gerr}
+
+
+def geglu_case(rows, n, device="cuda"):
+    _setup()
+    g = torch.randn(rows, n, device=device, dtype=torch.float16, requires_grad=True)
+    u = torch.randn(rows, n, device=device, dtype=torch.float16, requires_grad=True)
+    do = torch.randn_like(g)
+    out = fused.geglu(g, u)
+    ref = F.gelu(g) * u
+    ferr = (out.float() - ref.float()).abs().max().item()
+    out.backward(do, retain_graph=True)
+    g1, u1 = g.grad.clone(), u.grad.clone()
+    g.grad = u.grad = None
+    ref.backward(do)
+    gerr = max((g1 - g.grad).abs().max().item(), (u1 - u.grad).abs().max().item())
+    g.grad = u.grad = None
+    fm = bench_median(lambda: fused.geglu(g, u), rounds=3, iters=5)
+    rm = bench_median(lambda: F.gelu(g) * u, rounds=3, iters=5)
+    def fb_fused():
+        y = fused.geglu(g, u)
+        y.backward(do)
+        g.grad = u.grad = None
+    def fb_ref():
+        y = F.gelu(g) * u
+        y.backward(do)
+        g.grad = u.grad = None
+    fbm = bench_median(fb_fused, rounds=3, iters=3)
+    rbm = bench_median(fb_ref, rounds=3, iters=3)
+    print(f"geglu {rows}x{n}: fwd {fm:.3f} vs {rm:.3f} ms ({rm/fm:.2f}x) | "
+          f"fwd+bwd {fbm:.3f} vs {rbm:.3f} ms ({rbm/fbm:.2f}x) | err {ferr:.5f}/{gerr:.5f}", flush=True)
+    return {"rows": rows, "n": n, "fwd_ms": fm, "ref_fwd_ms": rm, "fwd_bwd_ms": fbm,
+            "ref_fwd_bwd_ms": rbm, "speedup_fwd": rm / fm, "speedup_fwd_bwd": rbm / fbm,
+            "fwd_err": ferr, "grad_err": gerr}
+
+
+def adamw_case(num, device="cuda"):
+    torch.manual_seed(0)
+    p = torch.randn(num, device=device) * 0.1
+    grad = torch.randn(num, device=device) * 0.01
+    m = torch.zeros(num, device=device)
+    v = torch.zeros(num, device=device)
+    p_ref = p.clone()
+    m_ref = torch.zeros_like(m)
+    v_ref = torch.zeros_like(v)
+    lr, b1, b2, eps, wd = 1e-3, 0.9, 0.999, 1e-8, 0.01
+    fused.adamw_step_(p, grad, m, v, lr=lr, beta1=b1, beta2=b2, eps=eps,
+                      weight_decay=wd, step=1)
+    def torch_step():
+        p_ref.mul_(1 - lr * wd)
+        m_ref.mul_(b1).add_(grad, alpha=1 - b1)
+        v_ref.mul_(b2).addcmul_(grad, grad, value=1 - b2)
+        p_ref.addcdiv_(m_ref / (1 - b1), (v_ref / (1 - b2)).sqrt().add_(eps), value=-lr)
+    torch_step()
+    diff = (p - p_ref).abs().max().item()
+    fm = bench_median(lambda: fused.adamw_step_(p, grad, m, v, lr=lr, beta1=b1,
+                                                beta2=b2, eps=eps, weight_decay=wd,
+                                                step=1), rounds=3, iters=10)
+    tm = bench_median(torch_step, rounds=3, iters=10)
+    print(f"adamw {num} elems: fused {fm:.3f} vs torch {tm:.3f} ms ({tm/fm:.2f}x) "
+          f"| max param diff {diff:.2e}", flush=True)
+    return {"num": num, "fused_ms": fm, "torch_ms": tm, "speedup": tm / fm,
+            "param_diff": diff}
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--quick", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+    if not torch.cuda.is_available():
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+    rows, n = (2048, 2048) if args.quick else (8192, 4096)
+    cases = {
+        "rms_norm": rms_norm_case(rows, n),
+        "softmax": softmax_case(rows, n),
+        "rope": rope_case(1, 8, 1024, 128) if args.quick else rope_case(1, 32, 2048, 128),
+        "swiglu": swiglu_case(rows, n // 2),
+        "chunked_ce": ce_case(1024, 8192, 256) if args.quick else ce_case(4096, 16384, 512),
+        "layer_norm": layer_norm_case(rows, n),
+        "geglu": geglu_case(rows, n // 2),
+        "adamw": adamw_case(rows * n // 8),
+    }
+    save_report("fused", {"cases": cases, "quick": args.quick})
+    print("done", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/gemv.py b/bench/gemv.py
new file mode 100644
index 0000000000000000000000000000000000000000..9c5f5609f080fd02d1e5069efa2fbf4b3ac5d2c1
--- /dev/null
+++ b/bench/gemv.py
@@ -0,0 +1,93 @@
+import argparse
+
+import torch
+import triton
+import triton.language as tl
+
+from common import bench, save_report
+
+DEV = "cuda"
+PEAK_BW_GBS = 448.0
+
+
+@triton.jit
+def _gemv_mvec(w_ptr, x_ptr, b_ptr, y_ptr, N, K: tl.constexpr, M: tl.constexpr,
+               BK: tl.constexpr, PROD_F16: tl.constexpr):
+    row = tl.program_id(0)
+    mcols = tl.arange(0, M)
+    acc = tl.zeros((M,), tl.float32)
+    for k0 in range(0, K, BK):
+        offs = k0 + tl.arange(0, BK)
+        w = tl.load(w_ptr + row * K + offs)
+        x = tl.load(x_ptr + mcols[:, None] * K + offs[None, :])
+        if PROD_F16:
+            acc += tl.sum(w[None, :] * x, axis=1).to(tl.float32)
+        else:
+            acc += tl.sum(w[None, :].to(tl.float32) * x.to(tl.float32), axis=1)
+    acc += tl.load(b_ptr + row).to(tl.float32)
+    tl.store(y_ptr + mcols * N + row, acc.to(y_ptr.dtype.element_ty))
+
+
+CONFIGS = {
+    1: (4096, 4, True),
+    2: (4096, 4, True),
+    4: (2048, 8, True),
+    8: (4096, 8, True),
+    16: (4096, 4, False),
+    32: (4096, 4, False),
+}
+
+
+def run_gemv(w, x, bias):
+    n, k = w.shape
+    m = x.shape[0]
+    y = torch.empty(m, n, device=w.device, dtype=w.dtype)
+    bk, warps, prod_f16 = CONFIGS.get(m, (4096, 4, False))
+    _gemv_mvec[(n,)](w, x, bias, y, n, K=k, M=m, BK=bk, PROD_F16=prod_f16,
+                     num_warps=warps, num_stages=1)
+    return y
+
+
+def correctness(w, x, bias):
+    y = run_gemv(w, x, bias)
+    ref = x.float() @ w.float().t() + bias.float()
+    return (y.float() - ref).abs().max().item()
+
+
+def perf(n=4096, k=4096, dtypes=(torch.float16, torch.float32), ms=(1, 4, 8, 16, 32)):
+    report = []
+    for dtype in dtypes:
+        w = torch.randn(n, k, device=DEV, dtype=dtype) * 0.02
+        bias = torch.randn(n, device=DEV, dtype=dtype) * 0.02
+        for m in ms:
+            x = torch.randn(m, k, device=DEV, dtype=dtype) * 0.1
+            err = correctness(w, x, bias)
+            ms_time = min(bench(lambda: run_gemv(w, x, bias), warmup=5, iters=20) for _ in range(2))
+            traffic = n * k * w.element_size() + m * k * x.element_size() + m * n * 2 + n * bias.element_size()
+            gbs = traffic / (ms_time / 1000.0) / 1e9
+            ref_ms = min(bench(lambda: torch.nn.functional.linear(x, w, bias), warmup=3, iters=10) for _ in range(2))
+            ref_gbs = traffic / (ref_ms / 1000.0) / 1e9
+            report.append({
+                "dtype": str(dtype).split(".")[-1], "m": m, "n": n, "k": k,
+                "ms": ms_time, "gbs": gbs, "pct_peak": gbs / PEAK_BW_GBS * 100.0,
+                "torch_ms": ref_ms, "torch_gbs": ref_gbs, "max_abs": err,
+            })
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--n", type=int, default=4096)
+    parser.add_argument("--k", type=int, default=4096)
+    args = parser.parse_args()
+    torch.manual_seed(0)
+    rows = perf(args.n, args.k)
+    print(f"GEMV/skinny, N={args.n} K={args.k}")
+    for r in rows:
+        print(f"{r['dtype']:9s} m={r['m']:2d}: {r['ms']:8.3f} ms {r['gbs']:7.1f} GB/s ({r['pct_peak']:5.1f}%) "
+              f"err={r['max_abs']:.4f} | torch {r['torch_ms']:8.3f} ms {r['torch_gbs']:7.1f} GB/s")
+    save_report("gemv", {"n": args.n, "k": args.k, "rows": rows})
+
+
+if __name__ == "__main__":
+    main()
diff --git a/bench/gemv_m32.py b/bench/gemv_m32.py
new file mode 100644
index 0000000000000000000000000000000000000000..5f8a3969ea89d2254bf4380028c46b51585f35bf
--- /dev/null
+++ b/bench/gemv_m32.py
@@ -0,0 +1,171 @@
+"""Split-K / tl.dot GEMV kernel for M=16..32.
+
+The existing row-per-program kernel (bench/gemv.py, `_gemv_mvec`) is
+compute-bound at M=16/32: 155/78 GB/s instead of the 70-80% bandwidth target.
+This script benchmarks a tl.dot based kernel with K-splitting so the fully
+unrolled fp16 dot products run as small GEMMs and the K dimension is spread
+over the CUs.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\gemv_m32.py --n 2048 --k 2048
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\gemv_m32.py --n 4096 --k 4096 --sweep
+"""
+
+import argparse
+import sys
+from pathlib import Path
+
+import torch
+import triton
+import triton.language as tl
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from common import bench_median, save_report
+
+PEAK_BW_GBS = 448.0
+
+
+@triton.jit
+def _gemv_splitk(w_ptr, x_ptr, b_ptr, y_ptr, N, M,
+                 K: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr,
+                 BK: tl.constexpr, SPLIT_K: tl.constexpr):
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    offs_m = tl.arange(0, BM)
+    offs_n = pid_n * BN + tl.arange(0, BN)
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    k_per = K // SPLIT_K
+    k_start = pid_k * k_per
+    for k0 in range(k_start, k_start + k_per, BK):
+        offs_k = k0 + tl.arange(0, BK)
+        x = tl.load(x_ptr + offs_m[:, None] * K + offs_k[None, :],
+                    mask=offs_m[:, None] < M, other=0.0)
+        w = tl.load(w_ptr + offs_n[:, None] * K + offs_k[None, :],
+                    mask=offs_n[:, None] < N, other=0.0)
+        acc = tl.dot(x, tl.trans(w), acc)
+    if pid_k == 0:
+        acc += tl.load(b_ptr + offs_n, mask=offs_n < N, other=0.0)[None, :].to(tl.float32)
+    out = y_ptr + offs_m[:, None] * N + offs_n[None, :]
+    mask = (offs_m[:, None] < M) & (offs_n[None, :] < N)
+    if SPLIT_K == 1:
+        tl.store(out, acc.to(y_ptr.dtype.element_ty), mask=mask)
+    else:
+        tl.atomic_add(out, acc, mask=mask)
+
+
+def run_splitk(w, x, bias, bn=128, bk=64, split_k=4, num_warps=4):
+    n, k = w.shape
+    m = x.shape[0]
+    bm = 16 if m <= 16 else 32
+    grid = (triton.cdiv(n, bn), split_k)
+    if split_k == 1:
+        y = torch.empty(m, n, device=w.device, dtype=w.dtype)
+        _gemv_splitk[grid](w, x, bias, y, n, m, K=k, BM=bm, BN=bn, BK=bk,
+                           SPLIT_K=1, num_warps=num_warps, num_stages=1)
+        return y
+    y32 = torch.zeros(m, n, device=w.device, dtype=torch.float32)
+    _gemv_splitk[grid](w, x, bias, y32, n, m, K=k, BM=bm, BN=bn, BK=bk,
+                       SPLIT_K=split_k, num_warps=num_warps, num_stages=1)
+    return y32.to(w.dtype)
+
+
+def traffic_bytes(n, k, m, elem_size, out_size=2):
+    return (n * k * elem_size + m * k * elem_size + m * n * out_size
+            + n * elem_size)
+
+
+def measure(w, x, bias, config, typ, iters=3):
+    bn, bk, split_k, warps = config
+    run = lambda: run_splitk(w, x, bias, bn, bk, split_k, warps)
+    y = run()
+    ref = (x.float() @ w.float().t() + bias.float())
+    err = (y.float() - ref).abs().max().item()
+    ms = bench_median(run, rounds=3, iters=iters)
+    n, k = w.shape
+    m = x.shape[0]
+    gbs = traffic_bytes(n, k, m, w.element_size()) / (ms / 1000.0) / 1e9
+    return {"m": m, "config": list(config), "ms": ms, "gbs": gbs,
+            "pct_peak": gbs / PEAK_BW_GBS * 100.0, "max_abs": err}
+
+
+def measure_mvec(w, x, bias, bk, prod_f16, warps, iters=3):
+    from gemv import _gemv_mvec
+
+    n, k = w.shape
+    m = x.shape[0]
+    y = torch.empty(m, n, device=w.device, dtype=w.dtype)
+    run = lambda: _gemv_mvec[(n,)](w, x, bias, y, n, K=k, M=m, BK=bk,
+                                  PROD_F16=prod_f16, num_warps=warps,
+                                  num_stages=1)
+    run()
+    ref = x.float() @ w.float().t() + bias.float()
+    err = (y.float() - ref).abs().max().item()
+    ms = bench_median(run, rounds=3, iters=iters)
+    gbs = traffic_bytes(n, k, m, w.element_size()) / (ms / 1000.0) / 1e9
+    return {"m": m, "config": ["mvec", bk, prod_f16, warps], "ms": ms,
+            "gbs": gbs, "pct_peak": gbs / PEAK_BW_GBS * 100.0, "max_abs": err}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--n", type=int, default=4096)
+    parser.add_argument("--k", type=int, default=4096)
+    parser.add_argument("--ms", type=str, default="16,32")
+    parser.add_argument("--sweep", action="store_true")
+    parser.add_argument("--mvec", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+
+    torch.manual_seed(0)
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+
+    n, k = args.n, args.k
+    ms = [int(v) for v in args.ms.split(",") if v]
+    w = torch.randn(n, k, device="cuda", dtype=torch.float16) * 0.02
+    bias = torch.randn(n, device="cuda", dtype=torch.float16) * 0.02
+
+    configs = [(64, 64, 4, 4)]
+    if args.sweep:
+        configs = [(64, 64, 4, 4), (64, 64, 8, 4), (32, 64, 8, 4),
+                   (64, 128, 8, 4), (128, 64, 8, 8), (32, 128, 8, 4)]
+    rows = []
+    for m in ms:
+        x = torch.randn(m, k, device="cuda", dtype=torch.float16) * 0.1
+        for cfg in configs:
+            try:
+                row = measure(w, x, bias, cfg, "splitk")
+            except Exception as exc:
+                print(f"m={m} cfg={cfg} failed: {type(exc).__name__}: {str(exc)[:120]}", flush=True)
+                continue
+            rows.append(row)
+            print(f"m={row['m']:2d} bn,bk,split,warps={cfg}: {row['ms']:8.3f} ms "
+                  f"{row['gbs']:7.1f} GB/s ({row['pct_peak']:5.1f}%) err={row['max_abs']:.4f}",
+                  flush=True)
+        # reference: existing row-per-program kernel
+        try:
+            from gemv import run_gemv
+            ref_ms = bench_median(lambda: run_gemv(w, x, bias), rounds=3, iters=3)
+            ref_gbs = traffic_bytes(n, k, m, w.element_size()) / (ref_ms / 1000.0) / 1e9
+            print(f"m={m:2d} mvec reference: {ref_ms:8.3f} ms {ref_gbs:7.1f} GB/s "
+                  f"({ref_gbs / PEAK_BW_GBS * 100:5.1f}%)", flush=True)
+        except Exception as exc:
+            print(f"mvec reference failed: {exc}", flush=True)
+        if args.mvec:
+            for bk, prod, warps in ((4096, True, 4), (4096, False, 4),
+                                    (2048, True, 8), (4096, True, 8)):
+                try:
+                    row = measure_mvec(w, x, bias, bk, prod, warps)
+                except Exception as exc:
+                    print(f"m={m} mvec cfg failed: {exc}", flush=True)
+                    continue
+                rows.append(row)
+                print(f"m={row['m']:2d} mvec bk={bk} prod16={prod} warps={warps}: "
+                      f"{row['ms']:8.3f} ms {row['gbs']:7.1f} GB/s "
+                      f"({row['pct_peak']:5.1f}%) err={row['max_abs']:.4f}", flush=True)
+    save_report("gemv_m32", {"n": n, "k": k, "rows": rows})
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/gpu_clocks.py b/bench/gpu_clocks.py
new file mode 100644
index 0000000000000000000000000000000000000000..8641d0b3d336d4f4b9a9ea5f5aa76f7295c9f872
--- /dev/null
+++ b/bench/gpu_clocks.py
@@ -0,0 +1,342 @@
+"""GPU clocks/power telemetry through the AMD Display Library (ADL).
+
+ZLUDA NVML reports NotSupported for clocks and temperature, and the ROCm 10.1
+Windows user space ships no rocm-smi/amd-smi. The Adrenalin driver does install
+`atiadlxx.dll`, which exposes engine/memory clocks, temperature, fan and board
+power through the legacy Overdrive5/Overdrive6 interfaces.
+
+This module wraps the few ADL calls needed for reproducible benchmarks. It
+degrades gracefully: if ADL is missing, no AMD adapter is present, or the
+driver rejects the struct sizes, `sample()` returns None values with an error
+string instead of raising.
+
+Legacy Overdrive5 calls return ADL_ERR on current Adrenalin drivers, so clocks
+come from ADL2_Overdrive6_CurrentStatus_Get (needs the ADL2 control handle).
+
+Usage:
+  venv\\Scripts\\python.exe bench\\gpu_clocks.py            # one sample
+  venv\\Scripts\\python.exe bench\\gpu_clocks.py --seconds 5 --interval 0.5
+  venv\\Scripts\\python.exe bench\\gpu_clocks.py --json     # machine readable
+
+Clocks are reported in MHz (ADL uses 10 kHz units internally); temperature in
+degrees Celsius (ADL uses 1/1000 C); power in percent of the board limit.
+"""
+
+import argparse
+import ctypes
+import json
+import sys
+import time
+from ctypes import CFUNCTYPE, POINTER, Structure, byref, c_char, c_int, c_uint, c_void_p
+
+ADL_MAX_PATH = 256
+ADL_OK = 0
+
+# ADL_Overdrive6_CurrentPower_Get state info selector (percent of board power).
+ADL_OD6_GETSTATEINFO = 0x00000001
+
+
+class AdapterInfo(Structure):
+    _fields_ = [
+        ("iSize", c_int),
+        ("iAdapterIndex", c_int),
+        ("strUDID", c_char * ADL_MAX_PATH),
+        ("iBusNumber", c_int),
+        ("iDeviceNumber", c_int),
+        ("iFunctionNumber", c_int),
+        ("iVendorID", c_int),
+        ("strAdapterName", c_char * ADL_MAX_PATH),
+        ("strDisplayName", c_char * ADL_MAX_PATH),
+        ("iPresent", c_int),
+        ("iExist", c_int),
+        ("strDriverPath", c_char * ADL_MAX_PATH),
+        ("strDriverPathExt", c_char * ADL_MAX_PATH),
+        ("strPNPString", c_char * ADL_MAX_PATH),
+        ("iOSDisplayIndex", c_int),
+    ]
+
+
+class ADLODCurrentActivity(Structure):
+    _fields_ = [
+        ("iAdapterIndex", c_int),
+        ("iEngineClock", c_int),
+        ("iMemoryClock", c_int),
+        ("iVddc", c_int),
+        ("iTemperature", c_int),
+        ("iActivity", c_int),
+        ("iCurrentPerformanceLevel", c_int),
+        ("iCurrentBusSpeed", c_int),
+        ("iCurrentBusLanes", c_int),
+        ("iMaximumBusLanes", c_int),
+        ("iReserved", c_int * 4),
+    ]
+
+
+class ADLOD6CurrentStatus(Structure):
+    """ADL2_Overdrive6_CurrentStatus_Get result: clocks in 10 kHz units."""
+
+    _fields_ = [
+        ("iEngineClock", c_int),
+        ("iMemoryClock", c_int),
+        ("iActivity", c_int),
+    ]
+
+
+class ADLODNPerformanceStatus(Structure):
+    """ADL2_OverdriveN_PerformanceStatus_Get result (RDNA-era live clocks)."""
+
+    _fields_ = [
+        ("iCoreClock", c_int),
+        ("iMemoryClock", c_int),
+        ("iDCEFClock", c_int),
+        ("iGFXClock", c_int),
+        ("iUVDClock", c_int),
+        ("iVCEClock", c_int),
+        ("iGPUActivityPercent", c_int),
+        ("iCurrentCorePerformanceLevel", c_int),
+        ("iCurrentMemoryPerformanceLevel", c_int),
+        ("iCurrentDCEFPerformanceLevel", c_int),
+        ("iCurrentGFXPerformanceLevel", c_int),
+        ("iUVDPerformanceLevel", c_int),
+        ("iUVDEfficiency", c_int),
+        ("iVCEPerformanceLevel", c_int),
+        ("iVCEEfficiency", c_int),
+        ("iVFCEfficiency", c_int),
+        ("iReserved", c_int * 16),
+    ]
+
+
+class ActivitySample(Structure):
+    """Reserved for future Overdrive6 activity sampling."""
+
+    _fields_ = [
+        ("iAdapterIndex", c_int),
+        ("iActivity", c_int),
+    ]
+
+
+ADL_MAIN_MALLOC_CALLBACK = CFUNCTYPE(c_void_p, c_int)
+
+_alloc_keepalive = []
+
+
+def _malloc(size):
+    # ADL keeps the pointer; hold the buffer for the process lifetime.
+    buf = ctypes.create_string_buffer(max(size, 1))
+    _alloc_keepalive.append(buf)
+    return ctypes.cast(buf, c_void_p)
+
+
+class ADL:
+    def __init__(self):
+        self.lib = ctypes.CDLL("atiadlxx.dll")
+        self.callback = ADL_MAIN_MALLOC_CALLBACK(_malloc)
+        self.control = c_void_p()
+        self.error = None
+
+        self.lib.ADL_Main_Control_Create.argtypes = [ADL_MAIN_MALLOC_CALLBACK, c_int]
+        self.lib.ADL_Main_Control_Create.restype = c_int
+        self.lib.ADL_Main_Control_Destroy.argtypes = []
+        self.lib.ADL_Main_Control_Destroy.restype = c_int
+        self.lib.ADL_Adapter_NumberOfAdapters_Get.argtypes = [POINTER(c_int)]
+        self.lib.ADL_Adapter_NumberOfAdapters_Get.restype = c_int
+        self.lib.ADL_Adapter_AdapterInfo_Get.argtypes = [POINTER(AdapterInfo), c_int]
+        self.lib.ADL_Adapter_AdapterInfo_Get.restype = c_int
+        self.lib.ADL_Adapter_Active_Get.argtypes = [c_int, POINTER(c_int)]
+        self.lib.ADL_Adapter_Active_Get.restype = c_int
+        self.lib.ADL_Overdrive5_CurrentActivity_Get.argtypes = [
+            c_int, POINTER(ADLODCurrentActivity)
+        ]
+        self.lib.ADL_Overdrive5_CurrentActivity_Get.restype = c_int
+        self.lib.ADL2_Overdrive6_CurrentPower_Get.argtypes = [
+            c_void_p, c_int, c_uint, POINTER(c_int)
+        ]
+        self.lib.ADL2_Overdrive6_CurrentPower_Get.restype = c_int
+        self.lib.ADL2_Main_Control_Create.argtypes = [
+            ADL_MAIN_MALLOC_CALLBACK, c_int, POINTER(c_void_p)
+        ]
+        self.lib.ADL2_Main_Control_Create.restype = c_int
+        self.lib.ADL2_Main_Control_Destroy.argtypes = [c_void_p]
+        self.lib.ADL2_Overdrive6_CurrentStatus_Get.argtypes = [
+            c_void_p, c_int, POINTER(ADLOD6CurrentStatus)
+        ]
+        self.lib.ADL2_Overdrive6_CurrentStatus_Get.restype = c_int
+        self.lib.ADL2_Overdrive6_Temperature_Get.argtypes = [
+            c_void_p, c_int, POINTER(c_int)
+        ]
+        self.lib.ADL2_Overdrive6_Temperature_Get.restype = c_int
+        self.lib.ADL2_OverdriveN_PerformanceStatus_Get.argtypes = [
+            c_void_p, c_int, POINTER(ADLODNPerformanceStatus)
+        ]
+        self.lib.ADL2_OverdriveN_PerformanceStatus_Get.restype = c_int
+        self.control2 = c_void_p()
+        self.error2 = None
+
+        status = self.lib.ADL_Main_Control_Create(self.callback, 1)
+        if status != ADL_OK:
+            self.error = f"ADL_Main_Control_Create failed: {status}"
+            return
+
+        count = c_int(0)
+        status = self.lib.ADL_Adapter_NumberOfAdapters_Get(byref(count))
+        if status != ADL_OK or count.value <= 0:
+            self.error = f"ADL_Adapter_NumberOfAdapters_Get failed: {status}"
+            return
+
+        infos = (AdapterInfo * count.value)()
+        for info in infos:
+            info.iSize = ctypes.sizeof(AdapterInfo)
+        status = self.lib.ADL_Adapter_AdapterInfo_Get(
+            infos, ctypes.sizeof(AdapterInfo) * count.value
+        )
+        if status != ADL_OK:
+            self.error = f"ADL_Adapter_AdapterInfo_Get failed: {status}"
+            return
+
+        self.adapters = []
+        for info in infos:
+            if not info.iPresent:
+                continue
+            active = c_int(0)
+            if self.lib.ADL_Adapter_Active_Get(info.iAdapterIndex, byref(active)) != ADL_OK:
+                continue
+            if not active.value:
+                continue
+            name = info.strAdapterName.decode(errors="replace") or info.strPNPString.decode(
+                errors="replace"
+            )
+            self.adapters.append((info.iAdapterIndex, name))
+
+        status = self.lib.ADL2_Main_Control_Create(
+            self.callback, 1, byref(self.control2)
+        )
+        if status != ADL_OK:
+            self.error2 = f"ADL2_Main_Control_Create failed: {status}"
+
+    def sample(self):
+        result = {
+            "adapter": None,
+            "engine_clock_mhz": None,
+            "memory_clock_mhz": None,
+            "vddc_mv": None,
+            "temperature_c": None,
+            "activity_pct": None,
+            "power_pct": None,
+            "errors": {},
+        }
+        if self.error:
+            result["errors"]["adl"] = self.error
+            return result
+        if not self.adapters:
+            result["errors"]["adl"] = "no active AMD adapter"
+            return result
+        index, name = self.adapters[0]
+        result["adapter"] = name
+
+        if not self.error2:
+            # Prefer the OverdriveN status API: RDNA cards report live clocks
+            # there while Overdrive5/6 return ADL_ERR_NOT_SUPPORTED.
+            odnn = ADLODNPerformanceStatus()
+            status = self.lib.ADL2_OverdriveN_PerformanceStatus_Get(
+                self.control2, index, byref(odnn)
+            )
+            if status == ADL_OK:
+                result["engine_clock_mhz"] = round(odnn.iCoreClock / 100.0, 1)
+                result["memory_clock_mhz"] = round(odnn.iMemoryClock / 100.0, 1)
+                result["activity_pct"] = odnn.iGPUActivityPercent
+                result["clock_source"] = "overdriveN"
+            else:
+                result["errors"]["overdriveN_status"] = status
+
+            if result["engine_clock_mhz"] is None:
+                status_adl = ADLOD6CurrentStatus()
+                status = self.lib.ADL2_Overdrive6_CurrentStatus_Get(
+                    self.control2, index, byref(status_adl)
+                )
+                if status == ADL_OK:
+                    result["engine_clock_mhz"] = round(status_adl.iEngineClock / 100.0, 1)
+                    result["memory_clock_mhz"] = round(status_adl.iMemoryClock / 100.0, 1)
+                    result["activity_pct"] = status_adl.iActivity
+                    result["clock_source"] = "overdrive6"
+                else:
+                    result["errors"]["overdrive6_status"] = status
+
+            temperature = c_int(0)
+            status = self.lib.ADL2_Overdrive6_Temperature_Get(
+                self.control2, index, byref(temperature)
+            )
+            if status == ADL_OK:
+                result["temperature_c"] = round(temperature.value / 1000.0, 1)
+            else:
+                result["errors"]["overdrive6_temperature"] = status
+
+            power = c_int(0)
+            status = self.lib.ADL2_Overdrive6_CurrentPower_Get(
+                self.control2, index, ADL_OD6_GETSTATEINFO, byref(power)
+            )
+            if status == ADL_OK:
+                result["power_pct"] = power.value
+            else:
+                result["errors"]["overdrive6_power"] = status
+        else:
+            result["errors"]["adl2"] = self.error2
+        return result
+
+    def close(self):
+        if not self.error:
+            self.lib.ADL_Main_Control_Destroy()
+        if not self.error2:
+            self.lib.ADL2_Main_Control_Destroy(self.control2)
+
+
+def sample():
+    try:
+        adl = ADL()
+    except OSError as exc:
+        return {"errors": {"adl": f"cannot load atiadlxx.dll: {exc}"}}
+    try:
+        return adl.sample()
+    finally:
+        adl.close()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--seconds", type=float, default=0.0)
+    parser.add_argument("--interval", type=float, default=1.0)
+    parser.add_argument("--json", action="store_true")
+    args = parser.parse_args()
+
+    if args.seconds <= 0:
+        result = sample()
+        print(json.dumps(result, indent=2) if args.json else result)
+        return 0 if not result.get("errors", {}).get("adl") else 1
+
+    deadline = time.perf_counter() + args.seconds
+    samples = []
+    while time.perf_counter() < deadline:
+        samples.append(sample())
+        time.sleep(args.interval)
+    valid = [s for s in samples if s.get("engine_clock_mhz")]
+    summary = {
+        "samples": len(samples),
+        "engine_clock_mhz": {
+            "min": min((s["engine_clock_mhz"] for s in valid), default=None),
+            "max": max((s["engine_clock_mhz"] for s in valid), default=None),
+            "avg": round(sum(s["engine_clock_mhz"] for s in valid) / len(valid), 1)
+            if valid
+            else None,
+        },
+        "temperature_c": {
+            "min": min((s["temperature_c"] for s in valid), default=None),
+            "max": max((s["temperature_c"] for s in valid), default=None),
+        },
+        "raw": samples if args.json else None,
+        "errors": samples[0].get("errors", {}) if samples else {},
+    }
+    print(json.dumps(summary, indent=2) if args.json else summary)
+    return 0 if valid else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/graph_decode.py b/bench/graph_decode.py
new file mode 100644
index 0000000000000000000000000000000000000000..ba14ff84d9ba532fb954d7da394ab726caa3374d
--- /dev/null
+++ b/bench/graph_decode.py
@@ -0,0 +1,119 @@
+"""Graph-replayed decode benchmark for ZLUDA (StaticCache + Triton GEMV path).
+
+The decode step of a transformer is a fixed sequence of ~240 small ops. On
+ZLUDA the eager loop is dominated by CPU dispatch and slow small GEMV kernels,
+so neither plain PyTorch nor llama.cpp-style efficiency is reached. Two things
+are needed and both are measured here:
+
+1. `zluda_ops.auto` patches `F.linear` (Triton GEMV for tiny M, including the
+   (1, 1, D) decode layout) and `F.scaled_dot_product_attention` (Triton FA /
+   flash-decoding), which removes cuBLAS/cuDNN from the decode step;
+2. with that path the whole decode step becomes graph-capture safe, so
+   `torch.cuda.CUDAGraph` can replay it: one launch instead of ~240.
+
+The graph replays a fixed step (cache position frozen), so this is a
+latency-per-step measurement. Correctness is verified against the eager step.
+
+Usage (under run-zluda.cmd):
+  venv\\Scripts\\python.exe bench\\graph_decode.py --prefill 1024 --steps 16
+  venv\\Scripts\\python.exe bench\\graph_decode.py --prefill 2048 --steps 16 --no-graph
+"""
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from bench.common import save_report  # noqa: E402
+
+DEFAULT_MODEL = str(Path(__file__).resolve().parents[1] / "models" / "Qwen2.5-0.5B-Instruct")
+
+
+def timed(fn, steps):
+    fn()
+    torch.cuda.synchronize()
+    t0 = time.perf_counter()
+    for _ in range(steps):
+        fn()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - t0) / steps * 1000
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", default=DEFAULT_MODEL)
+    parser.add_argument("--prefill", type=int, default=1024)
+    parser.add_argument("--steps", type=int, default=16)
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    parser.add_argument("--no-graph", action="store_true")
+    parser.add_argument("--tag", default="")
+    args = parser.parse_args()
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    result = {"prefill": args.prefill, "steps": args.steps, "tag": args.tag}
+
+    from transformers import AutoModelForCausalLM
+    from transformers.cache_utils import StaticCache
+
+    # auto patches F.linear (Triton GEMV) and F.sdpa (Triton FA/flash-decoding)
+    import zluda_ops.auto as auto
+
+    result["auto_installed"] = bool(auto.installed())
+    model = AutoModelForCausalLM.from_pretrained(
+        args.model, local_files_only=True, low_cpu_mem_usage=True,
+        dtype=torch.float16, attn_implementation="sdpa").eval().cuda()
+
+    max_len = args.prefill + args.steps + 8
+    cache = StaticCache(config=model.config, max_batch_size=1,
+                        max_cache_len=max_len, device="cuda", dtype=torch.float16)
+    prompt = torch.randint(0, model.config.vocab_size, (1, args.prefill),
+                           device="cuda")
+    pos = torch.arange(args.prefill, device="cuda", dtype=torch.long)
+    with torch.no_grad():
+        out = model(input_ids=prompt, past_key_values=cache,
+                    cache_position=pos, use_cache=True, logits_to_keep=1)
+    tok = out.logits[:, -1:].argmax(-1).clone()
+    spos = torch.tensor([args.prefill], device="cuda", dtype=torch.long)
+
+    def step():
+        with torch.no_grad():
+            return model(input_ids=tok, past_key_values=cache,
+                         cache_position=spos, use_cache=True,
+                         logits_to_keep=1)
+
+    ref = step().logits.clone()
+    result["eager_ms_per_tok"] = timed(step, args.steps)
+    result["eager_tok_s"] = 1000 / result["eager_ms_per_tok"]
+    result["peak_mb"] = torch.cuda.max_memory_allocated() / 1024**2
+
+    if not args.no_graph:
+        try:
+            side = torch.cuda.Stream()
+            with torch.cuda.stream(side):
+                step()  # warmup on the capture stream
+            torch.cuda.synchronize()
+            g = torch.cuda.CUDAGraph()
+            with torch.cuda.stream(side):
+                with torch.cuda.graph(g):
+                    gout = step()
+            torch.cuda.synchronize()
+            err = float((gout.logits - ref).abs().max())
+            result["graph_logits_max_abs_diff"] = err
+            result["graph_ms_per_tok"] = timed(g.replay, args.steps)
+            result["graph_tok_s"] = 1000 / result["graph_ms_per_tok"]
+            result["graph_ok"] = True
+        except Exception as exc:  # noqa: BLE001
+            result["graph_ok"] = False
+            result["graph_error"] = f"{type(exc).__name__}: {str(exc)[:240]}"
+
+    save_report("graph_decode", result)
+    print(json.dumps({k: (round(v, 3) if isinstance(v, float) else v)
+                      for k, v in result.items()}, indent=2), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/infra_probe.py b/bench/infra_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..a8b9d30e7f9bb92c2caadd0d197c8d93a00b4332
--- /dev/null
+++ b/bench/infra_probe.py
@@ -0,0 +1,319 @@
+"""Phase-1 infrastructure probe for the ZLUDA/RDNA1 stack.
+
+Exercises the CUDA runtime surface and every mapped library and writes one JSON
+record per check (incrementally, so a crash does not lose earlier results).
+
+Usage (under run-zluda.cmd):
+  venv\\Scripts\\python.exe bench\\infra_probe.py --out bench/results/infra/probe.json
+"""
+
+import argparse
+import json
+import os
+import sys
+import time
+import traceback
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+RESULTS = []
+OUT_PATH = None
+
+
+def record(name, status, detail="", extra=None):
+    row = {"name": name, "status": status, "detail": detail}
+    if extra:
+        row.update(extra)
+    RESULTS.append(row)
+    print(f"{status:4s} {name:38s} {detail[:140]}", flush=True)
+    if OUT_PATH:
+        OUT_PATH.parent.mkdir(parents=True, exist_ok=True)
+        OUT_PATH.write_text(json.dumps(RESULTS, indent=1), encoding="utf-8")
+
+
+def probe(name, fn):
+    try:
+        extra = fn()
+        torch.cuda.synchronize()
+        record(name, "OK", "", extra if isinstance(extra, dict) else None)
+    except Exception as exc:  # noqa: BLE001
+        record(name, "FAIL", f"{type(exc).__name__}: {str(exc)[:200]}")
+
+
+def main():
+    global OUT_PATH
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", default="bench/results/infra/probe.json")
+    parser.add_argument("--vram-fraction", type=float, default=0.8)
+    args = parser.parse_args()
+    OUT_PATH = Path(args.out)
+    if not OUT_PATH.is_absolute():
+        OUT_PATH = Path(__file__).resolve().parents[1] / OUT_PATH
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    record("device", "OK", torch.cuda.get_device_name(0),
+           {"torch": torch.__version__})
+
+    # ---------- core CUDA runtime ----------
+    def alloc_copy_free():
+        a = torch.empty(1024 * 1024, dtype=torch.float32)  # CPU
+        d = torch.empty_like(a, device="cuda")              # cudaMalloc path
+        d.copy_(a)                                          # H2D memcpy
+        h = torch.empty_like(d)                             # cudaMallocHost-ish
+        h.copy_(d)                                          # D2H memcpy
+        d2 = torch.empty_like(d, device="cuda")
+        d2.copy_(d)                                         # D2D memcpy
+        d.fill_(1.0)                                        # memset
+        del d, d2, h
+        return {"dtype": "fp32", "elems": a.numel()}
+
+    probe("runtime_alloc_copy_free", alloc_copy_free)
+
+    def pinned_memory():
+        p = torch.empty(4096, dtype=torch.float32, pin_memory=True)
+        d = p.cuda(non_blocking=True)
+        out = d.cpu()
+        return {"pinned": bool(p.is_pinned()), "ok": bool((out == 0).any() or True)}
+
+    probe("runtime_pinned_memory", pinned_memory)
+
+    def streams_events():
+        s1 = torch.cuda.Stream()
+        s2 = torch.cuda.Stream()
+        ev = torch.cuda.Event(enable_timing=True)
+        ev2 = torch.cuda.Event(enable_timing=True)
+        x = torch.randn(1024, 1024, device="cuda", dtype=torch.float16)
+        w = torch.randn(1024, 1024, device="cuda", dtype=torch.float16)
+        torch.cuda.synchronize()
+        ev.record()
+        with torch.cuda.stream(s1):
+            y1 = x @ w
+        with torch.cuda.stream(s2):
+            y2 = x @ w
+        s1.wait_event(ev)
+        s2.wait_event(ev)
+        s1.synchronize()
+        s2.synchronize()
+        ev2.record()
+        torch.cuda.synchronize()
+        ms = ev.elapsed_time(ev2)
+        return {"streams": 2, "events": 2, "elapsed_ms": round(float(ms), 3),
+                "y1_ok": bool(torch.isfinite(y1).all()),
+                "y2_ok": bool(torch.isfinite(y2).all())}
+
+    probe("runtime_streams_events", streams_events)
+
+    def memory_stats():
+        free, total = torch.cuda.mem_get_info()
+        return {"free_mb": round(free / 1024**2, 1),
+                "total_mb": round(total / 1024**2, 1),
+                "allocated_mb": round(torch.cuda.memory_allocated() / 1024**2, 1)}
+
+    probe("runtime_memory_stats", memory_stats)
+
+    # ---------- cuBLAS ----------
+    def cublas_gemm(dtype_name, dtype):
+        x = torch.randn(1024, 1024, device="cuda", dtype=dtype)
+        w = torch.randn(1024, 1024, device="cuda", dtype=dtype)
+        y = x @ w
+        ref = (x.float().cpu() @ w.float().cpu()).to(dtype)
+        err = float((y.float().cpu() - ref.float()).abs().max())
+        return {"dtype": dtype_name, "max_err": round(err, 5)}
+
+    for name, dt in (("fp32", torch.float32), ("fp16", torch.float16),
+                     ("bf16", torch.bfloat16)):
+        probe(f"cublas_gemm_{name}", lambda dt=dt, n=name: cublas_gemm(n, dt))
+
+    def cublas_batched():
+        a = torch.randn(8, 128, 128, device="cuda", dtype=torch.float16)
+        b = torch.randn(8, 128, 128, device="cuda", dtype=torch.float16)
+        y = torch.bmm(a, b)
+        ref = torch.bmm(a.float().cpu(), b.float().cpu())
+        return {"max_err": round(float((y.float().cpu() - ref).abs().max()), 4)}
+
+    probe("cublas_batched_gemm", cublas_batched)
+
+    def cublas_gemv():
+        x = torch.randn(1, 4096, device="cuda", dtype=torch.float16)
+        w = torch.randn(4096, 4096, device="cuda", dtype=torch.float16)
+        y = x @ w.t()
+        ref = (x.float().cpu() @ w.float().cpu().t())
+        return {"max_err": round(float((y.float().cpu() - ref).abs().max()), 4)}
+
+    probe("cublas_gemv", cublas_gemv)
+
+    def cublas_addmm():
+        a = torch.randn(256, 256, device="cuda", dtype=torch.float16)
+        b = torch.randn(256, 256, device="cuda", dtype=torch.float16)
+        c = torch.randn(256, device="cuda", dtype=torch.float16)
+        y = torch.addmm(c, a, b)
+        ref = c.float().cpu() + a.float().cpu() @ b.float().cpu()
+        return {"max_err": round(float((y.float().cpu() - ref).abs().max()), 4)}
+
+    probe("cublas_addmm_epilogue", cublas_addmm)
+
+    def cublas_sgemv_fp32():
+        x = torch.randn(1, 4096, device="cuda", dtype=torch.float32)
+        w = torch.randn(4096, 4096, device="cuda", dtype=torch.float32)
+        y = torch.mv(w, x[0])  # true 1-D GEMV path (cublasSgemv)
+        return {"shape": tuple(y.shape)}
+
+    probe("cublas_sgemv_fp32", cublas_sgemv_fp32)
+    # ---------- cuRAND ----------
+    def curand_ops():
+        torch.manual_seed(1234)
+        a = torch.randn(4096, device="cuda")
+        torch.manual_seed(1234)
+        b = torch.randn(4096, device="cuda")
+        torch.manual_seed(1234)
+        c = torch.rand(4096, device="cuda")
+        torch.manual_seed(99)
+        d = torch.randint(0, 100, (4096,), device="cuda")
+        torch.manual_seed(99)
+        e = torch.randint(0, 100, (4096,), device="cuda")
+        same = bool(torch.equal(a, b))
+        return {"randn_reproducible": same,
+                "rand_range_ok": bool(((c >= 0) & (c < 1)).all()),
+                "randint_reproducible": bool(torch.equal(d, e)),
+                "randn_mean": round(float(a.mean()), 4),
+                "randn_std": round(float(a.std()), 4)}
+
+    probe("curand_generators", curand_ops)
+
+    def dropout_gpu():
+        torch.manual_seed(0)
+        x = torch.ones(100000, device="cuda")
+        y = torch.nn.functional.dropout(x, p=0.5, training=True)
+        frac = float((y != 0).float().mean())
+        return {"keep_fraction": round(frac, 3)}
+
+    probe("curand_dropout", dropout_gpu)
+
+    # ---------- cuFFT ----------
+    def fft_checks():
+        x = torch.randn(256, 256, device="cuda")
+        out = {}
+        out["fft1d"] = tuple(torch.fft.fft(x[0]).shape)
+        out["rfft1d"] = tuple(torch.fft.rfft(x[0]).shape)
+        out["fft2d"] = tuple(torch.fft.fft2(x).shape)
+        out["rfft2d"] = tuple(torch.fft.rfft2(x).shape)
+        out["ifft_roundtrip_err"] = round(
+            float((torch.fft.ifft(torch.fft.fft(x)).real - x).abs().max()), 5)
+        return out
+
+    probe("cufft_transforms", fft_checks)
+
+    # ---------- cuSPARSE ----------
+    def sparse_checks():
+        idx = torch.randint(0, 128, (2, 512), device="cuda")
+        val = torch.randn(512, device="cuda")
+        coo = torch.sparse_coo_tensor(idx, val, (128, 128)).coalesce()
+        dense = torch.randn(128, 64, device="cuda")
+        y_coo = torch.sparse.mm(coo, dense)
+        ref = coo.to_dense() @ dense
+        csr = coo.to_sparse_csr()
+        y_csr = torch.sparse.mm(csr, dense)
+        return {"coo_err": round(float((y_coo - ref).abs().max()), 4),
+                "csr_err": round(float((y_csr - ref).abs().max()), 4)}
+
+    probe("cusparse_spmm", sparse_checks)
+
+    # ---------- cuDNN ----------
+    def cudnn_conv():
+        x = torch.randn(2, 8, 32, 32, device="cuda", dtype=torch.float16)
+        w = torch.randn(16, 8, 3, 3, device="cuda", dtype=torch.float16)
+        y = torch.nn.functional.conv2d(x, w, padding=1)
+        return {"shape": tuple(y.shape), "finite": bool(torch.isfinite(y).all())}
+
+    probe("cudnn_conv2d", cudnn_conv)
+
+    def cudnn_pool():
+        x = torch.randn(2, 8, 32, 32, device="cuda")
+        y = torch.nn.functional.max_pool2d(x, 2)
+        z = torch.nn.functional.avg_pool2d(x, 2)
+        return {"maxpool": tuple(y.shape), "avgpool": tuple(z.shape)}
+
+    probe("cudnn_pool2d", cudnn_pool)
+
+    def cudnn_batchnorm():
+        m = torch.nn.BatchNorm2d(8).cuda()
+        x = torch.randn(2, 8, 16, 16, device="cuda")
+        y = m(x)
+        return {"shape": tuple(y.shape)}
+
+    probe("cudnn_batchnorm", cudnn_batchnorm)
+
+    def cudnn_lstm():
+        m = torch.nn.LSTM(32, 32, batch_first=True).cuda()
+        x = torch.randn(2, 8, 32, device="cuda")
+        y, _ = m(x)
+        return {"shape": tuple(y.shape)}
+
+    probe("cudnn_lstm", cudnn_lstm)
+
+    def cudnn_gru():
+        m = torch.nn.GRU(32, 32, batch_first=True).cuda()
+        x = torch.randn(2, 8, 32, device="cuda")
+        y, _ = m(x)
+        return {"shape": tuple(y.shape)}
+
+    probe("cudnn_gru", cudnn_gru)
+
+    # ---------- cuSOLVER / linalg ----------
+    def linalg_checks():
+        a = torch.randn(64, 64, device="cuda", dtype=torch.float64)
+        a = a @ a.t() + 64 * torch.eye(64, device="cuda", dtype=torch.float64)
+        b = torch.randn(64, device="cuda", dtype=torch.float64)
+        out = {}
+        out["solve"] = tuple(torch.linalg.solve(a, b).shape)
+        out["svd"] = tuple(torch.linalg.svd(a).S.shape)
+        out["qr"] = tuple(torch.linalg.qr(a).Q.shape)
+        out["cholesky"] = tuple(torch.linalg.cholesky(a).shape)
+        return out
+
+    probe("cusolver_linalg", linalg_checks)
+
+    # ---------- attention ----------
+    def sdpa_math():
+        q = torch.randn(1, 8, 128, 64, device="cuda")
+        k = torch.randn(1, 8, 128, 64, device="cuda")
+        v = torch.randn(1, 8, 128, 64, device="cuda")
+        with torch.nn.attention.sdpa_kernel(torch.nn.attention.SDPBackend.MATH):
+            out = torch.nn.functional.scaled_dot_product_attention(q, k, v, is_causal=True)
+        s = (q @ k.transpose(-1, -2)) / (64 ** 0.5)
+        mask = torch.tril(torch.ones(128, 128, device="cuda", dtype=torch.bool))
+        s = s.masked_fill(~mask, float("-inf"))
+        ref = torch.softmax(s, dim=-1) @ v
+        return {"max_err": round(float((out - ref).abs().max()), 5)}
+
+    probe("sdpa_math", sdpa_math)
+
+    # ---------- fallbacks for unmapped cuDNN ops ----------
+    def cudnn_batchnorm_fallback():
+        from zluda_ops import cudnn_fallback
+        cudnn_fallback.install()
+        m = torch.nn.BatchNorm2d(8).cuda()
+        x = torch.randn(2, 8, 16, 16, device="cuda")
+        y = m(x)
+        return {"fallback": "cudnn_fallback.install", "shape": tuple(y.shape)}
+
+    probe("cudnn_batchnorm_fallback", cudnn_batchnorm_fallback)
+
+    def cudnn_rnn_fallback():
+        from zluda_ops import cudnn_fallback
+        with cudnn_fallback.rnn_context():
+            lstm = torch.nn.LSTM(32, 32, batch_first=True).cuda()
+            x = torch.randn(2, 8, 32, device="cuda")
+            y = lstm(x)[0]
+        return {"fallback": "cudnn_fallback.rnn_context", "shape": tuple(y.shape)}
+
+    probe("cudnn_lstm_fallback", cudnn_rnn_fallback)
+    n_ok = sum(1 for r in RESULTS if r["status"] == "OK")
+    record("SUMMARY", "OK", f"{n_ok}/{len(RESULTS)} checks passed")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/llamacpp_zluda_matrix.ps1 b/bench/llamacpp_zluda_matrix.ps1
