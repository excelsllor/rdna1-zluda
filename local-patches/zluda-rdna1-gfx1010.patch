+@echo off
+rem Run a command through ZLUDA.
+rem All paths are relative to this repository; every variable can be overridden
+rem from the environment before calling this script.
+setlocal
+
+set "ROOT=%~dp0"
+set "ROOT=%ROOT:~0,-1%"
+
+rem Visual Studio is only needed for its MSVC runtime/tools at run time. Locate
+rem the latest C++ Build Tools/VS installation; keep working when it is absent.
+set "VS="
+set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
+if exist "%VSWHERE%" for /f "usebackq tokens=*" %%i in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VS=%%i"
+if not defined VS if exist "C:\Program Files (x86)\Microsoft Visual Studio\18\BuildTools" set "VS=C:\Program Files (x86)\Microsoft Visual Studio\18\BuildTools"
+if defined VS if exist "%VS%\VC\Auxiliary\Build\vcvars64.bat" call "%VS%\VC\Auxiliary\Build\vcvars64.bat" >nul
+
+if defined ZLUDA_HIP_PATH (set "HIP_PATH=%ZLUDA_HIP_PATH%") else (set "HIP_PATH=%ROOT%\hip")
+if not exist "%HIP_PATH%\bin\amdhip64_7.dll" echo [run-zluda] warning: amdhip64_7.dll not found under "%HIP_PATH%\bin"
+if not defined HIP_VISIBLE_DEVICES set "HIP_VISIBLE_DEVICES=0"
+if not defined ZLUDA_CC set "ZLUDA_CC=8.6"
+if not defined TRITON_PTXAS_PATH set "TRITON_PTXAS_PATH=%ROOT%\target\release\ptxas.exe"
+if not defined TRITON_CACHE_DIR set "TRITON_CACHE_DIR=%ROOT%\.triton_cache"
+if not defined TORCHINDUCTOR_CACHE_DIR set "TORCHINDUCTOR_CACHE_DIR=%ROOT%\.inductor_cache"
+set "PATH=%ROOT%\target\release;%HIP_PATH%\bin;%PATH%"
+set "ROCBLAS_USE_HIPBLASLT=0"
+if not defined ROCBLAS_TENSILE_GEMM_OVERRIDE_PATH if exist "%ROOT%\tensile_overrides\gfx1010_hh.csv" set "ROCBLAS_TENSILE_GEMM_OVERRIDE_PATH=%ROOT%\tensile_overrides\gfx1010_hh.csv"
+
+"%ROOT%\target\release\zluda.exe" -- %*
diff --git a/smoke/add_kernel.py b/smoke/add_kernel.py
new file mode 100644
index 0000000000000000000000000000000000000000..01af5d8a1ccb8b220163be039d3e4be0de147871
--- /dev/null
+++ b/smoke/add_kernel.py
@@ -0,0 +1,90 @@
+import ctypes
+import sys
+
+PTX = b"""
+.version 8.0
+.target sm_80
+.address_size 64
+
+.visible .entry add(.param .u32 a, .param .u32 b, .param .u64 c)
+{
+    .reg .b32 %r<4>;
+    .reg .b64 %rd<2>;
+    ld.param.u32 %r1, [a];
+    ld.param.u32 %r2, [b];
+    add.s32 %r3, %r2, %r1;
+    ld.param.u64 %rd1, [c];
+    st.global.u32 [%rd1], %r3;
+    ret;
+}
+"""
+
+lib = ctypes.WinDLL("nvcuda.dll")
+
+lib.cuInit.argtypes = [ctypes.c_uint]
+lib.cuInit.restype = ctypes.c_int
+lib.cuDeviceGet.argtypes = [ctypes.POINTER(ctypes.c_int), ctypes.c_int]
+lib.cuDeviceGet.restype = ctypes.c_int
+lib.cuCtxCreate_v2.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_uint, ctypes.c_int]
+lib.cuCtxCreate_v2.restype = ctypes.c_int
+lib.cuMemAlloc_v2.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_size_t]
+lib.cuMemAlloc_v2.restype = ctypes.c_int
+lib.cuModuleLoadData.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_char_p]
+lib.cuModuleLoadData.restype = ctypes.c_int
+lib.cuModuleGetFunction.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_void_p, ctypes.c_char_p]
+lib.cuModuleGetFunction.restype = ctypes.c_int
+lib.cuLaunchKernel.argtypes = [
+    ctypes.c_void_p,
+    ctypes.c_uint, ctypes.c_uint, ctypes.c_uint,
+    ctypes.c_uint, ctypes.c_uint, ctypes.c_uint,
+    ctypes.c_uint, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p,
+]
+lib.cuLaunchKernel.restype = ctypes.c_int
+lib.cuCtxSynchronize.argtypes = []
+lib.cuCtxSynchronize.restype = ctypes.c_int
+lib.cuMemcpyHtoD_v2.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t]
+lib.cuMemcpyHtoD_v2.restype = ctypes.c_int
+lib.cuMemcpyDtoH_v2.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t]
+lib.cuMemcpyDtoH_v2.restype = ctypes.c_int
+
+
+def check(err, what):
+    if err != 0:
+        raise RuntimeError(f"{what} failed with cuda error {err}")
+
+
+check(lib.cuInit(0), "cuInit")
+
+dev = ctypes.c_int()
+check(lib.cuDeviceGet(ctypes.byref(dev), 0), "cuDeviceGet")
+
+ctx = ctypes.c_void_p()
+check(lib.cuCtxCreate_v2(ctypes.byref(ctx), 0, dev), "cuCtxCreate")
+
+dptr = ctypes.c_void_p()
+check(lib.cuMemAlloc_v2(ctypes.byref(dptr), 4), "cuMemAlloc")
+
+module = ctypes.c_void_p()
+check(lib.cuModuleLoadData(ctypes.byref(module), PTX), "cuModuleLoadData")
+
+func = ctypes.c_void_p()
+check(lib.cuModuleGetFunction(ctypes.byref(func), module, b"add"), "cuModuleGetFunction")
+
+a = ctypes.c_int(21)
+b = ctypes.c_int(21)
+args = (ctypes.c_void_p * 3)()
+args[0] = ctypes.cast(ctypes.byref(a), ctypes.c_void_p)
+args[1] = ctypes.cast(ctypes.byref(b), ctypes.c_void_p)
+args[2] = ctypes.cast(ctypes.byref(dptr), ctypes.c_void_p)
+
+check(lib.cuLaunchKernel(func, 1, 1, 1, 1, 1, 1, 0, None, args, None), "cuLaunchKernel")
+check(lib.cuCtxSynchronize(), "cuCtxSynchronize")
+
+out = ctypes.c_int(0)
+check(lib.cuMemcpyDtoH_v2(ctypes.byref(out), dptr, 4), "cuMemcpyDtoH")
+
+print(f"kernel result: {out.value}")
+if out.value != 42:
+    print("FAIL: unexpected result")
+    sys.exit(1)
+print("PASS: ZLUDA executed a CUDA kernel on the GPU")
