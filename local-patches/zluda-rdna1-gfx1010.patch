index 0000000000000000000000000000000000000000..86f45a436ff2512f06fc18d1131affc27a259512
--- /dev/null
+++ b/bench/conv.py
@@ -0,0 +1,187 @@
+"""Winograd / MIOpen convolution audit on gfx1010.
+
+The roadmap asks whether MIOpen's Winograd solvers are available and faster
+than implicit GEMM for 3x3 stride-1/dilation-1 convolutions (SD/ResNet shapes).
+ZLUDA maps cuDNN calls to MIOpen (`zluda_dnn`), so PyTorch conv2d exercises the
+MIOpen solver selection. This script measures forward/backward for a shape
+matrix, compares NCHW vs channels_last and fp16 vs fp32, checks correctness
+against a CPU reference on a small shape, and can capture the MIOpen solver
+choice by re-running one convolution with MIOPEN_LOG_LEVEL set.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\conv.py --quick
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\conv.py
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\conv.py --solver-probe
+"""
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from common import bench_median, save_report
+
+DEV = "cuda"
+
+
+def make(shape, dtype, channels_last, requires_grad=False):
+    b, c, h, w, o, k = shape
+    x = torch.randn(b, c, h, w, device=DEV, dtype=dtype, requires_grad=requires_grad)
+    weight = torch.randn(o, c, k, k, device=DEV, dtype=dtype, requires_grad=requires_grad)
+    bias = torch.randn(o, device=DEV, dtype=dtype)
+    if channels_last:
+        x = x.to(memory_format=torch.channels_last)
+    return x, weight, bias
+
+
+def fwd_ms(shape, dtype, channels_last, benchmark):
+    x, weight, bias = make(shape, dtype, channels_last)
+    torch.backends.cudnn.benchmark = benchmark
+    b, c, h, w, o, k = shape
+    p = k // 2
+    run = lambda: F.conv2d(x, weight, bias, stride=1, padding=p)
+    run()
+    torch.cuda.synchronize()
+    return bench_median(run, rounds=3, iters=3)
+
+
+def fwd_bwd_ms(shape, dtype, channels_last):
+    x, weight, bias = make(shape, dtype, channels_last, requires_grad=True)
+    b, c, h, w, o, k = shape
+    p = k // 2
+
+    def run():
+        y = F.conv2d(x, weight, bias, stride=1, padding=p)
+        loss = y.float().mean()
+        loss.backward()
+        x.grad = weight.grad = None
+
+    run()
+    torch.cuda.synchronize()
+    return bench_median(run, rounds=3, iters=2)
+
+
+def correctness():
+    torch.manual_seed(0)
+    x = torch.randn(1, 16, 32, 32, dtype=torch.float32)
+    w = torch.randn(32, 16, 3, 3, dtype=torch.float32)
+    b = torch.randn(32, dtype=torch.float32)
+    ref = F.conv2d(x, w, b, stride=1, padding=1)
+    out = F.conv2d(x.cuda(), w.cuda(), b.cuda(), stride=1, padding=1).float().cpu()
+    err = (out - ref).abs().max().item()
+    rel = err / ref.abs().max().item()
+    print(f"correctness 3x3 fp32 vs CPU: max abs {err:.3e} (rel {rel:.3e})", flush=True)
+    return {"max_abs": err, "relative": rel}
+
+
+def run_matrix(shapes, dtypes, layouts):
+    rows = []
+    for shape in shapes:
+        for dtype in dtypes:
+            for channels_last in layouts:
+                row = {"shape": shape, "dtype": str(dtype).split(".")[-1],
+                       "channels_last": channels_last}
+                try:
+                    row["fwd_ms"] = fwd_ms(shape, dtype, channels_last, False)
+                except Exception as exc:
+                    row["fwd_error"] = f"{type(exc).__name__}: {str(exc)[:120]}"
+                    rows.append(row)
+                    print(f"{shape} {row['dtype']} cl={channels_last}: FAIL {row['fwd_error']}",
+                          flush=True)
+                    continue
+                try:
+                    row["fwd_bwd_ms"] = fwd_bwd_ms(shape, dtype, channels_last)
+                except Exception as exc:
+                    row["fwd_bwd_error"] = f"{type(exc).__name__}: {str(exc)[:120]}"
+                try:
+                    row["fwd_benchmark_ms"] = fwd_ms(shape, dtype, channels_last, True)
+                except Exception as exc:
+                    row["fwd_benchmark_error"] = f"{type(exc).__name__}: {str(exc)[:120]}"
+                torch.backends.cudnn.benchmark = False
+                b, c, h, w, o, k = shape
+                flops = 2.0 * b * o * h * w * c * k * k
+                row["fwd_tflops"] = flops / (row["fwd_ms"] / 1000.0) / 1e12
+                rows.append(row)
+                parts = [f"{shape} {row['dtype']:8s} cl={int(channels_last)}: "
+                         f"fwd {row['fwd_ms']:7.2f} ms"]
+                if "fwd_bwd_ms" in row:
+                    parts.append(f"fwd+bwd {row['fwd_bwd_ms']:7.2f} ms")
+                if "fwd_benchmark_ms" in row:
+                    parts.append(f"benchmark {row['fwd_benchmark_ms']:7.2f} ms")
+                print(" ".join(parts), flush=True)
+    return rows
+
+
+def solver_probe(shape=(1, 64, 56, 56, 64, 3), dtype=torch.float16):
+    """Re-run one conv in a child process with MIOpen logging and grep solvers."""
+    script = (
+        "import torch, torch.nn.functional as F\n"
+        f"b,c,h,w,o,k = {shape}\n"
+        "x = torch.randn(b,c,h,w,device='cuda',dtype=torch." + str(dtype).split('.')[-1] + ")\n"
+        "w_ = torch.randn(o,c,k,k,device='cuda',dtype=x.dtype)\n"
+        "y = F.conv2d(x,w_,padding=k//2)\n"
+        "torch.cuda.synchronize()\n"
+        "print('conv done', tuple(y.shape), flush=True)\n"
+    )
+    env = dict(os.environ)
+    env["MIOPEN_ENABLE_LOGGING"] = "1"
+    env["MIOPEN_LOG_LEVEL"] = os.environ.get("MIOPEN_LOG_LEVEL", "6")
+    print(f"solver probe: MIOPEN_LOG_LEVEL={env['MIOPEN_LOG_LEVEL']}", flush=True)
+    proc = subprocess.run(
+        [sys.executable, "-c", script], env=env, capture_output=True, text=True,
+        timeout=900,
+    )
+    text = (proc.stdout or "") + (proc.stderr or "")
+    interesting = [
+        line.strip() for line in text.splitlines()
+        if re.search(r"winograd|implicit|igemm|GemmFwd|FindSolution|FindConvolution|fdb|solver",
+                     line, re.IGNORECASE)
+    ]
+    tail = interesting[-40:]
+    print(f"probe exit {proc.returncode}, {len(interesting)} solver-related lines", flush=True)
+    for line in tail:
+        print("  " + line[:220], flush=True)
+    return {"exit": proc.returncode, "lines": len(interesting), "tail": tail}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--quick", action="store_true")
+    parser.add_argument("--solver-probe", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+    if not torch.cuda.is_available():
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    torch.backends.cudnn.benchmark = False
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+    print(f"cudnn {torch.backends.cudnn.version()}, channels_last supported: "
+          f"{torch.backends.cudnn.is_available()}", flush=True)
+
+    corr = correctness()
+    shapes = [
+        (1, 64, 56, 56, 64, 3),
+        (8, 64, 56, 56, 64, 3),
+        (1, 128, 28, 28, 128, 3),
+        (8, 256, 14, 14, 256, 3),
+        (1, 320, 32, 32, 320, 3),
+        (2, 256, 64, 64, 256, 3),
+        (1, 320, 64, 64, 320, 3),
+    ]
+    if args.quick:
+        shapes = shapes[:3]
+    rows = run_matrix(shapes, (torch.float16, torch.float32), (False, True))
+    probe = solver_probe() if args.solver_probe else None
+    save_report("conv", {"correctness": corr, "rows": rows, "solver_probe": probe})
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/conv_fp16.py b/bench/conv_fp16.py
new file mode 100644
index 0000000000000000000000000000000000000000..da17e325af29213751f39922122e11088acfa665
--- /dev/null
+++ b/bench/conv_fp16.py
@@ -0,0 +1,171 @@
+"""Cast-to-fp32 convolution workaround for gfx1010 (Winograd).
+
+MIOpen picks a fp32 Winograd solver (`ConvBinWinogradRxSf2x3g1`) for 3x3
+convolutions, but fp16 falls back to `GemmFwdRest` (a rocBLAS GEMM). Casting
+fp16 inputs/weights to fp32, running the fp32 Winograd conv and casting the
+result back (`zluda_ops.conv.conv2d`) is faster and at least as accurate.
+
+Timing uses a warmed GPU and shuffled interleaved rounds (the clocks cannot be
+fixed on this card, so a naive sequential loop overestimates later variants).
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\conv_fp16.py --quick
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\conv_fp16.py
+"""
+
+import argparse
+import random
+import sys
+import time
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from zluda_ops import conv as zconv
+from bench.common import save_report
+
+
+def timed_shuffled(fns, warm_seconds=1.5, rounds=5, iters=8):
+    t0 = time.perf_counter()
+    while time.perf_counter() - t0 < warm_seconds:
+        for fn in fns.values():
+            fn()
+        torch.cuda.synchronize()
+    rng = random.Random(7)
+    samples = {name: [] for name in fns}
+    for _ in range(rounds):
+        order = list(fns)
+        rng.shuffle(order)
+        for name in order:
+            fn = fns[name]
+            for _ in range(2):
+                fn()
+            torch.cuda.synchronize()
+            t = time.perf_counter()
+            for _ in range(iters):
+                fn()
+            torch.cuda.synchronize()
+            samples[name].append((time.perf_counter() - t) / iters * 1000)
+    return {name: sorted(v)[len(v) // 2] for name, v in samples.items()}
+
+
+def compare_shape(shape, device="cuda"):
+    b, c, h, w, o, k = shape
+    torch.manual_seed(0)
+    x16 = torch.randn(b, c, h, w, device=device, dtype=torch.float16)
+    w16 = torch.randn(o, c, k, k, device=device, dtype=torch.float16)
+    b16 = torch.randn(o, device=device, dtype=torch.float16)
+    ref32 = F.conv2d(x16.float(), w16.float(), b16.float(), padding=k // 2)
+    out = zconv.conv2d(x16, w16, b16, padding=k // 2)
+    fwd_err = (out.float() - ref32).abs().max().item()
+
+    # gradient correctness against the fp32 reference
+    xg = x16.clone().requires_grad_(True)
+    wg = w16.clone().requires_grad_(True)
+    bg = b16.clone().requires_grad_(True)
+    zconv.conv2d(xg, wg, bg, padding=k // 2).float().mean().backward()
+    xr = x16.float().clone().requires_grad_(True)
+    wr = w16.float().clone().requires_grad_(True)
+    br = b16.float().clone().requires_grad_(True)
+    F.conv2d(xr, wr, br, padding=k // 2).mean().backward()
+    grad_err = max(
+        (xg.grad.float() - xr.grad).abs().max().item(),
+        (wg.grad.float() - wr.grad).abs().max().item(),
+        (bg.grad.float() - br.grad).abs().max().item(),
+    )
+
+    fwd_ms = timed_shuffled({
+        "fp16": lambda: F.conv2d(x16, w16, b16, padding=k // 2),
+        "cast": lambda: zconv.conv2d(x16, w16, b16, padding=k // 2),
+    })
+
+    # training path: fp16 params vs fp32 master weights (cast each step)
+    xg16 = x16.clone().requires_grad_(True)
+    w32u = w16.detach().float().requires_grad_(True)
+    b32u = b16.detach().float().requires_grad_(True)
+
+    def fb_fp16():
+        y = F.conv2d(xg16, w16, b16, padding=k // 2)
+        y.float().mean().backward()
+        xg16.grad = None
+
+    def fb_cast():
+        y = F.conv2d(xg16.float(), w32u, b32u, padding=k // 2).half()
+        y.float().mean().backward()
+        xg16.grad = w32u.grad = b32u.grad = None
+
+    fb_ms = timed_shuffled({"fp16": fb_fp16, "cast": fb_cast}, rounds=4, iters=5)
+    print(f"{shape}: fwd fp16 {fwd_ms['fp16']:.3f} vs cast {fwd_ms['cast']:.3f} ms "
+          f"({fwd_ms['fp16'] / fwd_ms['cast']:.2f}x) | fwd+bwd fp16 {fb_ms['fp16']:.3f} "
+          f"vs cast {fb_ms['cast']:.3f} ms ({fb_ms['fp16'] / fb_ms['cast']:.2f}x) | "
+          f"err vs fp32 {fwd_err:.4f}, grad err {grad_err:.2e}", flush=True)
+    return {
+        "shape": shape,
+        "fwd_fp16_ms": fwd_ms["fp16"], "fwd_cast_ms": fwd_ms["cast"],
+        "fwd_speedup": fwd_ms["fp16"] / fwd_ms["cast"],
+        "fwd_bwd_fp16_ms": fb_ms["fp16"], "fwd_bwd_cast_ms": fb_ms["cast"],
+        "fwd_bwd_speedup": fb_ms["fp16"] / fb_ms["cast"],
+        "fwd_err_vs_fp32": fwd_err, "grad_err": grad_err,
+    }
+
+
+def unet_block(batch, ch, hw, device="cuda"):
+    torch.manual_seed(0)
+    x = torch.randn(batch, ch, hw, hw, device=device, dtype=torch.float16)
+    conv_w = torch.randn(ch, ch, 3, 3, device=device, dtype=torch.float16)
+    conv_b = torch.randn(ch, device=device, dtype=torch.float16)
+    gn_w = torch.ones(ch, device=device, dtype=torch.float16)
+    gn_b = torch.zeros(ch, device=device, dtype=torch.float16)
+
+    def run_fp16():
+        h = F.silu(F.group_norm(x, 32, gn_w, gn_b))
+        return F.conv2d(h, conv_w, conv_b, padding=1) + x
+
+    def run_cast():
+        h = F.silu(F.group_norm(x, 32, gn_w, gn_b))
+        return zconv.conv2d(h, conv_w, conv_b, padding=1) + x
+
+    ms = timed_shuffled({"fp16": run_fp16, "cast": run_cast})
+    diff = (run_fp16().float() - run_cast().float()).abs().max().item()
+    print(f"unet block {batch}x{ch}x{hw}x{hw}: fp16 {ms['fp16']:.3f} vs "
+          f"cast {ms['cast']:.3f} ms ({ms['fp16'] / ms['cast']:.2f}x), diff {diff:.5f}",
+          flush=True)
+    return {"batch": batch, "ch": ch, "hw": hw, "fp16_ms": ms["fp16"],
+            "cast_ms": ms["cast"], "speedup": ms["fp16"] / ms["cast"],
+            "diff": diff}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--quick", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+    if not torch.cuda.is_available():
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+
+    shapes = [
+        (1, 64, 56, 56, 64, 3),
+        (8, 64, 56, 56, 64, 3),
+        (8, 256, 14, 14, 256, 3),
+        (2, 256, 64, 64, 256, 3),
+        (1, 320, 64, 64, 320, 3),
+    ]
+    if args.quick:
+        shapes = shapes[:2]
+    rows = [compare_shape(s) for s in shapes]
+    blocks = [unet_block(1, 256, 32)]
+    if not args.quick:
+        blocks.append(unet_block(2, 320, 64))
+    save_report("conv_fp16", {"rows": rows, "blocks": blocks})
+    wins = sum(1 for r in rows if r["fwd_speedup"] > 1.0)
+    print(f"cast path faster on {wins}/{len(rows)} shapes (fwd)", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/fa_dropout.py b/bench/fa_dropout.py
new file mode 100644
index 0000000000000000000000000000000000000000..7a2f004f02d4adea05970c9273d764cf1adceaa6
--- /dev/null
+++ b/bench/fa_dropout.py
@@ -0,0 +1,170 @@
+"""Validate Triton flash-attention dropout.
+
+Dropout is inverted (kept weights scaled by 1/(1-p)); the row normalization uses
+the sum of the *original* probabilities, so E[out] equals the non-dropout
+output. This script checks:
+
+  * dropout_p=0 stays bit-compatible with the math fallback;
+  * for p=0.1/0.5 the sample mean over fresh seeds matches the non-dropout
+    output (inverted dropout is unbiased);
+  * forward/backward stay finite and gradient magnitudes are in the expected
+    range;
+  * timing at s=1024 against math SDPA.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\fa_dropout.py --s 256
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\fa_dropout.py --s 512 --bench
+"""
+
+import argparse
+import sys
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from torch.nn.attention import SDPBackend, sdpa_kernel
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from zluda_ops import scaled_dot_product_attention as triton_sdpa
+from bench.common import bench_median, save_report
+
+
+def math_sdpa(q, k, v, dropout_p=0.0, causal=False):
+    with sdpa_kernel(SDPBackend.MATH):
+        return F.scaled_dot_product_attention(
+            q, k, v, attn_mask=None, dropout_p=dropout_p, is_causal=causal
+        )
+
+
+def fallback_check(s=256, device="cuda"):
+    torch.manual_seed(0)
+    q = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16, requires_grad=True)
+    k = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16, requires_grad=True)
+    v = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16, requires_grad=True)
+    do = torch.randn_like(q)
+    out = triton_sdpa(q, k, v, dropout_p=0.0, is_causal=True)
+    ref = math_sdpa(q, k, v, 0.0, causal=True)
+    ferr = (out.float() - ref.float()).abs().max().item()
+    out.backward(do)
+    g1 = [t.grad.clone() for t in (q, k, v)]
+    for t in (q, k, v):
+        t.grad = None
+    ref.backward(do)
+    gerr = max((a - b.grad).abs().max().item() for a, b in zip(g1, (q, k, v)))
+    for t in (q, k, v):
+        t.grad = None
+    print(f"dropout=0 regression: fwd err {ferr:.5f} grad err {gerr:.5f}", flush=True)
+    return {"fwd_err": ferr, "grad_err": gerr}
+
+
+def unbiased_check(p, s=256, seeds=16, device="cuda"):
+    import zluda_ops.flash_attention as fa
+
+    torch.manual_seed(0)
+    q = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16)
+    k = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16)
+    v = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16)
+    base = triton_sdpa(q, k, v, dropout_p=0.0, is_causal=False).float()
+    diffs = []
+    for _ in range(seeds):
+        out = triton_sdpa(q, k, v, dropout_p=p, is_causal=False).float()
+        diffs.append(out - base)
+    diffs = torch.stack(diffs)
+    mean_diff = diffs.mean(0)
+    se = diffs.std(0) / seeds ** 0.5
+    # |mean diff| over many elements is ~0.8 * SE for an unbiased estimator.
+    z = (mean_diff.abs().mean() / se.mean()).item()
+    single_rel = diffs[0].abs().mean().item() / base.abs().mean().item()
+    qg = q.clone().requires_grad_(True)
+    out = triton_sdpa(qg, k, v, dropout_p=p, is_causal=False)
+    out.float().mean().backward()
+    finite = bool(torch.isfinite(qg.grad).all().item())
+    gnorm = qg.grad.abs().mean().item()
+    q_ref = q.clone().requires_grad_(True)
+    base_out = triton_sdpa(q_ref, k, v, dropout_p=0.0, is_causal=False).float().mean()
+    ref_gnorm = torch.autograd.grad(base_out, q_ref)[0].abs().mean().item()
+    print(
+        f"p={p}: unbiasedness z={z:.2f} (expect <3), single-sample dev {single_rel:.3f}; "
+        f"grad finite {finite} |g| {gnorm:.3e} (no-drop {ref_gnorm:.3e})",
+        flush=True,
+    )
+    return {
+        "p": p,
+        "unbiased_z": z,
+        "single_sample_rel_dev": single_rel,
+        "grad_finite": finite,
+        "grad_mean_abs": gnorm,
+        "grad_mean_abs_no_dropout": ref_gnorm,
+    }
+
+
+def determinism_check(s=128, p=0.5, device="cuda"):
+    import zluda_ops.flash_attention as fa
+
+    torch.manual_seed(1)
+    q = torch.randn(1, 2, s, 64, device=device, dtype=torch.float16)
+    k = torch.randn(1, 2, s, 64, device=device, dtype=torch.float16)
+    v = torch.randn(1, 2, s, 64, device=device, dtype=torch.float16)
+    fa._DROPOUT_SEED_OVERRIDE = 12345
+    try:
+        a = triton_sdpa(q, k, v, dropout_p=p, is_causal=True).clone()
+        b = triton_sdpa(q, k, v, dropout_p=p, is_causal=True).clone()
+        fa._DROPOUT_SEED_OVERRIDE = 999
+        c = triton_sdpa(q, k, v, dropout_p=p, is_causal=True).clone()
+    finally:
+        fa._DROPOUT_SEED_OVERRIDE = None
+    same = bool(torch.equal(a, b))
+    differs = not torch.equal(a, c)
+    print(f"determinism: same seed identical {same}, different seed differs {differs}", flush=True)
+    return {"same_seed_identical": same, "different_seed_differs": differs}
+
+
+def bench_case(s, p, causal, device="cuda"):
+    torch.manual_seed(0)
+    q = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16)
+    k = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16)
+    v = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16)
+    triton_ms = bench_median(
+        lambda: triton_sdpa(q, k, v, dropout_p=p, is_causal=causal), rounds=3, iters=3
+    )
+    math_ms = bench_median(
+        lambda: math_sdpa(q, k, v, p, causal=causal), rounds=3, iters=3
+    )
+    print(
+        f"bench s={s} p={p} causal={int(causal)}: triton {triton_ms:.2f} ms "
+        f"math {math_ms:.2f} ms ({math_ms / triton_ms:.2f}x)",
+        flush=True,
+    )
+    return {"s": s, "p": p, "causal": causal, "triton_ms": triton_ms,
+            "math_ms": math_ms, "speedup": math_ms / triton_ms}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--s", type=int, default=256)
+    parser.add_argument("--bench", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+    if not torch.cuda.is_available():
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+
+    reg = fallback_check(args.s)
+    unbiased = [unbiased_check(0.1, args.s), unbiased_check(0.5, args.s)]
+    determ = determinism_check()
+    benches = [bench_case(1024, 0.1, True)] if args.bench else []
+    save_report("fa_dropout", {"regression": reg, "unbiased": unbiased,
+                               "determinism": determ, "benches": benches})
+
+    ok = reg["fwd_err"] < 2e-2 and reg["grad_err"] < 2e-2
+    for row in unbiased:
+        ok = ok and row["grad_finite"] and row["unbiased_z"] < 3.0
+    ok = ok and determ["same_seed_identical"] and determ["different_seed_differs"]
+    print(f"overall: {'OK' if ok else 'FAIL'}", flush=True)
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/fa_mask.py b/bench/fa_mask.py
new file mode 100644
index 0000000000000000000000000000000000000000..5c7a80406a8ac8371e490dda58daa5b2946ec189
--- /dev/null
+++ b/bench/fa_mask.py
@@ -0,0 +1,149 @@
+"""Validate Triton flash-attention masks against the math SDPA fallback.
+
+Cases: boolean 2D mask, additive 2D mask, 4D per-head mask, 3D per-batch mask,
+causal+mask, and (for the benchmark) masked attention at s=1024.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\fa_mask.py            # s=256 checks
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\fa_mask.py --s 512 --bench
+"""
+
+import argparse
+import math
+import sys
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from torch.nn.attention import SDPBackend, sdpa_kernel
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from zluda_ops import scaled_dot_product_attention as triton_sdpa
+from bench.common import bench_median, save_report
+
+
+def math_sdpa(q, k, v, attn_mask=None, causal=False):
+    with sdpa_kernel(SDPBackend.MATH):
+        return F.scaled_dot_product_attention(
+            q, k, v, attn_mask=attn_mask, dropout_p=0.0, is_causal=causal
+        )
+
+
+def make_mask(kind, batch, heads, sq, sk, device):
+    eye = torch.eye(sq, sk, device=device, dtype=torch.bool)
+    if kind == "bool2d":
+        return (torch.rand(sq, sk, device=device) > 0.25) | eye
+    if kind == "additive2d":
+        return torch.randn(sq, sk, device=device, dtype=torch.float32)
+    if kind == "bool4d":
+        return (torch.rand(batch, heads, sq, sk, device=device) > 0.25) | eye
+    if kind == "additive3d":
+        return torch.randn(batch, sq, sk, device=device, dtype=torch.float32)
+    raise ValueError(kind)
+
+
+def combined_mask(mask, s, device):
+    """math SDPA forbids attn_mask together with is_causal; merge them."""
+    causal_allowed = torch.tril(torch.ones(s, s, device=device, dtype=torch.bool))
+    if mask.dtype == torch.bool:
+        return (mask & causal_allowed.view(1, 1, s, s)).contiguous()
+    big_neg = torch.full((s, s), -1.0e9, device=device, dtype=mask.dtype)
+    bias = torch.where(causal_allowed, torch.zeros_like(big_neg), big_neg)
+    return mask + bias.view(1, 1, s, s)
+
+
+def check(kind, s=256, causal=False, device="cuda"):
+    torch.manual_seed(0)
+    b, h, d = 1, 8, 64
+    q = torch.randn(b, h, s, d, device=device, dtype=torch.float16, requires_grad=True)
+    k = torch.randn(b, h, s, d, device=device, dtype=torch.float16, requires_grad=True)
+    v = torch.randn(b, h, s, d, device=device, dtype=torch.float16, requires_grad=True)
+    do = torch.randn_like(q)
+    mask = make_mask(kind, b, h, s, s, device)
+
+    out = triton_sdpa(q, k, v, attn_mask=mask, is_causal=causal)
+    torch.cuda.synchronize()
+    ref = math_sdpa(
+        q, k, v, attn_mask=combined_mask(mask, s, device) if causal else mask,
+        causal=False,
+    )
+    ferr = (out.float() - ref.float()).abs().max().item()
+    out.backward(do, retain_graph=True)
+    gq, gk, gv = q.grad.clone(), k.grad.clone(), v.grad.clone()
+    q.grad = k.grad = v.grad = None
+    ref.backward(do)
+    gerr = max(
+        (gq - q.grad).abs().max().item(),
+        (gk - k.grad).abs().max().item(),
+        (gv - v.grad).abs().max().item(),
+    )
+    q.grad = k.grad = v.grad = None
+    print(
+        f"{kind:12s} s={s} causal={int(causal)}: fwd err {ferr:.5f} grad err {gerr:.5f}",
+        flush=True,
+    )
+    return {"kind": kind, "s": s, "causal": causal, "fwd_err": ferr, "grad_err": gerr}
+
+
+def bench_case(s, causal, device="cuda"):
+    b, h, d = 1, 8, 64
+    torch.manual_seed(0)
+    q = torch.randn(b, h, s, d, device=device, dtype=torch.float16)
+    k = torch.randn(b, h, s, d, device=device, dtype=torch.float16)
+    v = torch.randn(b, h, s, d, device=device, dtype=torch.float16)
+    mask = torch.rand(s, s, device=device) > 0.1
+    triton_ms = bench_median(
+        lambda: triton_sdpa(q, k, v, attn_mask=mask, is_causal=causal), rounds=3, iters=3
+    )
+    ref_mask = combined_mask(mask, s, q.device) if causal else mask
+    math_ms = bench_median(
+        lambda: math_sdpa(q, k, v, attn_mask=ref_mask, causal=False), rounds=3, iters=3
+    )
+    print(
+        f"bench s={s} causal={int(causal)}: triton {triton_ms:.2f} ms math {math_ms:.2f} ms "
+        f"speedup {math_ms / triton_ms:.2f}x",
+        flush=True,
+    )
+    return {
+        "s": s,
+        "causal": causal,
+        "triton_ms": triton_ms,
+        "math_ms": math_ms,
+        "speedup": math_ms / triton_ms,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--s", type=int, default=256)
+    parser.add_argument("--bench", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+
+    dtype_ok = torch.cuda.is_available()
+    if not dtype_ok:
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+
+    rows = [
+        check("bool2d", args.s),
+        check("additive2d", args.s),
+        check("bool4d", args.s),
+        check("additive3d", args.s),
+        check("bool2d", args.s, causal=True),
+        check("additive2d", args.s, causal=True),
+    ]
+    benches = []
+    if args.bench:
+        benches.append(bench_case(1024, True))
+        benches.append(bench_case(1024, False))
+    save_report("fa_mask", {"checks": rows, "benches": benches, "s": args.s})
+    worst = max(max(r["fwd_err"], r["grad_err"]) for r in rows)
+    print(f"worst error {worst:.5f}", flush=True)
+    return 0 if worst < 2e-2 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
