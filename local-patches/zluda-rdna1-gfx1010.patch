@@ -0,0 +1,35 @@
+import time
+
+import torch
+
+dev = "cuda"
+torch.manual_seed(0)
+
+
+def bench(fn, warmup=5, iters=20):
+    for _ in range(warmup):
+        fn()
+    torch.cuda.synchronize()
+    t0 = time.perf_counter()
+    for _ in range(iters):
+        fn()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - t0) / iters * 1000.0
+
+
+print("torch", torch.__version__)
+n = 512
+for dtype in (torch.float32, torch.float16):
+    a = torch.randn(n, n, device=dev, dtype=dtype)
+    b = torch.randn(n, n, device=dev, dtype=dtype)
+    c = a @ b
+    ref = (a.cpu().double() @ b.cpu().double()).to(dtype)
+    err = (c.cpu().double() - ref.double()).abs().max().item()
+    print(f"correctness {str(dtype):15s}: max err {err:.5f}")
+
+for dtype in (torch.float32, torch.float16, torch.bfloat16):
+    for n in (1024, 2048, 4096):
+        a = torch.randn(n, n, device=dev, dtype=dtype)
+        b = torch.randn(n, n, device=dev, dtype=dtype)
+        ms = bench(lambda: a @ b)
+        print(f"matmul {str(dtype).split('.')[-1]:9s} n={n:5d}: {ms:9.2f} ms  {2*n**3/(ms/1000)/1e12:7.2f} TFLOPS")
diff --git a/bench/monitor.py b/bench/monitor.py
new file mode 100644
index 0000000000000000000000000000000000000000..d7c364411cf8891cfa618e0975597d036d0dbff8
--- /dev/null
+++ b/bench/monitor.py
@@ -0,0 +1,75 @@
+import argparse
+import json
+import subprocess
+import time
+
+import torch
+
+from common import nvml_sample, save_report
+
+GPU_COUNTER = (
+    "(Get-Counter '\\GPU Engine(*)\\Utilization Percentage' -ErrorAction SilentlyContinue)"
+    ".CounterSamples | Measure-Object CookedValue -Sum | Select-Object -ExpandProperty Sum"
+)
+
+
+def utilization():
+    try:
+        proc = subprocess.run(
+            ["powershell", "-NoProfile", "-Command", GPU_COUNTER],
+            capture_output=True, text=True, timeout=5,
+        )
+        value = proc.stdout.strip().replace(",", ".")
+        if value:
+            return max(0.0, min(100.0, float(value)))
+    except Exception:
+        pass
+    try:
+        return float(torch.cuda.utilization(0))
+    except Exception:
+        return None
+
+
+def sample():
+    free, total = torch.cuda.mem_get_info()
+    return {
+        "time": time.time(),
+        "gpu_util_pct": utilization(),
+        "vram_free_mb": free / 1024**2,
+        "vram_total_mb": total / 1024**2,
+        "vram_used_mb": (total - free) / 1024**2,
+        "torch_allocated_mb": torch.cuda.memory_allocated() / 1024**2,
+        "torch_reserved_mb": torch.cuda.memory_reserved() / 1024**2,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--seconds", type=float, default=5.0)
+    parser.add_argument("--interval", type=float, default=1.0)
+    args = parser.parse_args()
+    if torch.cuda.is_available():
+        torch.cuda.init()
+    rows = []
+    end = time.time() + args.seconds
+    while time.time() < end:
+        rows.append(sample())
+        time.sleep(args.interval)
+    usable = [r["gpu_util_pct"] for r in rows if r["gpu_util_pct"] is not None]
+    report = {
+        "samples": rows,
+        "gpu_util_avg_pct": sum(usable) / len(usable) if usable else None,
+        "gpu_util_max_pct": max(usable) if usable else None,
+        "clock_power": nvml_sample(),
+        "limitations": [
+            "gfx1010 Windows has no rocm-smi/amd-smi; ZLUDA NVML reports NotSupported",
+            "GPU utilization comes from Windows performance counters and includes other processes",
+            "sclk/mclk/temperature/power are unavailable",
+        ],
+    }
+    print(json.dumps(report, indent=2))
+    save_report("monitor", report)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/bench/regression.py b/bench/regression.py
new file mode 100644
index 0000000000000000000000000000000000000000..23d7a589bcba6d7f28e1fb3a64a98624e77c6688
--- /dev/null
+++ b/bench/regression.py
@@ -0,0 +1,162 @@
+import argparse
+import sys
+
+import torch
+import torch.nn.functional as F
+from torch.nn.attention import SDPBackend, sdpa_kernel
+
+from common import bench, save_report
+
+DEV = "cuda"
+
+
+def max_abs(out, ref):
+    return (out.detach().cpu().double() - ref.double()).abs().max().item()
+
+
+def check(name, out, ref, atol, rtol):
+    err = max_abs(out, ref)
+    scale = ref.double().abs().max().item()
+    tol = atol + rtol * scale
+    return {"name": name, "max_abs": err, "tol": tol, "pass": err <= tol}
+
+
+def correctness(quick=False):
+    torch.manual_seed(0)
+    results = []
+    sizes = [256] if quick else [128, 256, 512]
+    for dtype, (atol, rtol) in {
+        torch.float32: (2e-3, 2e-3),
+        torch.float16: (5e-2, 2e-2),
+        torch.bfloat16: (2e-1, 5e-2),
+    }.items():
+        for n in sizes:
+            a = torch.randn(n, n, device=DEV, dtype=dtype)
+            b = torch.randn(n, n, device=DEV, dtype=dtype)
+            out = a @ b
+            ref = a.cpu().double() @ b.cpu().double()
+            results.append(check(f"matmul {str(dtype).split('.')[-1]} n={n}", out, ref, atol, rtol))
+
+    for dtype in (torch.float32, torch.float16, torch.bfloat16):
+        lin = torch.nn.Linear(512, 256).to(DEV, dtype=dtype)
+        x = torch.randn(64, 512, device=DEV, dtype=dtype)
+        out = lin(x)
+        ref = x.cpu().double() @ lin.weight.cpu().double().t() + lin.bias.cpu().double()
+        results.append(check(f"linear {str(dtype).split('.')[-1]}", out, ref, 0.1 if dtype != torch.float32 else 5e-3, 0.05 if dtype != torch.float32 else 5e-3))
+
+    for dtype in (torch.float32, torch.float16):
+        x = torch.randn(2, 3, 32, 32, device=DEV, dtype=dtype)
+        w = torch.randn(4, 3, 3, 3, device=DEV, dtype=dtype) * 0.1
+        b = torch.randn(4, device=DEV, dtype=dtype) * 0.1
+        out = F.conv2d(x, w, b, stride=1, padding=1)
+        ref = F.conv2d(x.cpu().double(), w.cpu().double(), b.cpu().double(), stride=1, padding=1)
+        results.append(check(f"conv2d {str(dtype).split('.')[-1]}", out, ref, 0.1 if dtype != torch.float32 else 2e-3, 0.05 if dtype != torch.float32 else 2e-3))
+
+    x = torch.randn(64, 1024, device=DEV, dtype=torch.float16)
+    out = torch.softmax(x, dim=-1)
+    ref = torch.softmax(x.cpu().double(), dim=-1)
+    results.append(check("softmax fp16", out, ref, 2e-2, 2e-2))
+
+    ln = torch.nn.LayerNorm(1024).half().cuda()
+    out = ln(x)
+    ref = F.layer_norm(x.cpu().double(), (1024,), ln.weight.cpu().double(), ln.bias.cpu().double())
+    results.append(check("layernorm fp16", out, ref, 5e-2, 2e-2))
+
+    for causal in (False, True):
+        q = torch.randn(1, 4, 128, 64, device=DEV, dtype=torch.float16)
+        k = torch.randn_like(q)
+        v = torch.randn_like(q)
+        with sdpa_kernel(SDPBackend.MATH):
+            out = F.scaled_dot_product_attention(q, k, v, is_causal=causal)
+        qd, kd, vd = q.cpu().double(), k.cpu().double(), v.cpu().double()
+        scores = qd @ kd.transpose(-2, -1) * (64 ** -0.5)
+        if causal:
+            mask = torch.triu(torch.ones(128, 128, dtype=torch.bool), diagonal=1)
+            scores = scores.masked_fill(mask, float("-inf"))
+        ref = torch.softmax(scores, dim=-1) @ vd
+        results.append(check(f"sdpa math fp16 causal={causal}", out, ref, 5e-2, 2e-2))
+    return results
+
+
+def performance(quick=False):
+    torch.manual_seed(0)
+    perf = {"gemm": [], "linear": [], "gemv": [], "sdpa": []}
+    sizes = [512, 1024] if quick else [512, 1024, 2048, 4096]
+    iters = 5 if quick else 8
+    for dtype in (torch.float32, torch.float16, torch.bfloat16):
+        for n in sizes:
+            a = torch.randn(n, n, device=DEV, dtype=dtype)
+            b = torch.randn(n, n, device=DEV, dtype=dtype)
+            ms = bench(lambda: a @ b, warmup=2, iters=iters)
+            tflops = 2 * n**3 / (ms / 1000.0) / 1e12
+            perf["gemm"].append({"dtype": str(dtype).split(".")[-1], "n": n, "ms": ms, "tflops": tflops})
+
+    n = 4096
+    for dtype in (torch.float32, torch.float16):
+        w = torch.randn(n, n, device=DEV, dtype=dtype) * 0.02
+        b = torch.randn(n, device=DEV, dtype=dtype) * 0.02
+        for m in (1, 4, 16, 64):
+            try:
+                x = torch.randn(m, n, device=DEV, dtype=dtype)
+                ms = bench(lambda: F.linear(x, w, b), warmup=3, iters=10)
+                traffic = n * n * x.element_size() + m * n * x.element_size() * 2
+                perf["linear"].append({"dtype": str(dtype).split(".")[-1], "m": m, "n": n, "k": n, "ms": ms, "gbs": traffic / (ms / 1000.0) / 1e9})
+            except Exception as exc:
+                perf["linear"].append({"dtype": str(dtype).split(".")[-1], "m": m, "error": f"{type(exc).__name__}: {str(exc)[:160]}"})
+        try:
+            x = torch.randn(n, device=DEV, dtype=dtype)
+            ms = bench(lambda: torch.mv(w, x), warmup=3, iters=10)
+            traffic = n * n * x.element_size() + n * x.element_size() * 2
+            perf["gemv"].append({"dtype": str(dtype).split(".")[-1], "n": n, "ms": ms, "gbs": traffic / (ms / 1000.0) / 1e9})
+        except Exception as exc:
+            perf["gemv"].append({"dtype": str(dtype).split(".")[-1], "n": n, "error": f"{type(exc).__name__}: {str(exc)[:160]}"})
+
+    for s in (512, 1024, 2048):
+        q = torch.randn(1, 8, s, 64, device=DEV, dtype=torch.float16)
+        k = torch.randn_like(q)
+        v = torch.randn_like(q)
+        with sdpa_kernel(SDPBackend.MATH):
+            ms = bench(lambda: F.scaled_dot_product_attention(q, k, v, is_causal=True), warmup=2, iters=5)
+        tflops = 4 * 8 * s * s * 64 / (ms / 1000.0) / 1e12
+        perf["sdpa"].append({"s": s, "ms": ms, "tflops": tflops})
+    return perf
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--quick", action="store_true")
+    parser.add_argument("--no-strict", action="store_true")
+    args = parser.parse_args()
+    torch.manual_seed(0)
+    checks = correctness(args.quick)
+    print("== correctness ==")
+    for c in checks:
+        status = "PASS" if c["pass"] else "FAIL"
+        print(f"{status} {c['name']:36s} max_abs={c['max_abs']:.5g} tol={c['tol']:.5g}")
+    perf = performance(args.quick)
+    print("== gemm ==")
+    for r in perf["gemm"]:
+        print(f"{r['dtype']:9s} n={r['n']:5d}: {r['ms']:9.2f} ms  {r['tflops']:7.2f} TF")
+    print("== linear (N=K=4096) ==")
+    for r in perf["linear"]:
+        print(f"{r['dtype']:9s} m={r['m']:3d}: {r['ms']:8.3f} ms  {r['gbs']:7.1f} GB/s")
+    print("== gemv (N=K=4096) ==")
+    for r in perf["gemv"]:
+        if "error" in r:
+            print(f"{r['dtype']:9s}: FAIL {r['error']}")
+        else:
+            print(f"{r['dtype']:9s}: {r['ms']:8.3f} ms  {r['gbs']:7.1f} GB/s")
+    print("== sdpa math causal ==")
+    for r in perf["sdpa"]:
+        print(f"s={r['s']:5d}: {r['ms']:8.3f} ms  {r['tflops']:7.2f} TF")
+    failed = [c for c in checks if not c["pass"]]
+    report = {"correctness": checks, "performance": perf, "summary": {"passed": len(checks) - len(failed), "failed": len(failed)}}
+    save_report("regression", report)
+    if failed and not args.no_strict:
+        print(f"{len(failed)} correctness checks failed")
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
+
diff --git a/bench/rocblas_gap.py b/bench/rocblas_gap.py
new file mode 100644
index 0000000000000000000000000000000000000000..2b24ce00f5a7d21308426fe8efb89c226134b4e5
--- /dev/null
+++ b/bench/rocblas_gap.py
@@ -0,0 +1,237 @@
+"""Check whether the fp32 GEMM gap between PyTorch and direct rocBLAS is real.
+
+Older measurements disagreed: `bench/stage1.py` reports 8.16 TF for a 4096^2
+fp32 `torch.matmul`, while isolated ctypes scripts reported 9.2-9.6 TF for
+direct `rocblas_sgemm`/`rocblas_gemm_ex` calls. This script runs every variant
+in one process with a warmed GPU, shuffled rounds and median timing, and adds a
+zero-data control:
+
+  * all call paths (torch mm, torch mm with out=, direct rocBLAS on torch
+    buffers, direct rocBLAS on hipMalloc buffers) agree on random data;
+  * the same direct call on zeroed buffers is ~12% faster, which explains the
+    old 9.2-9.6 TF numbers: those scripts used uninitialised `hipMalloc`
+    buffers. Zero data draws less power, so the GPU holds higher clocks; it is
+    not a software gap and nothing in ZLUDA/torch can recover it.
+
+Conclusion: use random data and median timing everywhere; 8.16-8.20 TF is the
+representative fp32 4096^2 result on this card.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\rocblas_gap.py --n 2048
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\rocblas_gap.py --n 4096 --rounds 5
+  DISABLE_ADDMM_CUDA_LT=1 run-zluda.cmd venv\\Scripts\\python.exe bench\\rocblas_gap.py --n 4096
+
+The CUDA-Lt vs cuBLAS choice is a process-wide environment variable, so run
+the script twice with and without DISABLE_ADDMM_CUDA_LT=1.
+"""
+
+import argparse
+import ctypes
+import os
+import random
+import statistics
+import sys
+import time
+from pathlib import Path
+
+import torch
+
+from common import save_report
+
+REPO = Path(__file__).resolve().parents[1]
+
+ROCBLAS_OP_N = 111
+HIP_MEMCPY_D2D = 3
+
+
+def load_rocblas():
+    hip_path = os.environ.get("HIP_PATH")
+    if not hip_path:
+        hip_path = str(REPO / "hip")
+    hip_bin = Path(hip_path) / "bin"
+    if hasattr(os, "add_dll_directory"):
+        try:
+            os.add_dll_directory(str(hip_bin))
+        except OSError:
+            pass
+    hip = ctypes.CDLL(str(hip_bin / "amdhip64_7.dll"))
+    rb = ctypes.CDLL(str(hip_bin / "rocblas.dll"))
+
+    hip.hipInit.argtypes = [ctypes.c_uint]
+    hip.hipInit.restype = ctypes.c_int
+    hip.hipMalloc.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_size_t]
+    hip.hipMalloc.restype = ctypes.c_int
+    hip.hipFree.argtypes = [ctypes.c_void_p]
+    hip.hipFree.restype = ctypes.c_int
+    hip.hipMemcpy.argtypes = [
+        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int
+    ]
+    hip.hipMemcpy.restype = ctypes.c_int
+    hip.hipMemset.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_size_t]
+    hip.hipMemset.restype = ctypes.c_int
+    hip.hipDeviceSynchronize.argtypes = []
+    hip.hipDeviceSynchronize.restype = ctypes.c_int
+
+    rb.rocblas_create_handle.argtypes = [ctypes.POINTER(ctypes.c_void_p)]
+    rb.rocblas_create_handle.restype = ctypes.c_int
+    rb.rocblas_sgemm.argtypes = [
+        ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
+        ctypes.c_int, ctypes.c_int, ctypes.c_int,
+        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int,
+        ctypes.c_void_p, ctypes.c_int,
+        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int,
+    ]
+    rb.rocblas_sgemm.restype = ctypes.c_int
+    return hip, rb
+
+
+def make_sgemm(rb, handle, alpha, beta, a_ptr, b_ptr, c_ptr, n):
+    # Row-major C = A@B is computed by a column-major call with B and A
+    # swapped (square buffers).
+    def call():
+        return rb.rocblas_sgemm(
+            handle, ROCBLAS_OP_N, ROCBLAS_OP_N, n, n, n,
+            ctypes.byref(alpha), ctypes.c_void_p(b_ptr), n,
+            ctypes.c_void_p(a_ptr), n,
+            ctypes.byref(beta), ctypes.c_void_p(c_ptr), n,
+        )
+    return call
+
+
+def time_call(fn, warmup, iters):
+    for _ in range(warmup):
+        fn()
+    torch.cuda.synchronize()
+    start = time.perf_counter()
+    for _ in range(iters):
+        fn()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - start) / iters * 1000.0
+
+
+def tflops(n, ms):
+    return 2.0 * n ** 3 / (ms / 1000.0) / 1e12
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--n", type=int, default=2048)
+    parser.add_argument("--rounds", type=int, default=5)
+    parser.add_argument("--iters", type=int, default=5)
+    parser.add_argument("--warmup", type=int, default=2)
+    parser.add_argument("--vram-fraction", type=float, default=None,
+                        help="cap the PyTorch allocator (e.g. 0.8) for risky runs")
+    args = parser.parse_args()
+
+    if args.vram_fraction:
+        torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+        print(f"VRAM fraction {args.vram_fraction}", flush=True)
+
+    n = args.n
+    torch.manual_seed(0)
+    a = torch.randn(n, n, device="cuda", dtype=torch.float32)
+    b = torch.randn(n, n, device="cuda", dtype=torch.float32)
+    c = torch.empty(n, n, device="cuda", dtype=torch.float32)
+    torch.cuda.synchronize()
+
+    hip, rb = load_rocblas()
+    assert hip.hipInit(0) == 0
+    handle = ctypes.c_void_p()
+    assert rb.rocblas_create_handle(ctypes.byref(handle)) == 0
+    alpha = ctypes.c_float(1.0)
+    beta = ctypes.c_float(0.0)
+
+    # Hip-allocated buffers, initialised from the torch tensors (same content
+    # so compression does not skew the comparison).
+    hip_ptrs, hip_bufs = [], []
+    nbytes = n * n * 4
+    for src in (a, b, c):
+        ptr = ctypes.c_void_p()
+        assert hip.hipMalloc(ctypes.byref(ptr), nbytes) == 0
+        assert hip.hipMemcpy(ptr, ctypes.c_void_p(src.data_ptr()), nbytes,
+                             HIP_MEMCPY_D2D) == 0
+        hip_ptrs.append(ptr)
+        hip_bufs.append(ptr)
+    hip.hipDeviceSynchronize()
+
+    sgemm_torch = make_sgemm(rb, handle, alpha, beta,
+                             a.data_ptr(), b.data_ptr(), c.data_ptr(), n)
+    sgemm_hip = make_sgemm(rb, handle, alpha, beta,
+                           hip_ptrs[0].value, hip_ptrs[1].value,
+                           hip_ptrs[2].value, n)
+    assert sgemm_torch() == 0 and sgemm_hip() == 0
+    torch.cuda.synchronize()
+
+    # Zero-data control: same direct call, same allocations, zeroed content.
+    # This is what the old isolated scripts accidentally measured.
+    zero_ptrs = []
+    for _ in range(3):
+        ptr = ctypes.c_void_p()
+        assert hip.hipMalloc(ctypes.byref(ptr), nbytes) == 0
+        assert hip.hipMemset(ptr, 0, nbytes) == 0
+        zero_ptrs.append(ptr)
+    sgemm_hip_zeros = make_sgemm(rb, handle, alpha, beta,
+                                 zero_ptrs[0].value, zero_ptrs[1].value,
+                                 zero_ptrs[2].value, n)
+    assert sgemm_hip_zeros() == 0
+    torch.cuda.synchronize()
+
+    # Sanity: direct call on torch buffers must match torch.mm.
+    ref = a @ b
+    err = (c - ref).abs().max().item()
+    del ref
+    torch.cuda.synchronize()
+
+    variants = {
+        "torch_mm": lambda: torch.mm(a, b),
+        "torch_mm_out": lambda: torch.mm(a, b, out=c),
+        "sgemm_torch_buf": sgemm_torch,
+        "sgemm_hip_buf": sgemm_hip,
+        "sgemm_hip_zeros": sgemm_hip_zeros,
+    }
+
+    samples = {name: [] for name in variants}
+    order = list(variants)
+    rng = random.Random(1234)
+    for _ in range(args.rounds):
+        rng.shuffle(order)
+        for name in order:
+            samples[name].append(time_call(variants[name], args.warmup, args.iters))
+
+    rows = []
+    print(f"n={n} rounds={args.rounds} iters={args.iters} "
+          f"tf32={torch.backends.cuda.matmul.allow_tf32} "
+          f"precision={torch.get_float32_matmul_precision()} "
+          f"addmm_lt_disabled={os.environ.get('DISABLE_ADDMM_CUDA_LT')}", flush=True)
+    print(f"direct sgemm max abs error vs torch.mm: {err:.3e}", flush=True)
+    for name, values in samples.items():
+        med = statistics.median(values)
+        best = min(values)
+        rows.append({
+            "variant": name,
+            "median_ms": med,
+            "best_ms": best,
+            "median_tflops": tflops(n, med),
+            "best_tflops": tflops(n, best),
+            "samples_ms": values,
+        })
+        print(f"{name:16s} median {med:8.3f} ms {tflops(n, med):6.2f} TF | "
+              f"best {best:8.3f} ms {tflops(n, best):6.2f} TF", flush=True)
+
+    for ptr in hip_bufs + zero_ptrs:
+        hip.hipFree(ptr)
+    save_report("rocblas_gap", {
+        "n": n,
+        "rounds": args.rounds,
+        "iters": args.iters,
+        "direct_error": err,
+        "allow_tf32": torch.backends.cuda.matmul.allow_tf32,
+        "float32_matmul_precision": torch.get_float32_matmul_precision(),
+        "disable_addmm_cuda_lt": os.environ.get("DISABLE_ADDMM_CUDA_LT"),
+        "vram_fraction": args.vram_fraction,
+        "rows": rows,
+    })
+
+
+if __name__ == "__main__":
+    sys.exit(main())
