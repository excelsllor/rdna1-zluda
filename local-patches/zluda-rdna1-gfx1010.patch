+            except Exception as e:
+                print(f"sdpa {name:13s} s={s}: FAIL {type(e).__name__}: {str(e)[:150]}")
+except Exception as e:
+    print("sdpa: FAIL", type(e).__name__, str(e)[:200])
+
+try:
+    x = torch.randn(16 * 1024 * 1024, device=dev)
