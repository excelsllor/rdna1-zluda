diff --git a/tools/install_ecosystem.py b/tools/install_ecosystem.py
new file mode 100644
index 0000000000000000000000000000000000000000..08068aeb5b6dc4d2fb539345d4c2f7bd4e0ed2f1
--- /dev/null
+++ b/tools/install_ecosystem.py
@@ -0,0 +1,57 @@
+"""Install the ZLUDA ecosystem shims (flash_attn, xformers) into the venv.
+
+Adds a `.pth` file to site-packages that puts the repository root and
+`integrations/` on sys.path, so `import flash_attn` / `import xformers` resolve
+to the shims backed by the Triton kernels (no CUDA flash-attn/xformers build
+needed). Reversible: delete the generated `.pth` file.
+
+Usage:
+  venv\\Scripts\\python.exe tools\\install_ecosystem.py
+  venv\\Scripts\\python.exe tools\\install_ecosystem.py --uninstall
+"""
+
+import argparse
+import site
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+PTH_NAME = "zluda_ecosystem.pth"
+
+
+def target_dir():
+    candidates = [Path(p) for p in site.getsitepackages()]
+    for cand in candidates:
+        if cand.exists():
+            return cand
+    return Path(site.getusersitepackages())
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--uninstall", action="store_true")
+    args = parser.parse_args()
+    dest = target_dir() / PTH_NAME
+    if args.uninstall:
+        if dest.exists():
+            dest.unlink()
+            print(f"removed {dest}")
+        else:
+            print(f"{dest} does not exist")
+        return 0
+    lines = [
+        f"{REPO}",
+        f"{REPO / 'integrations'}",
+    ]
+    dest.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    print(f"wrote {dest}")
+    print("  paths:")
+    for line in lines:
+        print(f"    {line}")
+    print("verify: venv\\Scripts\\python.exe -c \"import flash_attn, xformers; "
+          "print(flash_attn.__version__, xformers.__version__)\"")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/install_hooks.ps1 b/tools/install_hooks.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..9fb3fe5ba2807c4dc92eb9038f1f8ed9e1f7ea34
--- /dev/null
+++ b/tools/install_hooks.ps1
@@ -0,0 +1,47 @@
+<#
+.SYNOPSIS
+    Install a local git hook that keeps the exported patch consistent.
+
+.DESCRIPTION
+    Adds a check to .git/hooks/pre-push that runs tools/check_patch.ps1, so a
+    stale or broken local-patches/zluda-rdna1-gfx1010.patch blocks the push
+    instead of reaching GitHub. Existing hook content (for example the git-lfs
+    pre-push hook) is preserved: the check is appended, not overwritten.
+    Re-run this script after cloning; hooks are not versioned.
+
+.EXAMPLE
+    tools/install_hooks.ps1
+#>
+
+$ErrorActionPreference = 'Stop'
+$repo = Split-Path -Parent $PSScriptRoot
+$hooksDir = Join-Path $repo '.git\hooks'
+if (-not (Test-Path -LiteralPath $hooksDir)) {
+    throw "'.git/hooks' not found; run this script inside the repository"
+}
+
+$hookPath = Join-Path $hooksDir 'pre-push'
+$marker = '# zluda: validate the exported RDNA1 patch'
+$block = @"
+
+$marker
+root=`$(git rev-parse --show-toplevel) || exit 1
+powershell.exe -NoProfile -ExecutionPolicy Bypass -File "`$root/tools/check_patch.ps1" || exit 1
+"@
+
+$existing = ''
+if (Test-Path -LiteralPath $hookPath) {
+    $existing = [System.IO.File]::ReadAllText($hookPath)
+    if ($existing.Contains($marker)) {
+        "already installed in $hookPath"
+        return
+    }
+}
+
+$content = if ($existing.Length -gt 0) {
+    $existing.TrimEnd([char[]]"`r`n") + $block
+} else {
