index 0000000000000000000000000000000000000000..a793bf1a34b95d6417bd9e74b6d109e286a1c6f0
--- /dev/null
+++ b/zluda_ops/fp16acc.py
@@ -0,0 +1,56 @@
+import warnings
+from contextlib import contextmanager
+
+import torch
+
+_ENABLED = False
+
+
+def available():
+    return hasattr(torch._C, "_get_cublas_allow_fp16_accumulation")
+
+
+def enabled():
+    if not available():
+        return False
+    return bool(torch._C._get_cublas_allow_fp16_accumulation())
+
+
+def describe():
+    return (
+        "fp16 accumulation makes cuBLAS/rocBLAS accumulate GEMM products in "
+        "fp16 instead of fp32. It enables packed FP16 kernels on gfx1010 "
+        "(roughly 2x inference GEMM throughput) but reduces numerical "
+        "accuracy. Use only for inference and validate your model."
+    )
+
+
+@contextmanager
+def fp16_accumulation(enable=True, warn=True):
+    if not available():
+        raise RuntimeError("torch._C fp16 accumulation control is unavailable")
+    previous = enabled()
+    if enable and warn:
+        warnings.warn(describe(), RuntimeWarning, stacklevel=2)
+    torch._C._set_cublas_allow_fp16_accumulation(bool(enable))
+    try:
+        yield
+    finally:
+        torch._C._set_cublas_allow_fp16_accumulation(previous)
+
+
+def set_fp16_accumulation(enable, allow_unsafe=False):
+    if enable and not allow_unsafe:
+        raise ValueError(
+            "fp16 accumulation is numerically unsafe; pass allow_unsafe=True "
+            "or use the fp16_accumulation() context manager"
+        )
+    if not available():
+        raise RuntimeError("torch._C fp16 accumulation control is unavailable")
+    torch._C._set_cublas_allow_fp16_accumulation(bool(enable))
+
+
+__all__ = [
+    "available", "enabled", "describe", "fp16_accumulation",
+    "set_fp16_accumulation",
+]
diff --git a/zluda_ops/gemv.py b/zluda_ops/gemv.py
new file mode 100644
index 0000000000000000000000000000000000000000..38dcde5db7c612e561976380b6f94108adbeeebf
--- /dev/null
+++ b/zluda_ops/gemv.py
@@ -0,0 +1,59 @@
+import torch
+import triton
+import triton.language as tl
+
+CONFIGS = {
+    1: (4096, 4),
+    2: (4096, 4),
+    4: (2048, 8),
+    8: (4096, 8),
+    16: (4096, 4),
+    32: (4096, 4),
+}
+
+
+@triton.jit
+def _gemv_kernel(w_ptr, x_ptr, b_ptr, y_ptr, N, K, M: tl.constexpr, BK: tl.constexpr,
+                 HAS_BIAS: tl.constexpr, PROD_F16: tl.constexpr):
+    row = tl.program_id(0)
+    mcols = tl.arange(0, M)
+    acc = tl.zeros((M,), tl.float32)
+    for k0 in range(0, K, BK):
+        offs = k0 + tl.arange(0, BK)
+        kmask = offs < K
+        w = tl.load(w_ptr + row * K + offs, mask=kmask, other=0.0)
+        x = tl.load(x_ptr + mcols[:, None] * K + offs[None, :], mask=kmask[None, :], other=0.0)
+        if PROD_F16:
+            acc += tl.sum(w[None, :] * x, axis=1).to(tl.float32)
+        else:
+            acc += tl.sum(w[None, :].to(tl.float32) * x.to(tl.float32), axis=1)
+    if HAS_BIAS:
+        acc += tl.load(b_ptr + row).to(tl.float32)
+    tl.store(y_ptr + mcols * N + row, acc.to(y_ptr.dtype.element_ty))
+
+
+def _supported(x, w, bias):
+    if not x.is_cuda or x.dim() != 2 or w.dim() != 2:
+        return False
+    if x.dtype not in (torch.float16, torch.float32) or w.dtype != x.dtype:
+        return False
+    if not x.is_contiguous() or not w.is_contiguous():
+        return False
+    if x.shape[0] not in CONFIGS or x.shape[1] != w.shape[1]:
+        return False
+    if bias is not None and (bias.dtype != x.dtype or not bias.is_contiguous()):
+        return False
+    return True
+
+
+def linear(x, w, bias=None, accurate=True):
+    if not _supported(x, w, bias):
+        return None
+    n, k = w.shape
+    m = x.shape[0]
+    bk, warps = CONFIGS[m]
+    y = torch.empty(m, n, device=x.device, dtype=x.dtype)
+    _gemv_kernel[(n,)](w, x, bias if bias is not None else y, y, n, k, M=m, BK=bk,
+                       HAS_BIAS=bias is not None, PROD_F16=not accurate,
+                       num_warps=warps, num_stages=1)
+    return y
