index 0000000000000000000000000000000000000000..185778479c142ca2935308e35300471a1a18fe86
--- /dev/null
+++ b/bench/fa_window.py
@@ -0,0 +1,156 @@
+"""Validate Triton sliding-window attention and varlen dispatch.
+
+The Triton kernel implements the sliding window arithmetically (no dense mask);
+the math reference uses an explicit keep-mask.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\fa_window.py --s 256
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\fa_window.py --s 512 --bench
+"""
+
+import argparse
+import sys
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from torch.nn.attention import SDPBackend, sdpa_kernel
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from zluda_ops import flash_attn_func, flash_attn_varlen_func
+from bench.common import bench_median, save_report
+
+
+def allowed_mask(sq, sk, causal, left, right, device):
+    qi = torch.arange(sq, device=device)[:, None]
+    ki = torch.arange(sk, device=device)[None, :]
+    di = qi - ki
+    allowed = torch.ones((sq, sk), dtype=torch.bool, device=device)
+    if causal:
+        allowed &= di >= 0
+    if left is not None:
+        allowed &= di <= left
+    if right is not None:
+        allowed &= di >= -right
+    return allowed
+
+
+def math_ref(q, k, v, allowed, dropout_p=0.0):
+    with sdpa_kernel(SDPBackend.MATH):
+        return F.scaled_dot_product_attention(
+            q, k, v, attn_mask=allowed, dropout_p=dropout_p, is_causal=False
+        )
+
+
+def check_window(s, causal, left, right, device="cuda"):
+    torch.manual_seed(0)
+    q = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16, requires_grad=True)
+    k = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16, requires_grad=True)
+    v = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16, requires_grad=True)
+    do = torch.randn_like(q)
+    out = flash_attn_func(q, k, v, causal=causal, window_size=(left, right))
+    torch.cuda.synchronize()
+    ref = math_ref(q, k, v, allowed_mask(s, s, causal, left, right, device))
+    ferr = (out.float() - ref.float()).abs().max().item()
+    out.backward(do)
+    g1 = [t.grad.clone() for t in (q, k, v)]
+    for t in (q, k, v):
+        t.grad = None
+    ref.backward(do)
+    gerr = max((a - b.grad).abs().max().item() for a, b in zip(g1, (q, k, v)))
+    for t in (q, k, v):
+        t.grad = None
+    print(
+        f"window causal={int(causal)} ({left},{right}) s={s}: "
+        f"fwd err {ferr:.5f} grad err {gerr:.5f}",
+        flush=True,
+    )
+    return {"s": s, "causal": causal, "left": left, "right": right,
+            "fwd_err": ferr, "grad_err": gerr}
+
+
+def check_varlen(device="cuda"):
+    torch.manual_seed(0)
+    lens = [128, 256, 384]
+    total = sum(lens)
+    h, d = 8, 64
+    q = torch.randn(total, h, d, device=device, dtype=torch.float16, requires_grad=True)
+    k = torch.randn(total, h, d, device=device, dtype=torch.float16, requires_grad=True)
+    v = torch.randn(total, h, d, device=device, dtype=torch.float16, requires_grad=True)
+    cu = torch.tensor([0] + list(torch.cumsum(torch.tensor(lens), 0).tolist()),
+                      device=device, dtype=torch.int32)
+    do = torch.randn_like(q)
+    left = 64
+    out = flash_attn_varlen_func(q, k, v, cu, cu, causal=True,
+                                 window_size=(left, 0), max_seqlen_q=max(lens),
+                                 max_seqlen_k=max(lens))
+    torch.cuda.synchronize()
+    refs = []
+    starts = [0] + torch.cumsum(torch.tensor(lens), 0).tolist()
+    for i, n in enumerate(lens):
+        a, b = int(starts[i]), int(starts[i + 1])
+        qi = q[a:b].transpose(0, 1).unsqueeze(0)
+        ki = k[a:b].transpose(0, 1).unsqueeze(0)
+        vi = v[a:b].transpose(0, 1).unsqueeze(0)
+        refs.append(math_ref(qi, ki, vi, allowed_mask(n, n, True, left, 0, device))[0])
+    ref = torch.cat([r.transpose(0, 1) for r in refs], dim=0)
+    ferr = (out.float() - ref.float()).abs().max().item()
+    out.backward(do)
+    g1 = [t.grad.clone() for t in (q, k, v)]
+    for t in (q, k, v):
+        t.grad = None
+    ref.backward(do)
+    gerr = max((a - b.grad).abs().max().item() for a, b in zip(g1, (q, k, v)))
+    print(f"varlen window ({left},0) lens={lens}: fwd err {ferr:.5f} grad err {gerr:.5f}",
+          flush=True)
+    return {"lens": lens, "fwd_err": ferr, "grad_err": gerr}
+
+
+def bench_case(s, left, causal=True, device="cuda"):
+    torch.manual_seed(0)
+    q = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16)
+    k = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16)
+    v = torch.randn(1, 8, s, 64, device=device, dtype=torch.float16)
+    triton_ms = bench_median(
+        lambda: flash_attn_func(q, k, v, causal=causal, window_size=(left, 0)),
+        rounds=3, iters=3,
+    )
+    mask = allowed_mask(s, s, causal, left, 0, device)
+    math_ms = bench_median(lambda: math_ref(q, k, v, mask), rounds=3, iters=3)
+    print(f"bench s={s} window=({left},0) causal={int(causal)}: triton {triton_ms:.2f} ms "
+          f"math(mask) {math_ms:.2f} ms ({math_ms / triton_ms:.2f}x)", flush=True)
+    return {"s": s, "left": left, "causal": causal, "triton_ms": triton_ms,
+            "math_ms": math_ms, "speedup": math_ms / triton_ms}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--s", type=int, default=256)
+    parser.add_argument("--bench", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+    if not torch.cuda.is_available():
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+
+    checks = [
+        check_window(args.s, True, 32, 0),
+        check_window(args.s, True, 64, 0),
+        check_window(args.s, False, 16, 16),
+        check_window(args.s, False, 64, 32),
+    ]
+    varlen = check_varlen()
+    benches = []
+    if args.bench:
+        benches.append(bench_case(1024, 128))
+        benches.append(bench_case(1024, 64, causal=False))
+    save_report("fa_window", {"checks": checks, "varlen": varlen, "benches": benches})
+    worst = max(max(r["fwd_err"], r["grad_err"]) for r in checks + [varlen])
+    print(f"worst error {worst:.5f}", flush=True)
+    return 0 if worst < 2e-2 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/flash_decode.py b/bench/flash_decode.py
new file mode 100644
index 0000000000000000000000000000000000000000..d61ce6468738b0407cf1a337319c09024274daad
--- /dev/null
+++ b/bench/flash_decode.py
@@ -0,0 +1,151 @@
+"""Validate and benchmark flash-decoding (split-KV) attention.
+
+Decode shapes: M=1..8 query tokens, KV length 1k..8k, B1 H8 D64 fp16.
+Reference: float32 scores/softmax (masked when causal; the M query tokens are
+the last M positions). Baseline: math SDPA (`SDPBackend.MATH`).
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\flash_decode.py --quick
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\flash_decode.py
+"""
+
+import argparse
+import math
+import sys
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from torch.nn.attention import SDPBackend, sdpa_kernel
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from zluda_ops.flash_decode import flash_decode_attn, _choose_splits
+from bench.common import bench_median, save_report
+
+
+def reference(q, k, v, causal):
+    b, h, m, d = q.shape
+    n = k.shape[2]
+    scale = 1.0 / math.sqrt(d)
+    scores = (q.float() @ k.float().transpose(-1, -2)) * scale
+    if causal:
+        qpos = torch.arange(n - m, n, device=q.device)[:, None]
+        kpos = torch.arange(n, device=q.device)[None, :]
+        scores = scores.masked_fill(qpos < kpos, float("-inf"))
+    p = torch.softmax(scores, dim=-1)
+    return p @ v.float()
+
+
+def math_sdpa(q, k, v, causal):
+    mask = None
+    if causal:
+        n, m = k.shape[2], q.shape[2]
+        qpos = torch.arange(n - m, n, device=q.device)[:, None]
+        kpos = torch.arange(n, device=q.device)[None, :]
+        mask = (qpos >= kpos)[None, None]
+    with sdpa_kernel(SDPBackend.MATH):
+        return F.scaled_dot_product_attention(
+            q, k, v, attn_mask=mask, dropout_p=0.0, is_causal=False
+        )
+
+
+def check(m, n, causal, device="cuda"):
+    torch.manual_seed(0)
+    b, h, d = 1, 8, 64
+    q = torch.randn(b, h, m, d, device=device, dtype=torch.float16)
+    k = torch.randn(b, h, n, d, device=device, dtype=torch.float16)
+    v = torch.randn(b, h, n, d, device=device, dtype=torch.float16)
+    out = flash_decode_attn(q, k, v, causal=causal)
+    torch.cuda.synchronize()
+    ref = reference(q, k, v, causal)
+    err = (out.float() - ref).abs().max().item()
+    rel = err / ref.abs().max().item()
+    splits = _choose_splits(n, b * h)
+    print(f"check m={m} n={n} causal={int(causal)}: max abs {err:.4f} "
+          f"(rel {rel:.2e}, splits {splits})", flush=True)
+    return {"m": m, "n": n, "causal": causal, "max_abs": err, "relative": rel,
+            "splits": splits}
+
+
+def bench(m, n, causal, device="cuda"):
+    torch.manual_seed(0)
+    b, h, d = 1, 8, 64
+    q = torch.randn(b, h, m, d, device=device, dtype=torch.float16)
+    k = torch.randn(b, h, n, d, device=device, dtype=torch.float16)
+    v = torch.randn(b, h, n, d, device=device, dtype=torch.float16)
+    fast_ms = bench_median(lambda: flash_decode_attn(q, k, v, causal=causal),
+                           rounds=3, iters=5)
+    math_ms = bench_median(lambda: math_sdpa(q, k, v, causal=causal),
+                           rounds=3, iters=5)
+    # bytes: read K and V once, write O
+    gb = (2 * h * n * d * 2) / 1e9
+    gbs = gb / (fast_ms / 1000.0)
+    print(f"bench m={m:2d} n={n:4d} causal={int(causal)}: flash-decoding "
+          f"{fast_ms:7.3f} ms ({gbs:6.1f} GB/s) vs math {math_ms:7.3f} ms "
+          f"= {math_ms / fast_ms:4.2f}x", flush=True)
+    return {"m": m, "n": n, "causal": causal, "fast_ms": fast_ms,
+            "math_ms": math_ms, "speedup": math_ms / fast_ms, "gbs": gbs}
+
+
+
+def auto_check(m=1, n=4096, device="cuda"):
+    """Verify that zluda_ops.auto routes decode SDPA through flash-decoding."""
+    import torch.nn.functional as F
+    import zluda_ops.auto as auto_mod
+    from zluda_ops import scaled_dot_product_attention
+
+    torch.manual_seed(0)
+    q = torch.randn(1, 8, m, 64, device=device, dtype=torch.float16)
+    k = torch.randn(1, 8, n, 64, device=device, dtype=torch.float16)
+    v = torch.randn(1, 8, n, 64, device=device, dtype=torch.float16)
+    ref = reference(q, k, v, False)
+    auto_mod.install()
+    try:
+        # no_grad: the auto patch only speeds up inference
+        with torch.no_grad():
+            out = F.scaled_dot_product_attention(q, k, v)
+            direct = flash_decode_attn(q, k, v, causal=False)
+        err = (out.float() - ref).abs().max().item()
+        same = torch.equal(out, direct)
+        math_ms = bench_median(lambda: math_sdpa(q, k, v, False), rounds=2, iters=3)
+        auto_ms = bench_median(
+            lambda: F.scaled_dot_product_attention(q, k, v), rounds=2, iters=3)
+    finally:
+        auto_mod.uninstall()
+    print(f"auto dispatch m={m} n={n}: err {err:.4f}, matches flash_decode {same}, "
+          f"{auto_ms:.3f} ms vs math {math_ms:.3f} ms = {math_ms / auto_ms:.2f}x",
+          flush=True)
+    return {"m": m, "n": n, "err": err, "matches_direct": same,
+            "auto_ms": auto_ms, "math_ms": math_ms, "speedup": math_ms / auto_ms}
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--quick", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+    if not torch.cuda.is_available():
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+
+    checks = [
+        check(1, 1024, False),
+        check(1, 1024, True),
+        check(8, 1024, True),
+    ]
+    benches = [bench(1, 1024, False), bench(1, 2048, False),
+               bench(1, 4096, False), bench(8, 4096, True)]
+    if not args.quick:
+        checks += [check(1, 4096, False), check(4, 4096, True)]
+        benches += [bench(8, 2048, False), bench(4, 4096, False)]
+    auto = auto_check() if not args.quick else None
+    save_report("flash_decode", {"checks": checks, "benches": benches, "auto": auto})
+    worst = max(c["relative"] for c in checks)
+    speed4096 = max(b["speedup"] for b in benches if b["n"] >= 4096)
+    print(f"worst relative error {worst:.2e}; best 4k speedup {speed4096:.2f}x", flush=True)
+    return 0 if worst < 1e-2 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/flash_pack.py b/bench/flash_pack.py
new file mode 100644
index 0000000000000000000000000000000000000000..954fcb0e46aba2f1654f6f3786f14fd5bd199221
--- /dev/null
+++ b/bench/flash_pack.py
@@ -0,0 +1,52 @@
+import sys, time, math
+from pathlib import Path
+import torch
+import torch.nn.functional as F
+from torch.nn.attention import SDPBackend, sdpa_kernel
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from zluda_ops import scaled_dot_product_attention, flash_attn_func, FlashAttention
+from bench.common import bench, save_report
+
+def math_sdpa(q,k,v,causal):
+    with sdpa_kernel(SDPBackend.MATH):
+        return F.scaled_dot_product_attention(q,k,v,is_causal=causal)
+
+def run_case(s=512, hq=8, hkv=8, d=64, causal=True, gqa=False):
+    torch.manual_seed(0)
+    q=torch.randn(1,hq,s,d,device="cuda",dtype=torch.float16,requires_grad=True)
+    k=torch.randn(1,hkv,s,d,device="cuda",dtype=torch.float16,requires_grad=True)
+    v=torch.randn(1,hkv,s,d,device="cuda",dtype=torch.float16,requires_grad=True)
+    do=torch.randn_like(q)
+    out=scaled_dot_product_attention(q,k,v,is_causal=causal)
+    torch.cuda.synchronize()
+    ke=k.repeat_interleave(hq//hkv,dim=1); ve=v.repeat_interleave(hq//hkv,dim=1)
+    ref=math_sdpa(q,ke,ve,causal)
+    ferr=(out.float()-ref.float()).abs().max().item()
+    out.backward(do, retain_graph=True)
+    gq=q.grad.clone(); gk=k.grad.clone(); gv=v.grad.clone()
+    q.grad=k.grad=v.grad=None
+    ref.backward(do)
+    gerr=max((gq-q.grad).abs().max().item(),(gk-k.grad).abs().max().item(),(gv-v.grad).abs().max().item())
+    q.grad=k.grad=v.grad=None
+    ms_f=bench(lambda: scaled_dot_product_attention(q,k,v,is_causal=causal), warmup=3, iters=10)
+    def fb():
+        o=scaled_dot_product_attention(q,k,v,is_causal=causal); o.backward(do); q.grad=k.grad=v.grad=None
+    ms_fb=bench(fb,warmup=2,iters=5)
+    ms_ref=bench(lambda: math_sdpa(q,ke,ve,causal),warmup=2,iters=5)
+    print(f"s={s} hq={hq} hkv={hkv} causal={causal}: fwd {ms_f:7.2f} ms ref {ms_ref:7.2f} | fwd+bwd {ms_fb:7.2f} | err {ferr:.4f} grad {gerr:.4f}")
+    return {"s":s,"hq":hq,"hkv":hkv,"causal":causal,"fwd_ms":ms_f,"ref_ms":ms_ref,"fwd_bwd_ms":ms_fb,"fwd_err":ferr,"grad_err":gerr}
+
+rows=[]
+rows.append(run_case(512,8,8,64,True,False))
+rows.append(run_case(1024,8,8,64,True,False))
+rows.append(run_case(512,8,8,64,False,False))
+rows.append(run_case(512,8,2,64,True,True))
+# fallback path
+torch.manual_seed(0)
+q=torch.randn(1,4,512,32,device="cuda",dtype=torch.float16)
+k=torch.randn_like(q); v=torch.randn_like(q)
+o=scaled_dot_product_attention(q,k,v,is_causal=True); r=math_sdpa(q,k,v,True)
+print("fallback d=32 err", (o.float()-r.float()).abs().max().item())
+m=FlashAttention(causal=True)
+o=m(q,k,v); print("module ok", o.shape)
+save_report("flash_pack", {"rows": rows})
