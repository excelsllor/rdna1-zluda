diff --git a/tools/check_patch.ps1 b/tools/check_patch.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..91d50efef6484670a55e3220d2d9fcd3dfe5cbbd
--- /dev/null
+++ b/tools/check_patch.ps1
@@ -0,0 +1,84 @@
+<#
+.SYNOPSIS
+    Validate local-patches/zluda-rdna1-gfx1010.patch.
+
+.DESCRIPTION
+    Checks that the exported patch:
+      1. is UTF-8 without BOM and uses LF line endings (required by git apply),
+      2. is up to date with the diff of HEAD against the upstream base,
+      3. applies cleanly to a pristine tree of the base revision.
+
+    Run this before committing changes to the patch or to the source tree that
+    the patch covers. Exit code is non-zero on any failure.
+
+.EXAMPLE
+    tools/check_patch.ps1
+#>
+param(
+    [string]$Base = 'v7-preview.21',
+    [string]$Patch = 'local-patches/zluda-rdna1-gfx1010.patch'
+)
+
+$ErrorActionPreference = 'Stop'
+$repo = Split-Path -Parent $PSScriptRoot
+$patchPath = Join-Path $repo $Patch
+
+if (-not (Test-Path -LiteralPath $patchPath)) {
+    throw "patch '$Patch' is missing"
+}
+
+git -C $repo rev-parse --verify "$Base^{commit}" *> $null
+if ($LASTEXITCODE -ne 0) {
+    throw "base revision '$Base' was not found; fetch tags/history first (git fetch --tags)"
+}
+
+# 1. Encoding and line endings.
+$bytes = [System.IO.File]::ReadAllBytes($patchPath)
+if ($bytes.Length -ge 2 -and $bytes[0] -eq 0xFF -and $bytes[1] -eq 0xFE) {
+    throw 'patch is UTF-16 LE; run tools/export_patch.ps1'
+}
+if ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) {
+    throw 'patch has a UTF-8 BOM; run tools/export_patch.ps1'
+}
+$text = [System.Text.Encoding]::UTF8.GetString($bytes)
+if ($text.Contains("`r")) {
+    throw 'patch contains CRLF line endings; run tools/export_patch.ps1'
+}
+
+$tmp = Join-Path ([System.IO.Path]::GetTempPath()) ('zluda-patch-check-' + [guid]::NewGuid().ToString('N'))
+New-Item -ItemType Directory -Path $tmp | Out-Null
+try {
+    # 2. Up to date with HEAD.
+    $generated = Join-Path $tmp 'generated.patch'
+    $exclude = ':(exclude)' + ($Patch -replace '\\', '/')
+    git -C $repo diff --binary --full-index "--output=$generated" "$Base..HEAD" -- . $exclude
+    if ($LASTEXITCODE -ne 0) {
+        throw 'git diff failed'
+    }
+    $patchHash = (Get-FileHash -LiteralPath $patchPath -Algorithm SHA256).Hash
+    $generatedHash = (Get-FileHash -LiteralPath $generated -Algorithm SHA256).Hash
+    if ($patchHash -ne $generatedHash) {
+        throw "patch is stale against $Base..HEAD; run tools/export_patch.ps1"
+    }
+
+    # 3. Applies to a pristine base tree.
+    # Use a zip archive + Expand-Archive instead of tar: inside Git Bash (where
+    # git hooks run) "tar" resolves to GNU tar, which misparses Windows drive
+    # letters as remote hosts.
+    $baseDir = Join-Path $tmp 'base'
+    New-Item -ItemType Directory -Path $baseDir | Out-Null
+    $baseZip = Join-Path $tmp 'base.zip'
+    git -C $repo archive --format=zip "--output=$baseZip" $Base
+    if ($LASTEXITCODE -ne 0) {
+        throw 'git archive failed'
+    }
+    Expand-Archive -LiteralPath $baseZip -DestinationPath $baseDir -Force
+    git -C $baseDir apply --check $generated
+    if ($LASTEXITCODE -ne 0) {
+        throw "patch does not apply cleanly to $Base"
+    }
+
+    "patch OK: UTF-8/LF, matches $Base..HEAD, applies cleanly to $Base"
+} finally {
+    Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue
+}
diff --git a/tools/export_patch.ps1 b/tools/export_patch.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..80d9276ba1f57dc1ff80f00c1be791e392add37b
--- /dev/null
+++ b/tools/export_patch.ps1
@@ -0,0 +1,47 @@
+<#
+.SYNOPSIS
+    Regenerate local-patches/zluda-rdna1-gfx1010.patch from the fork history.
+
+.DESCRIPTION
+    The patch is the diff of the current HEAD against the upstream base
+    (v7-preview.21 by default), excluding the patch file itself so that the
+    patch never contains itself.
+
+    Output is UTF-8 without BOM and LF line endings: git apply rejects UTF-16
+    patches and BOM/CRLF cause noisy failures for other users. Always use this
+    script (or tools/check_patch.ps1) instead of writing the patch by hand.
+
+.EXAMPLE
+    tools/export_patch.ps1
+    tools/export_patch.ps1 -Base v7-preview.21 -Output local-patches/test.patch
+#>
+param(
+    [string]$Base = 'v7-preview.21',
+    [string]$Output = 'local-patches/zluda-rdna1-gfx1010.patch'
+)
+
+$ErrorActionPreference = 'Stop'
+$repo = Split-Path -Parent $PSScriptRoot
+
+git -C $repo rev-parse --verify "$Base^{commit}" *> $null
+if ($LASTEXITCODE -ne 0) {
+    throw "base revision '$Base' was not found; fetch tags/history first (git fetch --tags)"
+}
+
+$outPath = Join-Path $repo $Output
+$outDir = Split-Path -Parent $outPath
+if (-not (Test-Path -LiteralPath $outDir)) {
+    New-Item -ItemType Directory -Path $outDir | Out-Null
+}
+
+$exclude = ':(exclude)' + ($Output -replace '\\', '/')
+git -C $repo diff --binary --full-index "--output=$outPath" "$Base..HEAD" -- . $exclude
+if ($LASTEXITCODE -ne 0) {
+    throw 'git diff failed'
+}
+
+$bytes = [System.IO.File]::ReadAllBytes($outPath)
+if ($bytes.Length -eq 0) {
+    throw 'the generated patch is empty'
+}
+"exported $Output ($($bytes.Length) bytes) from $Base..HEAD"
diff --git a/tools/gpu_watchdog.ps1 b/tools/gpu_watchdog.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..b71d08980d5efe7a95fd31ed62ee8ebae718e87b
--- /dev/null
+++ b/tools/gpu_watchdog.ps1
@@ -0,0 +1,125 @@
+param(
+    [Parameter(Mandatory = $true)][string]$Command,
+    [string]$LogPath = "G:\zluda\watchdog\watchdog-$(Get-Date -Format 'yyyyMMdd-HHmmss').log",
+    [string]$WatchLog = "",
+    [int]$PollSeconds = 30,
+    [int]$StallLimit = 2,
+    [int]$MaxMinutes = 30,
+    [string]$InstanceId = "PCI\VEN_1002&DEV_731F&SUBSYS_51011849&REV_C1\6&CF24139&0&00000009",
+    [switch]$AllowDriverRestart
+)
+
+# Watchdog for risky GPU workloads on the 8 GB RX 5700 XT under ZLUDA.
+#
+# Starts $Command through cmd.exe, polls every $PollSeconds and reports:
+#   * is the workload process still alive,
+#   * display device PnP status,
+#   * whether the workload log grew (StallLimit polls without growth = hang).
+# On a hang/crash it kills the workload tree. Driver restart is DISABLED by
+# default: restarting the active display adapter crashed Windows on 2026-11-25
+# (verified), so it is only attempted with -AllowDriverRestart from an elevated
+# shell - and that is still risky. Without it the watchdog only kills, which is
+# enough in most cases; a manual reboot is the fallback when the GPU is wedged.
+
+$ErrorActionPreference = "Continue"
+if (-not $WatchLog) {
+    $WatchLog = [System.IO.Path]::ChangeExtension($LogPath, ".watchdog.log")
+}
+New-Item -ItemType Directory -Force (Split-Path $LogPath) | Out-Null
+New-Item -ItemType Directory -Force (Split-Path $WatchLog) | Out-Null
+
+function Write-Watch([string]$msg) {
+    $line = "$(Get-Date -Format 'HH:mm:ss') $msg"
+    Add-Content -Path $WatchLog -Value $line -Encoding utf8
+    Write-Host $line
+}
+
+function Stop-Tree([int]$rootPid) {
+    $children = Get-CimInstance Win32_Process | Where-Object { $_.ParentProcessId -eq $rootPid }
+    foreach ($c in $children) { Stop-Tree $c.ProcessId }
+    try { Stop-Process -Id $rootPid -Force -ErrorAction Stop } catch { }
+}
+
+function Get-DeviceStatus {
+    try {
+        $d = Get-PnpDevice -Class Display -ErrorAction SilentlyContinue |
+            Where-Object { $_.InstanceId -eq $InstanceId } | Select-Object -First 1
+        if ($d) { return [string]$d.Status } else { return "NOT_FOUND" }
+    } catch {
+        return "QUERY_FAILED"
+    }
+}
+
+function Restart-Device {
+    if (-not $AllowDriverRestart) {
+        Write-Watch "driver restart disabled (default): killed only; reboot manually if the GPU stays wedged"
+        return $false
+    }
+    $identity = [System.Security.Principal.WindowsIdentity]::GetCurrent()
+    $principal = New-Object System.Security.Principal.WindowsPrincipal($identity)
+    if (-not $principal.IsInRole([System.Security.Principal.WindowsBuiltInRole]::Administrator)) {
+        Write-Watch "driver restart skipped: not elevated (restarting the display adapter can crash Windows)"
+        return $false
+    }
+    Write-Watch "attempting display-device restart ($InstanceId) - this can crash Windows"
+    try {
+        Restart-PnpDevice -InstanceId $InstanceId -Confirm:$false -ErrorAction Stop
+        Start-Sleep -Seconds 5
+        Write-Watch "display device restarted, status=$(Get-DeviceStatus)"
+        return $true
+    } catch {
+        Write-Watch "display-device restart failed: $($_.Exception.Message.Trim())"
+    }
+    return $false
+}
+
+Write-Watch "START command=$Command log=$LogPath poll=${PollSeconds}s stall=${StallLimit} max=${MaxMinutes}min restart_allowed=$([int]$AllowDriverRestart)"
+$proc = Start-Process -FilePath "cmd.exe" `
+    -ArgumentList '/c', "$Command > `"$LogPath`" 2>&1" `
+    -PassThru -WindowStyle Hidden
+Write-Watch "pid=$($proc.Id)"
+
+$start = Get-Date
+$lastSize = -1
+$stall = 0
+$reason = "completed"
+while ($true) {
+    Start-Sleep -Seconds $PollSeconds
+    $exited = $proc.HasExited
+    $logSize = if (Test-Path $LogPath) { (Get-Item $LogPath).Length } else { 0 }
+    $dev = Get-DeviceStatus
+    $grew = $logSize -gt $lastSize
+    if ($grew) { $stall = 0 } else { $stall++ }
+    $lastSize = $logSize
+    Write-Watch "poll pid=$($proc.Id) alive=$([int](-not $exited)) device=$dev logBytes=$logSize stall=$stall"
+
+    if ($exited) {
+        $reason = "completed(exit=$($proc.ExitCode))"
+        break
+    }
+    if ($dev -ne "OK") {
+        $reason = "device-status-$dev"
+        break
+    }
+    if ($stall -ge $StallLimit) {
+        $reason = "hang(log stalled for $($stall * $PollSeconds)s)"
+        break
+    }
+    if (((Get-Date) - $start).TotalMinutes -ge $MaxMinutes) {
+        $reason = "max-time(${MaxMinutes}min)"
+        break
+    }
+}
+
+if (-not $proc.HasExited) {
+    Write-Watch "killing workload tree (reason=$reason)"
+    Stop-Tree $proc.Id
+    Start-Sleep -Seconds 3
+    Write-Watch "after kill: alive=$([int](-not $proc.HasExited)) device=$(Get-DeviceStatus)"
+    Restart-Device | Out-Null
+} else {
+    Write-Watch "workload exited: $reason"
+}
+
+Write-Watch "END reason=$reason"
+exit 0
