@@ -0,0 +1,35 @@
+import time
+
+import torch
+
+dev = "cuda"
+torch.manual_seed(0)
+
+
+def bench(fn, warmup=5, iters=20):
+    for _ in range(warmup):
+        fn()
+    torch.cuda.synchronize()
+    t0 = time.perf_counter()
+    for _ in range(iters):
+        fn()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - t0) / iters * 1000.0
+
+
+print("torch", torch.__version__)
+n = 512
+for dtype in (torch.float32, torch.float16):
+    a = torch.randn(n, n, device=dev, dtype=dtype)
+    b = torch.randn(n, n, device=dev, dtype=dtype)
+    c = a @ b
+    ref = (a.cpu().double() @ b.cpu().double()).to(dtype)
+    err = (c.cpu().double() - ref.double()).abs().max().item()
+    print(f"correctness {str(dtype):15s}: max err {err:.5f}")
+
+for dtype in (torch.float32, torch.float16, torch.bfloat16):
+    for n in (1024, 2048, 4096):
+        a = torch.randn(n, n, device=dev, dtype=dtype)
+        b = torch.randn(n, n, device=dev, dtype=dtype)
+        ms = bench(lambda: a @ b)
+        print(f"matmul {str(dtype).split('.')[-1]:9s} n={n:5d}: {ms:9.2f} ms  {2*n**3/(ms/1000)/1e12:7.2f} TFLOPS")
diff --git a/bench/miopen_db.py b/bench/miopen_db.py
new file mode 100644
index 0000000000000000000000000000000000000000..a05eacddf9b6a886f544ebf224221770e5518405
--- /dev/null
+++ b/bench/miopen_db.py
@@ -0,0 +1,101 @@
+"""Report MIOpen find-db state, cold-start cost and solver-search behaviour.
+
+Context: MIOpen on this stack ships no system find-db for gfx1010
+(`gfx1010_20.HIP.fdb.txt` is not present), but it maintains a user find-db in
+`~/.miopen/db/*.ufdb.txt` that is populated automatically. Two things matter for
+users:
+
+* the ~1.3 s cost of the very first convolution in a process is MIOpen
+  kernel-db/context initialisation, not a solver search;
+* forcing a full search (`MIOPEN_FIND_ENFORCE=SEARCH`) or a heuristic-only mode
+  (`MIOPEN_FIND_MODE=FAST`) does not change steady-state throughput for the
+  SD/ResNet shapes tested, because the cached user-db solution is already the
+  fastest.
+
+This script prints those facts so the claims can be re-verified.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\miopen_db.py
+"""
+
+import glob
+import os
+import sys
+import time
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from common import save_report
+
+
+def db_state():
+    root = Path(os.path.expanduser("~/.miopen"))
+    files = sorted(glob.glob(str(root / "db" / "*")), key=os.path.getmtime)
+    return {
+        "root": str(root),
+        "exists": root.exists(),
+        "db_files": [(os.path.basename(p), os.path.getsize(p),
+                      int(os.path.getmtime(p))) for p in files[-6:]],
+    }
+
+
+def timed_conv(shape, repeats=10):
+    b, c, h, w, o = shape
+    x = torch.randn(b, c, h, w, device="cuda", dtype=torch.float16)
+    weight = torch.randn(o, c, 3, 3, device="cuda", dtype=torch.float16)
+    t0 = time.perf_counter()
+    F.conv2d(x, weight, padding=1)
+    torch.cuda.synchronize()
+    first = (time.perf_counter() - t0) * 1000
+    for _ in range(3):
+        F.conv2d(x, weight, padding=1)
+    torch.cuda.synchronize()
+    samples = []
+    for _ in range(repeats):
+        t = time.perf_counter()
+        F.conv2d(x, weight, padding=1)
+        torch.cuda.synchronize()
+        samples.append((time.perf_counter() - t) * 1000)
+    samples.sort()
+    return first, samples[len(samples) // 2]
+
+
+def main():
+    torch.cuda.set_per_process_memory_fraction(0.85)
+    print(f"MIOPEN_FIND_MODE={os.environ.get('MIOPEN_FIND_MODE')} "
+          f"MIOPEN_FIND_ENFORCE={os.environ.get('MIOPEN_FIND_ENFORCE')}", flush=True)
+    state = db_state()
+    print(f"find-db: {state['root']} exists={state['exists']}", flush=True)
+    for name, size, mtime in state["db_files"]:
+        print(f"  {name} ({size} bytes, mtime {mtime})", flush=True)
+
+    # process initialisation cost (measured before any real convolution)
+    xd = torch.randn(1, 8, 8, 8, device="cuda", dtype=torch.float16)
+    wd = torch.randn(8, 8, 3, 3, device="cuda", dtype=torch.float16)
+    t0 = time.perf_counter()
+    F.conv2d(xd, wd, padding=1)
+    torch.cuda.synchronize()
+    init_ms = (time.perf_counter() - t0) * 1000
+    print(f"MIOpen/context initialisation on first conv: {init_ms:.0f} ms", flush=True)
+
+    rows = []
+    for shape in ((1, 64, 56, 56, 64), (2, 256, 64, 64, 256), (1, 320, 64, 64, 320)):
+        first, steady = timed_conv(shape)
+        print(f"shape {shape}: first {first:.2f} ms, steady {steady:.4f} ms", flush=True)
+        rows.append({"shape": shape, "first_ms": first, "steady_ms": steady})
+
+    state_after = db_state()
+    save_report("miopen_db", {
+        "db_before": state, "db_after": state_after,
+        "init_ms": init_ms, "rows": rows,
+        "find_mode": os.environ.get("MIOPEN_FIND_MODE"),
+        "find_enforce": os.environ.get("MIOPEN_FIND_ENFORCE"),
+    })
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/model_bench.py b/bench/model_bench.py
new file mode 100644
index 0000000000000000000000000000000000000000..ccbf723b3b943f3f72074388fc3bc357dfd19c93
--- /dev/null
+++ b/bench/model_bench.py
@@ -0,0 +1,261 @@
+"""Benchmark a Hugging Face causal LM on the ZLUDA/PyTorch/Triton engine.
+
+Measures prefill and decode throughput, peak memory and a training step for a
+model on gfx1010, across the configurations that matter for this card:
+
+  * dtype: fp16 / bf16 / fp32
+  * fp16 accumulation on/off (cublas HH kernels)
+  * attention: math SDPA (ZLUDA cannot use PyTorch flash/mem-efficient on
+    gfx1010) vs the Triton flash-attention path from zluda_ops
+  * torch.compile on/off
+  * weight quantization: none / int8 / int4 (zluda_ops.quant; int4 uses the
+    fused dequant kernels, int8 uses a cached dequantized copy)
+
+bitsandbytes is not used: its prebuilt CUDA kernels fail on ZLUDA
+(`named symbol not found`).
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\model_bench.py --quick
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\model_bench.py --dtype fp16 --prefill 1024 --decode 32
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\model_bench.py --dtype bf16 --fp16acc
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\model_bench.py --quant int4 --attn triton
+"""
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from torch.nn.attention import SDPBackend, sdpa_kernel
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from bench.common import bench_median, save_report
+
+DEFAULT_MODEL = str(Path(__file__).resolve().parents[1] / "models" / "Qwen2.5-0.5B-Instruct")
+
+
+def patch_attention(mode):
+    """Return an unpatch callable. mode: 'math' | 'triton' | 'default'."""
+    orig = F.scaled_dot_product_attention
+    if mode == "math":
+        def math_sdpa(*args, **kwargs):
+            with sdpa_kernel(SDPBackend.MATH):
+                return orig(*args, **kwargs)
+        F.scaled_dot_product_attention = math_sdpa
+    elif mode == "triton":
+        from zluda_ops import flash_attention
+        F.scaled_dot_product_attention = flash_attention.scaled_dot_product_attention
+    return lambda: setattr(F, "scaled_dot_product_attention", orig)
+
+
+class QuantLinear(torch.nn.Module):
+    """nn.Linear replacement with int4/int8 weight-only storage."""
+
+    def __init__(self, linear, bits=4, group=64):
+        super().__init__()
+        self.bits = bits
+        self.group = group
+        self.in_features = linear.in_features
+        self.out_features = linear.out_features
+        w = linear.weight.detach()
+        self.bias = None if linear.bias is None else torch.nn.Parameter(
+            linear.bias.detach().clone())
+        from zluda_ops import quant as q
+        if bits == 4:
+            self.packed, self.scales = q.quantize_int4(w, group)
+            self._q = q
+        elif bits == 8:
+            self.int8, self.scales = q.quantize_int8(w, 128)
+            self._cached_fp16 = None
+            self._q = q
+        else:
+            raise ValueError("bits must be 4 or 8")
+
+    def forward(self, x):
+        shape = x.shape
+        x2 = x.reshape(-1, shape[-1])
+        if self.bits == 4:
+            y = self._q.int4_linear(x2, self.packed, self.scales, self.bias, self.group)
+            if y is None:
+                y = self._q.int4_matmul(x2, self.packed, self.scales, self.bias, self.group)
+        else:
+            if self._cached_fp16 is None:
+                self._cached_fp16 = self._q.dequantize_int8(
+                    self.int8, self.scales,
+                    (self.out_features, self.in_features), 128)
+            y = F.linear(x2, self._cached_fp16, self.bias)
+        return y.reshape(*shape[:-1], self.out_features)
+
+
+def quantize_model(model, bits, group=64):
+    count = 0
+    for name, child in list(model.named_children()):
+        if isinstance(child, torch.nn.Linear):
+            setattr(model, name, QuantLinear(child.to(torch.float16), bits, group))
+            count += 1
+        else:
+            count += quantize_model(child, bits, group)
+    return count
+
+
+def load_model(path, dtype, attn):
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+    tokenizer = AutoTokenizer.from_pretrained(path, local_files_only=True)
+    kwargs = dict(local_files_only=True, low_cpu_mem_usage=True)
+    if dtype is not None:
+        kwargs["torch_dtype"] = dtype
+    kwargs["attn_implementation"] = "eager" if attn == "math" else "sdpa"
+    model = AutoModelForCausalLM.from_pretrained(path, **kwargs)
+    model.eval()
+    return tokenizer, model
+
+
+def measure_prefill(model, input_ids, warmup=2, iters=3):
+    def run():
+        with torch.no_grad():
+            return model(input_ids=input_ids, use_cache=True, logits_to_keep=1)
+    for _ in range(warmup):
+        run()
+    torch.cuda.synchronize()
+    ms = bench_median(run, rounds=iters, iters=1)
+    return ms
+
+
+def measure_decode(model, input_ids, steps, warmup=1):
+    with torch.no_grad():
+        out = model(input_ids=input_ids, use_cache=True, logits_to_keep=1)
+    past = out.past_key_values
+    next_tok = out.logits[:, -1:].argmax(-1)
+
+    def step():
+        nonlocal past, next_tok
+        out2 = model(input_ids=next_tok, past_key_values=past, use_cache=True,
+                     logits_to_keep=1)
+        past = out2.past_key_values
+        next_tok = out2.logits[:, -1:].argmax(-1)
+
+    with torch.no_grad():
+        for _ in range(warmup):
+            step()
+    torch.cuda.synchronize()
+    t = time.perf_counter()
+    with torch.no_grad():
+        for _ in range(steps):
+            step()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - t) / steps * 1000
+
+
+def measure_train_step(model, input_ids, warmup=1, iters=2):
+    model.train()
+    labels = input_ids.clone()
+
+    def step():
+        out = model(input_ids=input_ids, labels=labels)
+        out.loss.backward()
+        model.zero_grad(set_to_none=True)
+        return out.loss
+
+    step()
+    torch.cuda.synchronize()
+    ms = bench_median(step, rounds=iters, iters=1)
+    model.eval()
+    return ms
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", default=DEFAULT_MODEL)
+    parser.add_argument("--dtype", default="fp16", choices=["fp16", "bf16", "fp32"])
+    parser.add_argument("--attn", default="math", choices=["math", "triton", "default"])
+    parser.add_argument("--quant", default="none", choices=["none", "int8", "int4"])
+    parser.add_argument("--group", type=int, default=64)
+    parser.add_argument("--fp16acc", action="store_true")
+    parser.add_argument("--compile", action="store_true")
+    parser.add_argument("--compile-mode", default="default")
+    parser.add_argument("--compile-fullgraph", action="store_true")
+    parser.add_argument("--compile-dynamic", action="store_true")
+    parser.add_argument("--prefill", type=int, default=512)
+    parser.add_argument("--decode", type=int, default=16)
+    parser.add_argument("--train", action="store_true")
+    parser.add_argument("--exact-seq", action="store_true",
+                        help="use random token ids of exactly --prefill length (for FA tests)")
+    parser.add_argument("--quick", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    parser.add_argument("--tag", default="")
+    args = parser.parse_args()
+    if args.quick:
+        args.prefill = min(args.prefill, 128)
+        args.decode = min(args.decode, 4)
+    if not torch.cuda.is_available():
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    torch.cuda.reset_peak_memory_stats()
+    dtypes = {"fp16": torch.float16, "bf16": torch.bfloat16, "fp32": torch.float32}
+    print(f"VRAM fraction {args.vram_fraction} | dtype={args.dtype} attn={args.attn} "
+          f"quant={args.quant} fp16acc={args.fp16acc} compile={args.compile}", flush=True)
+
+    unpatch = patch_attention(args.attn)
+    try:
+        if args.fp16acc:
+            torch._C._set_cublas_allow_fp16_accumulation(True)
+        tokenizer, model = load_model(args.model, dtypes[args.dtype], args.attn)
+        model = model.cuda()
+        load_mb = torch.cuda.max_memory_allocated() / 1024 ** 2
+        if args.quant != "none":
+            n = quantize_model(model, 4 if args.quant == "int4" else 8, args.group)
+            print(f"quantized {n} linear layers to {args.quant}", flush=True)
+            quant_mb = torch.cuda.max_memory_allocated() / 1024 ** 2
+        else:
+            quant_mb = None
+        if args.compile:
+            t0 = time.perf_counter()
+            model = torch.compile(model, dynamic=args.compile_dynamic, mode=args.compile_mode,
+                                   fullgraph=args.compile_fullgraph)
+            compile_s = time.perf_counter() - t0
+            print(f"torch.compile setup {compile_s:.1f} s", flush=True)
+        else:
+            compile_s = None
+
+        text = "The quick brown fox jumps over the lazy dog. " * max(1, args.prefill // 10)
+        if args.exact_seq:
+            vocab = model.config.vocab_size
+            torch.manual_seed(0)
+            ids = torch.randint(0, vocab, (1, args.prefill), device="cuda")
+        else:
+            ids = tokenizer(text, return_tensors="pt", truncation=True,
+                            max_length=args.prefill).input_ids.cuda()
+        seq = ids.shape[1]
+        prefill_ms = measure_prefill(model, ids)
+        decode_ms = measure_decode(model, ids, args.decode)
+        peak_mb = torch.cuda.max_memory_allocated() / 1024 ** 2
+        train_ms = measure_train_step(model, ids) if args.train else None
+        result = {
+            "dtype": args.dtype, "attn": args.attn, "quant": args.quant,
+            "fp16acc": args.fp16acc, "compile": args.compile, "tag": args.tag,
+            "seq_len": seq, "load_mb": load_mb, "quant_mb": quant_mb,
+            "peak_mb": peak_mb, "compile_s": compile_s,
+            "prefill_ms": prefill_ms, "prefill_tok_s": seq / prefill_ms * 1000,
+            "decode_ms_per_tok": decode_ms,
+            "decode_tok_s": 1000 / decode_ms,
+            "train_step_ms": train_ms,
+        }
+        try:
+            import zluda_ops.auto as _auto_dbg
+            result["dispatch"] = dict(_auto_dbg._DISPATCH_STATS)
+        except Exception:
+            pass
+        print(json.dumps({k: (round(v, 4) if isinstance(v, float) else v)
+                          for k, v in result.items()}, indent=2), flush=True)
+        save_report("model_bench", result)
+    finally:
+        unpatch()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/monitor.py b/bench/monitor.py
new file mode 100644
index 0000000000000000000000000000000000000000..65b65d448bc12f5172552b5a607e8e4f9e98b783
--- /dev/null
+++ b/bench/monitor.py
@@ -0,0 +1,77 @@
+import argparse
+import json
+import subprocess
+import time
+
+import torch
+
+from common import nvml_sample, save_report
+from gpu_clocks import sample as clocks_sample
+
+GPU_COUNTER = (
+    "(Get-Counter '\\GPU Engine(*)\\Utilization Percentage' -ErrorAction SilentlyContinue)"
+    ".CounterSamples | Measure-Object CookedValue -Sum | Select-Object -ExpandProperty Sum"
+)
+
+
+def utilization():
+    try:
+        proc = subprocess.run(
+            ["powershell", "-NoProfile", "-Command", GPU_COUNTER],
+            capture_output=True, text=True, timeout=5,
+        )
+        value = proc.stdout.strip().replace(",", ".")
+        if value:
+            return max(0.0, min(100.0, float(value)))
+    except Exception:
+        pass
+    try:
+        return float(torch.cuda.utilization(0))
+    except Exception:
+        return None
+
+
+def sample():
+    free, total = torch.cuda.mem_get_info()
+    return {
+        "time": time.time(),
+        "gpu_util_pct": utilization(),
+        "vram_free_mb": free / 1024**2,
+        "vram_total_mb": total / 1024**2,
+        "vram_used_mb": (total - free) / 1024**2,
+        "torch_allocated_mb": torch.cuda.memory_allocated() / 1024**2,
+        "torch_reserved_mb": torch.cuda.memory_reserved() / 1024**2,
+        "clocks": clocks_sample(),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--seconds", type=float, default=5.0)
+    parser.add_argument("--interval", type=float, default=1.0)
+    args = parser.parse_args()
+    if torch.cuda.is_available():
+        torch.cuda.init()
+    rows = []
+    end = time.time() + args.seconds
+    while time.time() < end:
+        rows.append(sample())
+        time.sleep(args.interval)
+    usable = [r["gpu_util_pct"] for r in rows if r["gpu_util_pct"] is not None]
+    report = {
+        "samples": rows,
+        "gpu_util_avg_pct": sum(usable) / len(usable) if usable else None,
+        "gpu_util_max_pct": max(usable) if usable else None,
+        "clock_power": nvml_sample(),
+        "limitations": [
+            "gfx1010 Windows has no rocm-smi/amd-smi; ZLUDA NVML reports NotSupported",
+            "GPU utilization comes from Windows performance counters and includes other processes",
+            "sclk/mclk/temperature/power are unavailable",
+        ],
+    }
+    print(json.dumps(report, indent=2))
+    save_report("monitor", report)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/bench/ollama_bench.py b/bench/ollama_bench.py
new file mode 100644
index 0000000000000000000000000000000000000000..b9eab998788bd59ac732277d81375d2858cf6573
--- /dev/null
+++ b/bench/ollama_bench.py
@@ -0,0 +1,118 @@
+"""Benchmark an Ollama model (Vulkan backend on gfx1010) over the HTTP API.
+
+Reports prefill (prompt eval) and decode (eval) throughput, load time and the
+GPU/CPU processor split chosen by Ollama. Designed to be compared against the
+same GGUF run on llama.cpp-CUDA through ZLUDA, and against the PyTorch/ZLUDA
+matrix (`bench/model_bench.py`).
+
+The Ollama server is started/restarted by `bench/ollama_config.ps1` when
+switching backend options (flash attention, KV cache type).
+
+Usage:
+  venv\\Scripts\\python.exe bench\\ollama_bench.py --model qwen05-bench --ctx 2048,8192,32768
+"""
+
+import argparse
+import json
+import sys
+import time
+import urllib.request
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from common import save_report
+
+HOST = "http://127.0.0.1:11434"
+
+
+def post(path, payload, timeout=3600):
+    req = urllib.request.Request(HOST + path, data=json.dumps(payload).encode(),
+                                 headers={"Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=timeout) as r:
+        return json.loads(r.read().decode())
+
+
+def get(path, timeout=120):
+    with urllib.request.urlopen(HOST + path, timeout=timeout) as r:
+        return json.loads(r.read().decode())
+
+
+def ps():
+    try:
+        return get("/api/ps").get("models", [])
+    except Exception as exc:  # noqa: BLE001
+        return [{"error": str(exc)}]
+
+
+def make_prompt(tokens_approx):
+    # ~4 characters per token for English text
+    sentence = "The quick brown fox jumps over the lazy dog. "
+    reps = max(1, tokens_approx * 4 // len(sentence))
+    return (sentence * reps)[: tokens_approx * 4]
+
+
+def bench_ctx(model, ctx_tokens, num_predict, timeout=3600):
+    prompt = make_prompt(ctx_tokens)
+    t0 = time.time()
+    res = post("/api/generate", {
+        "model": model,
+        "prompt": prompt,
+        "stream": False,
+        "options": {"num_ctx": ctx_tokens, "num_predict": num_predict,
+                    "temperature": 0.0},
+    }, timeout=timeout)
+    wall = time.time() - t0
+    ns = 1e9
+    pc = res.get("prompt_eval_count", 0)
+    pd = res.get("prompt_eval_duration", 0) / ns
+    ec = res.get("eval_count", 0)
+    ed = res.get("eval_duration", 0) / ns
+    ld = res.get("load_duration", 0) / ns
+    row = {
+        "requested_ctx": ctx_tokens,
+        "prompt_tokens": pc,
+        "prompt_ms": pd * 1000,
+        "prefill_tok_s": pc / pd if pd else None,
+        "eval_tokens": ec,
+        "decode_ms_per_tok": (ed / ec * 1000) if ec else None,
+        "decode_tok_s": (ec / ed) if ed else None,
+        "load_s": ld,
+        "wall_s": wall,
+    }
+    print(f"ctx={ctx_tokens:6d} prompt_tokens={pc:6d} prefill={row['prefill_tok_s'] or 0:8.1f} tok/s "
+          f"decode={row['decode_tok_s'] or 0:7.2f} tok/s load={ld:5.1f}s", flush=True)
+    return row
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", default="qwen05-q4")
+    parser.add_argument("--ctx", default="2048,8192,16384,32768")
+    parser.add_argument("--num-predict", type=int, default=32)
+    parser.add_argument("--unload", action="store_true")
+    parser.add_argument("--tag", default="")
+    args = parser.parse_args()
+    ctxs = [int(x) for x in args.ctx.split(",") if x]
+    print(f"model={args.model} ctx={ctxs} num_predict={args.num_predict}", flush=True)
+    models = ps()
+    print("ollama ps before:", json.dumps(models)[:400], flush=True)
+    rows = []
+    for ctx in ctxs:
+        rows.append(bench_ctx(args.model, ctx, args.num_predict))
+    if args.unload:
+        try:
+            post("/api/generate", {"model": args.model, "prompt": "", "keep_alive": 0},
+                 timeout=60)
+        except Exception:
+            pass
+    ps_after = ps()
+    print("ollama ps after:", json.dumps(ps_after)[:600], flush=True)
+    save_report("ollama_bench", {
+        "model": args.model, "tag": args.tag, "rows": rows,
+        "processor": ps_after, "num_predict": args.num_predict,
+    })
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
