+except Exception as e:
+    print(f"linear fp16: FAIL {type(e).__name__}: {str(e)[:150]}")
+
+try:
+    import torch.nn.functional as F
+    from torch.nn.attention import SDPBackend, sdpa_kernel
+
+    backends = {
+        "math": SDPBackend.MATH,
