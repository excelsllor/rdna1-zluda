+    x0 = torch.zeros(8, 16, device="cuda", dtype=torch.float32)
+    W0 = torch.zeros(16, 32, device="cuda", dtype=torch.float32)
+    b0 = torch.arange(32, device="cuda", dtype=torch.float32)
+    y0 = torch.addmm(b0, x0, W0)
