diff --git a/bench/optim8bit.py b/bench/optim8bit.py
new file mode 100644
index 0000000000000000000000000000000000000000..cc28e960b6702370273b29654817af616d406384
--- /dev/null
+++ b/bench/optim8bit.py
@@ -0,0 +1,142 @@
+"""Benchmark the Triton 8-bit AdamW (bitsandbytes substitute) on ZLUDA.
+
+bitsandbytes' CUDA kernels cannot run through ZLUDA on gfx1010, so
+`zluda_ops.optim8bit.AdamW8bit` implements the same idea with a Triton kernel:
+int8 moment estimates with per-block fp32 absmax scales.
+
+The script compares step time, optimizer-state memory and parameter parity
+against torch.optim.AdamW, and runs a short training loop with both.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\optim8bit.py --quick
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\optim8bit.py
+"""
+
+import argparse
+import sys
+import time
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from zluda_ops.optim8bit import AdamW8bit
+from bench.common import bench_median, save_report
+
+
+def step_case(num_params, device="cuda"):
+    torch.manual_seed(0)
+    p = torch.nn.Parameter(torch.randn(num_params, device=device) * 0.1)
+    grads = [torch.randn(num_params, device=device) * 0.01 for _ in range(4)]
+    p_t = torch.nn.Parameter(p.detach().clone())
+    opt_t = torch.optim.AdamW([p_t], lr=1e-3)
+    opt_8 = AdamW8bit([p], lr=1e-3)
+    idx = [0]
+
+    def torch_step():
+        p_t.grad = grads[idx[0] % len(grads)]
+        idx[0] += 1
+        opt_t.step()
+        opt_t.zero_grad()
+
+    def bit_step():
+        p.grad = grads[idx[0] % len(grads)]
+        idx[0] += 1
+        opt_8.step()
+
+    torch_step()
+    bit_step()
+    tm = bench_median(torch_step, rounds=3, iters=10)
+    bm = bench_median(bit_step, rounds=3, iters=10)
+    mem8 = opt_8.state_memory_bytes()
+    mem32 = opt_8.fp32_state_memory_bytes()
+    print(f"step {num_params} fp32 params: torch {tm:.3f} ms | 8-bit {bm:.3f} ms "
+          f"({tm / bm:.2f}x) | state mem {mem8 / 1e6:.2f} MB vs fp32 {mem32 / 1e6:.2f} MB "
+          f"({mem32 / mem8:.2f}x less)", flush=True)
+    return {"num_params": num_params, "torch_step_ms": tm, "bit_step_ms": bm,
+            "speedup": tm / bm, "state_mem_bytes": mem8,
+            "fp32_state_mem_bytes": mem32, "memory_ratio": mem32 / mem8}
+
+
+def parity_case(num_params=262144, steps=8, device="cuda"):
+    torch.manual_seed(0)
+    p0 = torch.randn(num_params, device=device) * 0.1
+    grads = [torch.randn(num_params, device=device) * 0.01 for _ in range(steps)]
+    p_t = torch.nn.Parameter(p0.clone())
+    p_b = torch.nn.Parameter(p0.clone())
+    opt_t = torch.optim.AdamW([p_t], lr=1e-3, weight_decay=0.01)
+    opt_b = AdamW8bit([p_b], lr=1e-3, weight_decay=0.01)
+    for g in grads:
+        p_t.grad = g.clone()
+        opt_t.step()
+        opt_t.zero_grad()
+        p_b.grad = g.clone()
+        opt_b.step()
+    diff = (p_t.detach() - p_b.detach()).abs()
+    rel = (diff.norm() / p_t.detach().norm()).item()
+    print(f"parity after {steps} steps: max abs {diff.max().item():.3e}, "
+          f"rel {rel:.2e}", flush=True)
+    return {"steps": steps, "max_abs_diff": diff.max().item(), "rel_diff": rel}
+
+
+def train_case(steps=20, device="cuda"):
+    torch.manual_seed(0)
+    x = torch.randn(256, 512, device=device)
+    y = torch.randn(256, 128, device=device)
+
+    def make():
+        model = torch.nn.Sequential(
+            torch.nn.Linear(512, 512), torch.nn.SiLU(),
+            torch.nn.Linear(512, 128),
+        ).to(device)
+        return model
+
+    def train(use_8bit):
+        model = make()
+        opt = (AdamW8bit(model.parameters(), lr=1e-3) if use_8bit
+               else torch.optim.AdamW(model.parameters(), lr=1e-3))
+        losses = []
+        t0 = time.perf_counter()
+        for _ in range(steps):
+            opt.zero_grad()
+            out = model(x)
+            loss = torch.nn.functional.mse_loss(out, y)
+            loss.backward()
+            opt.step()
+            losses.append(float(loss))
+        torch.cuda.synchronize()
+        return losses, (time.perf_counter() - t0) / steps * 1000
+
+    l32, ms32 = train(False)
+    l8, ms8 = train(True)
+    print(f"training {steps} steps: fp32 AdamW {ms32:.2f} ms/step, "
+          f"8-bit {ms8:.2f} ms/step ({ms32 / ms8:.2f}x) | final loss "
+          f"{l32[-1]:.4f} vs {l8[-1]:.4f}", flush=True)
+    return {"steps": steps, "fp32_ms_per_step": ms32, "bit_ms_per_step": ms8,
+            "speedup": ms32 / ms8, "final_loss_fp32": l32[-1],
+            "final_loss_8bit": l8[-1], "loss_curve_fp32": l32, "loss_curve_8bit": l8}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--quick", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+    if not torch.cuda.is_available():
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+    num = 1024 * 1024 if args.quick else 4 * 1024 * 1024
+    report = {
+        "step": step_case(num),
+        "parity": parity_case(),
+        "train": train_case(steps=8 if args.quick else 20),
+    }
+    save_report("optim8bit", report)
+    print("done", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/quant.py b/bench/quant.py
new file mode 100644
index 0000000000000000000000000000000000000000..dba4a3698ee0c636aecbb1efbc707e9d9c3329e8
--- /dev/null
+++ b/bench/quant.py
@@ -0,0 +1,137 @@
+"""Validate int4/int8 weight-only quantization and the fused int4 dequant-GEMV.
+
+Checks quantization error and compression, correctness of `int4_linear` against a
+dequantize-then-linear reference, and decode-speed against the fp16 GEMV kernel
+and torch. Peak bandwidth reference: 448 GB/s.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\quant.py --quick
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\quant.py --n 4096 --k 4096
+"""
+
+import argparse
+import sys
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from zluda_ops import gemv as zgemv
+from zluda_ops import quant
+from bench.common import bench_median, save_report
+
+PEAK_BW_GBS = 448.0
+
+
+def quant_error(n=1024, k=1024):
+    torch.manual_seed(0)
+    w = torch.randn(n, k, device="cuda", dtype=torch.float16) * 0.02
+    rows = []
+    for bits, group in ((4, 32), (4, 64), (4, 128), (8, 128)):
+        if bits == 4:
+            packed, scales = quant.quantize_int4(w, group)
+            deq = quant.dequantize_int4(packed, scales, (n, k), group)
+        else:
+            packed, scales = quant.quantize_int8(w, group)
+            deq = quant.dequantize_int8(packed, scales, (n, k), group)
+        diff = (deq.float() - w.float())
+        rel = (diff.norm() / w.float().norm()).item()
+        fp16_bytes = w.numel() * 2
+        q_bytes = packed.numel() + scales.numel() * 2
+        rows.append({"bits": bits, "group": group, "rel_rms": rel,
+                     "compression": fp16_bytes / q_bytes,
+                     "max_abs": diff.abs().max().item()})
+        print(f"int{bits} g{group}: rel RMS {rel:.4%}  compression {fp16_bytes / q_bytes:.2f}x",
+              flush=True)
+    return rows
+
+
+def correctness(n=1024, k=1024, group=64):
+    torch.manual_seed(0)
+    w = torch.randn(n, k, device="cuda", dtype=torch.float16) * 0.02
+    bias = (torch.randn(n, device="cuda", dtype=torch.float16) * 0.02)
+    packed, scales = quant.quantize_int4(w, group)
+    rows = []
+    for m in (1, 4, 8, 16):
+        x = torch.randn(m, k, device="cuda", dtype=torch.float16) * 0.1
+        y = quant.int4_linear(x, packed, scales, bias, group)
+        if y is None:
+            print(f"m={m}: unsupported", flush=True)
+            continue
+        ref = quant.linspace_reference(x, packed, scales, bias, group)
+        ref32 = F.linear(x.float(), quant.dequantize_int4(packed, scales, (n, k), group).float(),
+                         bias.float())
+        err = (y.float() - ref.float()).abs().max().item()
+        err32 = (y.float() - ref32).abs().max().item()
+        rows.append({"m": m, "max_abs_vs_fp16_ref": err, "max_abs_vs_fp32_ref": err32})
+        print(f"m={m}: max abs vs fp16-ref {err:.5f}, vs fp32-ref {err32:.5f}", flush=True)
+    return rows
+
+
+def speed(n=4096, k=4096, group=64):
+    torch.manual_seed(0)
+    w = torch.randn(n, k, device="cuda", dtype=torch.float16) * 0.02
+    bias = (torch.randn(n, device="cuda", dtype=torch.float16) * 0.02)
+    packed, scales = quant.quantize_int4(w, group)
+    w_deq = quant.dequantize_int4(packed, scales, (n, k), group)
+    rows = []
+    for m in (1, 8):
+        x = torch.randn(m, k, device="cuda", dtype=torch.float16) * 0.1
+        q_ms = bench_median(lambda: quant.int4_linear(x, packed, scales, bias, group),
+                            rounds=3, iters=10)
+        fp16_y = zgemv.linear(x, w, bias, accurate=True)
+        fp16_ms = bench_median(lambda: zgemv.linear(x, w, bias, accurate=True),
+                               rounds=3, iters=10)
+        torch_ms = bench_median(lambda: F.linear(x, w_deq, bias), rounds=3, iters=10)
+        q_bytes = packed.numel() + scales.numel() * 2 + m * k * 2 + m * n * 2 + n * 2
+        q_gbs = q_bytes / (q_ms / 1000.0) / 1e9
+        fp16_bytes = n * k * 2 + m * k * 2 + m * n * 2 + n * 2
+        fp16_gbs = fp16_bytes / (fp16_ms / 1000.0) / 1e9
+        err = (quant.int4_linear(x, packed, scales, bias, group).float()
+               - F.linear(x, w_deq, bias).float()).abs().max().item()
+        rows.append({"m": m, "int4_ms": q_ms, "int4_gbs": q_gbs,
+                     "fp16_ms": fp16_ms, "fp16_gbs": fp16_gbs,
+                     "torch_ms": torch_ms, "max_abs": err,
+                     "speedup_vs_fp16": fp16_ms / q_ms})
+        print(f"m={m}: int4 {q_ms:7.3f} ms ({q_gbs:6.1f} GB/s) vs fp16 GEMV "
+              f"{fp16_ms:7.3f} ms ({fp16_gbs:6.1f} GB/s) = {fp16_ms / q_ms:4.2f}x"
+              f" | torch(dequant+linear) {torch_ms:7.3f} ms err {err:.4f}", flush=True)
+    return rows
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--n", type=int, default=4096)
+    parser.add_argument("--k", type=int, default=4096)
+    parser.add_argument("--group", type=int, default=64)
+    parser.add_argument("--quick", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+    if not torch.cuda.is_available():
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+
+    n = 1024 if args.quick else args.n
+    k = 1024 if args.quick else args.k
+    errs = quant_error(n, k)
+    corr = correctness(n, k, args.group)
+    spd = speed(n, k, args.group)
+    vram = {
+        "7b_fp16_gb": round(7e9 * 2 / 1e9, 2),
+        "7b_int4_gb": round(7e9 / 2 / 1e9, 2),
+        "7b_int8_gb": round(7e9 * 1 / 1e9, 2),
+    }
+    print(f"7B weights: fp16 {vram['7b_fp16_gb']} GB, int8 {vram['7b_int8_gb']} GB, "
+          f"int4 {vram['7b_int4_gb']} GB", flush=True)
+    save_report("quant", {"quant_error": errs, "correctness": corr,
+                          "speed": spd, "vram_estimate": vram})
+    worst = max(c["max_abs_vs_fp32_ref"] for c in corr)
+    print(f"worst fused-vs-fp32 error {worst:.5f}", flush=True)
+    return 0 if worst < 5e-2 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/quant_prefill.py b/bench/quant_prefill.py
new file mode 100644
index 0000000000000000000000000000000000000000..8bbea1dbd82c7c0817496dcaa778c1107ed805f7
--- /dev/null
+++ b/bench/quant_prefill.py
@@ -0,0 +1,130 @@
+"""Prefill comparison: fused int4 dequant-GEMM vs dequant-once + GEMM.
+
+Decode (M<=16) is memory-bound on the int4 weights and the fused GEMV wins.
+Prefill (M=32..256) is compute-bound, so the question is whether dequantising
+weights on the fly inside a GEMM tile beats dequantising the weight matrix once
+(extra 2 bytes/weight traffic) and running a regular fp16 GEMM. This script
+answers that, and verifies correctness against a float32 reference.
+
+Usage:
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\quant_prefill.py --quick
+  run-zluda.cmd venv\\Scripts\\python.exe bench\\quant_prefill.py
+"""
+
+import argparse
+import random
+import sys
+import time
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from zluda_ops import quant
+from bench.common import save_report
+
+
+def timed_shuffled(fns, warm_seconds=1.5, rounds=5, iters=8):
+    t0 = time.perf_counter()
+    while time.perf_counter() - t0 < warm_seconds:
+        for fn in fns.values():
+            fn()
+        torch.cuda.synchronize()
+    rng = random.Random(11)
+    samples = {name: [] for name in fns}
+    for _ in range(rounds):
+        order = list(fns)
+        rng.shuffle(order)
+        for name in order:
+            fn = fns[name]
+            for _ in range(2):
+                fn()
+            torch.cuda.synchronize()
+            t = time.perf_counter()
+            for _ in range(iters):
+                fn()
+            torch.cuda.synchronize()
+            samples[name].append((time.perf_counter() - t) / iters * 1000)
+    return {name: sorted(v)[len(v) // 2] for name, v in samples.items()}
+
+
+def case(m, n=4096, k=4096, group=64, device="cuda", dtype=torch.float16):
+    torch.manual_seed(0)
+    w = torch.randn(n, k, device=device, dtype=dtype) * 0.02
+    x = torch.randn(m, k, device=device, dtype=dtype) * 0.1
+    bias = torch.randn(n, device=device, dtype=dtype) * 0.02
+    packed, scales = quant.quantize_int4(w, group)
+    w_deq = quant.dequantize_int4(packed, scales, (n, k), group)
+
+    fused_out = quant.int4_matmul(x, packed, scales, bias, group)
+    deq_out = quant.int4_prefill_linear(x, packed, scales, bias, group)
+    ref = x.float() @ w_deq.float().t() + bias.float()
+    fused_err = (fused_out.float() - ref).abs().max().item()
+    deq_err = (deq_out.float() - ref).abs().max().item()
+
+    fns = {
+        "fused_int4_gemm": lambda: quant.int4_matmul(x, packed, scales, bias, group),
+        "dequant_once_gemm": lambda: quant.int4_prefill_linear(x, packed, scales, bias, group),
+        "fp16_weights_gemm": lambda: F.linear(x, w, bias),
+    }
+    ms = timed_shuffled(fns)
+    best = min(ms.values())
+    print(f"M={m:3d} N=K={n}: fused {ms['fused_int4_gemm']:7.3f} ms | "
+          f"dequant-once {ms['dequant_once_gemm']:7.3f} ms | "
+          f"fp16-roofline {ms['fp16_weights_gemm']:7.3f} ms | errors "
+          f"{fused_err:.4f}/{deq_err:.4f}", flush=True)
+    return {
+        "m": m, "n": n, "k": k,
+        "fused_ms": ms["fused_int4_gemm"],
+        "dequant_once_ms": ms["dequant_once_gemm"],
+        "fp16_roofline_ms": ms["fp16_weights_gemm"],
+        "fused_err": fused_err, "dequant_err": deq_err,
+        "fused_vs_dequant": ms["dequant_once_gemm"] / ms["fused_int4_gemm"],
+        "fused_vs_fp16": ms["fp16_weights_gemm"] / ms["fused_int4_gemm"],
+        "dequant_vs_fp16": ms["fp16_weights_gemm"] / ms["dequant_once_gemm"],
+    }
+
+
+def decode_reference(device="cuda"):
+    """Show the decode side for contrast: fused GEMV vs dequant-once at M=1."""
+    torch.manual_seed(0)
+    n = k = 4096
+    group = 64
+    w = torch.randn(n, k, device=device, dtype=torch.float16) * 0.02
+    x = torch.randn(1, k, device=device, dtype=torch.float16) * 0.1
+    bias = torch.randn(n, device=device, dtype=torch.float16) * 0.02
+    packed, scales = quant.quantize_int4(w, group)
+    fns = {
+        "fused_gemv": lambda: quant.int4_linear(x, packed, scales, bias, group),
+        "dequant_once": lambda: quant.int4_prefill_linear(x, packed, scales, bias, group),
+        "fp16_roofline": lambda: F.linear(x, w, bias),
+    }
+    ms = timed_shuffled(fns, rounds=4)
+    print(f"M=1 (decode): fused GEMV {ms['fused_gemv']:.4f} ms | dequant-once "
+          f"{ms['dequant_once']:.3f} ms | fp16 {ms['fp16_roofline']:.3f} ms", flush=True)
+    return {k: v for k, v in ms.items()}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--quick", action="store_true")
+    parser.add_argument("--vram-fraction", type=float, default=0.85)
+    args = parser.parse_args()
+    if not torch.cuda.is_available():
+        print("CUDA/ZLUDA device is not available")
+        return 1
+    torch.cuda.set_per_process_memory_fraction(args.vram_fraction)
+    print(f"VRAM fraction {args.vram_fraction}", flush=True)
+    if args.quick:
+        sizes, nk = [32, 64], 1024
+    else:
+        sizes, nk = [32, 64, 128, 256], 4096
+    rows = [case(m, nk, nk) for m in sizes]
+    decode = decode_reference()
+    save_report("quant_prefill", {"rows": rows, "decode": decode})
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/regression.py b/bench/regression.py
new file mode 100644
index 0000000000000000000000000000000000000000..23d7a589bcba6d7f28e1fb3a64a98624e77c6688
--- /dev/null
+++ b/bench/regression.py
@@ -0,0 +1,162 @@
+import argparse
+import sys
+
+import torch
+import torch.nn.functional as F
+from torch.nn.attention import SDPBackend, sdpa_kernel
+
+from common import bench, save_report
+
+DEV = "cuda"
+
+
+def max_abs(out, ref):
+    return (out.detach().cpu().double() - ref.double()).abs().max().item()
+
+
+def check(name, out, ref, atol, rtol):
+    err = max_abs(out, ref)
+    scale = ref.double().abs().max().item()
+    tol = atol + rtol * scale
+    return {"name": name, "max_abs": err, "tol": tol, "pass": err <= tol}
+
+
+def correctness(quick=False):
+    torch.manual_seed(0)
+    results = []
+    sizes = [256] if quick else [128, 256, 512]
+    for dtype, (atol, rtol) in {
+        torch.float32: (2e-3, 2e-3),
+        torch.float16: (5e-2, 2e-2),
+        torch.bfloat16: (2e-1, 5e-2),
+    }.items():
+        for n in sizes:
+            a = torch.randn(n, n, device=DEV, dtype=dtype)
+            b = torch.randn(n, n, device=DEV, dtype=dtype)
+            out = a @ b
+            ref = a.cpu().double() @ b.cpu().double()
+            results.append(check(f"matmul {str(dtype).split('.')[-1]} n={n}", out, ref, atol, rtol))
+
+    for dtype in (torch.float32, torch.float16, torch.bfloat16):
+        lin = torch.nn.Linear(512, 256).to(DEV, dtype=dtype)
+        x = torch.randn(64, 512, device=DEV, dtype=dtype)
+        out = lin(x)
+        ref = x.cpu().double() @ lin.weight.cpu().double().t() + lin.bias.cpu().double()
+        results.append(check(f"linear {str(dtype).split('.')[-1]}", out, ref, 0.1 if dtype != torch.float32 else 5e-3, 0.05 if dtype != torch.float32 else 5e-3))
+
+    for dtype in (torch.float32, torch.float16):
+        x = torch.randn(2, 3, 32, 32, device=DEV, dtype=dtype)
+        w = torch.randn(4, 3, 3, 3, device=DEV, dtype=dtype) * 0.1
+        b = torch.randn(4, device=DEV, dtype=dtype) * 0.1
+        out = F.conv2d(x, w, b, stride=1, padding=1)
+        ref = F.conv2d(x.cpu().double(), w.cpu().double(), b.cpu().double(), stride=1, padding=1)
+        results.append(check(f"conv2d {str(dtype).split('.')[-1]}", out, ref, 0.1 if dtype != torch.float32 else 2e-3, 0.05 if dtype != torch.float32 else 2e-3))
+
+    x = torch.randn(64, 1024, device=DEV, dtype=torch.float16)
+    out = torch.softmax(x, dim=-1)
+    ref = torch.softmax(x.cpu().double(), dim=-1)
+    results.append(check("softmax fp16", out, ref, 2e-2, 2e-2))
+
+    ln = torch.nn.LayerNorm(1024).half().cuda()
+    out = ln(x)
+    ref = F.layer_norm(x.cpu().double(), (1024,), ln.weight.cpu().double(), ln.bias.cpu().double())
+    results.append(check("layernorm fp16", out, ref, 5e-2, 2e-2))
+
+    for causal in (False, True):
+        q = torch.randn(1, 4, 128, 64, device=DEV, dtype=torch.float16)
+        k = torch.randn_like(q)
+        v = torch.randn_like(q)
+        with sdpa_kernel(SDPBackend.MATH):
+            out = F.scaled_dot_product_attention(q, k, v, is_causal=causal)
+        qd, kd, vd = q.cpu().double(), k.cpu().double(), v.cpu().double()
+        scores = qd @ kd.transpose(-2, -1) * (64 ** -0.5)
+        if causal:
+            mask = torch.triu(torch.ones(128, 128, dtype=torch.bool), diagonal=1)
+            scores = scores.masked_fill(mask, float("-inf"))
+        ref = torch.softmax(scores, dim=-1) @ vd
+        results.append(check(f"sdpa math fp16 causal={causal}", out, ref, 5e-2, 2e-2))
+    return results
+
+
+def performance(quick=False):
+    torch.manual_seed(0)
+    perf = {"gemm": [], "linear": [], "gemv": [], "sdpa": []}
+    sizes = [512, 1024] if quick else [512, 1024, 2048, 4096]
+    iters = 5 if quick else 8
+    for dtype in (torch.float32, torch.float16, torch.bfloat16):
+        for n in sizes:
+            a = torch.randn(n, n, device=DEV, dtype=dtype)
+            b = torch.randn(n, n, device=DEV, dtype=dtype)
+            ms = bench(lambda: a @ b, warmup=2, iters=iters)
+            tflops = 2 * n**3 / (ms / 1000.0) / 1e12
+            perf["gemm"].append({"dtype": str(dtype).split(".")[-1], "n": n, "ms": ms, "tflops": tflops})
+
+    n = 4096
+    for dtype in (torch.float32, torch.float16):
+        w = torch.randn(n, n, device=DEV, dtype=dtype) * 0.02
+        b = torch.randn(n, device=DEV, dtype=dtype) * 0.02
+        for m in (1, 4, 16, 64):
+            try:
+                x = torch.randn(m, n, device=DEV, dtype=dtype)
+                ms = bench(lambda: F.linear(x, w, b), warmup=3, iters=10)
+                traffic = n * n * x.element_size() + m * n * x.element_size() * 2
+                perf["linear"].append({"dtype": str(dtype).split(".")[-1], "m": m, "n": n, "k": n, "ms": ms, "gbs": traffic / (ms / 1000.0) / 1e9})
+            except Exception as exc:
+                perf["linear"].append({"dtype": str(dtype).split(".")[-1], "m": m, "error": f"{type(exc).__name__}: {str(exc)[:160]}"})
+        try:
+            x = torch.randn(n, device=DEV, dtype=dtype)
+            ms = bench(lambda: torch.mv(w, x), warmup=3, iters=10)
+            traffic = n * n * x.element_size() + n * x.element_size() * 2
+            perf["gemv"].append({"dtype": str(dtype).split(".")[-1], "n": n, "ms": ms, "gbs": traffic / (ms / 1000.0) / 1e9})
+        except Exception as exc:
+            perf["gemv"].append({"dtype": str(dtype).split(".")[-1], "n": n, "error": f"{type(exc).__name__}: {str(exc)[:160]}"})
+
+    for s in (512, 1024, 2048):
+        q = torch.randn(1, 8, s, 64, device=DEV, dtype=torch.float16)
+        k = torch.randn_like(q)
+        v = torch.randn_like(q)
+        with sdpa_kernel(SDPBackend.MATH):
+            ms = bench(lambda: F.scaled_dot_product_attention(q, k, v, is_causal=True), warmup=2, iters=5)
+        tflops = 4 * 8 * s * s * 64 / (ms / 1000.0) / 1e12
+        perf["sdpa"].append({"s": s, "ms": ms, "tflops": tflops})
+    return perf
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--quick", action="store_true")
+    parser.add_argument("--no-strict", action="store_true")
+    args = parser.parse_args()
+    torch.manual_seed(0)
+    checks = correctness(args.quick)
+    print("== correctness ==")
+    for c in checks:
+        status = "PASS" if c["pass"] else "FAIL"
+        print(f"{status} {c['name']:36s} max_abs={c['max_abs']:.5g} tol={c['tol']:.5g}")
+    perf = performance(args.quick)
+    print("== gemm ==")
+    for r in perf["gemm"]:
+        print(f"{r['dtype']:9s} n={r['n']:5d}: {r['ms']:9.2f} ms  {r['tflops']:7.2f} TF")
+    print("== linear (N=K=4096) ==")
+    for r in perf["linear"]:
+        print(f"{r['dtype']:9s} m={r['m']:3d}: {r['ms']:8.3f} ms  {r['gbs']:7.1f} GB/s")
+    print("== gemv (N=K=4096) ==")
+    for r in perf["gemv"]:
+        if "error" in r:
+            print(f"{r['dtype']:9s}: FAIL {r['error']}")
+        else:
+            print(f"{r['dtype']:9s}: {r['ms']:8.3f} ms  {r['gbs']:7.1f} GB/s")
+    print("== sdpa math causal ==")
+    for r in perf["sdpa"]:
+        print(f"s={r['s']:5d}: {r['ms']:8.3f} ms  {r['tflops']:7.2f} TF")
+    failed = [c for c in checks if not c["pass"]]
+    report = {"correctness": checks, "performance": perf, "summary": {"passed": len(checks) - len(failed), "failed": len(failed)}}
+    save_report("regression", report)
+    if failed and not args.no_strict:
+        print(f"{len(failed)} correctness checks failed")
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
+
